<script>
  // Category archive. Missing categories are real 404s on cold GETs
  // (middleware existence check); there is no client-side router.
  let slug = $state("");
  let list = $data(() =>
    __rvLoad("category", {
      slug: slug(),
      page: Number(__rvQs().get("page") || 1),
    })
  );
</script>

<head>
  <title>{list().headTitle}</title>
  {@html list().pluginHead ?? ""}
</head>

{@html list().main}
