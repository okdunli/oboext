<script>

  let c = $data(() => __rvLoad("admin.permalinks", {}));
  function v(k, dflt) {
    const x = c()[k];
    return x == null || x === "" ? (dflt == null ? "" : dflt) : x;
  }
  function on(k) {
    return c()[k] ? "1" : "0";
  }
  function copy() {
    return c().s || {};
  }

  function join(base, tail) {
    const b = String(base || "").trim().replace(/^\/+|\/+$/g, "");
    const segs = [b, tail].filter(Boolean).join("/");
    return segs ? "/" + segs : "/";
  }

  const SAMPLE_TOKENS = {
    "{id}": "123",
    "{slug}": "hello-world",
    "{pinyin}": "ni-hao-shi-jie",
    "{initial}": "nhsj",
    "{year}": "2026",
    "{month}": "09",
    "{day}": "18",
  };
  function tokenReplace(s) {
    let out = s;
    for (const k in SAMPLE_TOKENS) out = out.split(k).join(SAMPLE_TOKENS[k]);
    return out;
  }
  function tailSample() {
    const m = c().postMode;
    if (m === "id") return "123";
    if (m === "pinyin") return "ni-hao-shi-jie";
    if (m === "initial") return "nhsj";
    if (m === "custom") {
      const segs = String(c().postPattern || "{slug}")
        .trim()
        .split("/")
        .map((s) => tokenReplace(s))
        .filter(Boolean);
      return segs.join("/") || "hello-world";
    }
    return "hello-world";
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<form data-adm-form="permalinks">
  <div class="adm-toolbar">
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="adm-ic" style="--i:url(/public/icons/link-2.svg);width:20px;height:20px;color:#818cf8;"></span>
      <strong style="font-size:16px">{copy().title}</strong>
    </div>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">{copy().save}</button>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-hd"><strong style="font-size:14px;">{copy().preview}</strong></div>
    <div class="adm-card-bd">
      <div class="adm-form-grid" style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;">
        <div><span class="adm-hint" style="margin:0;">{copy().postsIndex}</span><div>{join(v('postBase', 'blog'))}</div></div>
        <div><span class="adm-hint" style="margin:0;">{copy().postExample}</span><div>{join(v('postBase', 'blog'), tailSample())}</div></div>
        <div><span class="adm-hint" style="margin:0;">{copy().staticPage}</span><div>{join(v('pageBase', 'pages'), 'about')}</div></div>
        <div><span class="adm-hint" style="margin:0;">{copy().category}</span><div>{join(v('categoryBase', 'blog/category'), 'notes')}</div></div>
        <div><span class="adm-hint" style="margin:0;">{copy().tag}</span><div>{join(v('tagBase', 'blog/tag'), 'life')}</div></div>
      </div>
      <p class="adm-hint" style="margin:12px 0 0;">{copy().rootNote}</p>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <div class="adm-field">
        <label>{copy().postForm}</label>
        <select class="adm-select" name="postMode" data-val={v('postMode', 'slug')} style="max-width:320px;">
          <option value="slug">{copy().formSlug}</option>
          <option value="id">{copy().formId}</option>
          <option value="pinyin">{copy().formPinyin}</option>
          <option value="initial">{copy().formInitial}</option>
          <option value="custom">{copy().formCustom}</option>
        </select>
      </div>
      <div class="adm-field" data-show-if="postMode=custom" hidden style="margin-top:12px;">
        <label>{copy().customTokens}</label>
        <input class="adm-input" name="postPattern" value={v('postPattern', '{slug}')} placeholder={"{year}/{month}/{slug}"} spellcheck="false" style="max-width:320px;">
        <p class="adm-hint" style="margin:6px 0 0;">{copy().tokenHint}</p>
      </div>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-hd"><strong style="font-size:14px;">{copy().prefix}</strong></div>
    <div class="adm-card-bd">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>{copy().prefixPosts}</label>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="adm-hint" style="margin:0;">/</span>
            <input class="adm-input" name="postBase" value={v('postBase', 'blog')} placeholder="blog" spellcheck="false">
          </div>
        </div>
        <div class="adm-field">
          <label>{copy().prefixPages}</label>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="adm-hint" style="margin:0;">/</span>
            <input class="adm-input" name="pageBase" value={v('pageBase', 'pages')} placeholder="pages" spellcheck="false">
          </div>
        </div>
        <div class="adm-field">
          <label>{copy().prefixCategories}</label>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="adm-hint" style="margin:0;">/</span>
            <input class="adm-input" name="categoryBase" value={v('categoryBase', 'blog/category')} placeholder="blog/category" spellcheck="false">
          </div>
        </div>
        <div class="adm-field">
          <label>{copy().prefixTags}</label>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="adm-hint" style="margin:0;">/</span>
            <input class="adm-input" name="tagBase" value={v('tagBase', 'blog/tag')} placeholder="blog/tag" spellcheck="false">
          </div>
        </div>
      </div>
      <p class="adm-hint" style="margin:12px 0 0;">{copy().prefixRule}</p>
    </div>
  </div>
</form>
