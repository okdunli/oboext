<script>

  import { makeT } from "@server/i18n";

  export const shell = false;

  let d = $data(() => __rvLoad("notFound", {}));
  function settings() { return d().settings; }
  function recent() { return d().recent || []; }
  function siteTitle() { return d().siteTitle || ""; }
  function skin() { return d().skin || ""; }
  function strings() { return d().strings || {}; }
  // The title lives in <head>, which the compiler renders after the body
  // pass; a signal read there can land on a concurrent render's value (the
  // signal map is process-global). Deriving it from the request context
  // keeps it race-immune, same pattern as the layout's docLocale().
  function nfLocale() {
    if (typeof window !== "undefined") {
      const p = window.location.pathname;
      return p === "/en" || p.indexOf("/en/") === 0 ? "en" : "zh-CN";
    }
    return String(getContext().locale || "zh-CN") === "en" ? "en" : "zh-CN";
  }
  function nfTitle() { return makeT(nfLocale())("notfound.title"); }
  function messageLines() {
    const s = settings();
    if (!s?.message) return [];
    return s.message.split(/\n+/).map((line) => line.trim()).filter(Boolean);
  }
</script>

<head>

  <link rel="stylesheet" href="/public/notfound.css">
  <title>{nfTitle()} - {siteTitle()}</title>
  <meta name="robots" content="noindex, nofollow">
  <meta property="og:site_name" content={siteTitle()}>
</head>

{#if skin()}
{@html skin()}
{/if}
{#if !skin()}
<div class="nf-wrap">
  <div class="nf-box">
    <span class="nf-icon">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M16.24 7.76l-2.12 6.12-6.12 2.12 2.12-6.12z"/>
      </svg>
    </span>

    <h1 class="nf-title">{settings().title}</h1>

    <div class="nf-message">
      {#each messageLines() as line}
      <p>{line}</p>
      {/each}
    </div>

    {#if settings().showSearch}
    <form class="nf-search" action={d().searchAction || "/search"} method="get">
      <input type="search" name="q" placeholder={strings().searchPlaceholder} aria-label={strings().searchLabel}>
      <button type="submit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
        {strings().searchSubmit}
      </button>
    </form>
    {/if}

    <div class="nf-home">
      <a href={d().homeHref || "/"}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        {strings().backHome}
      </a>
    </div>

    {#if recent().length > 0}
    <div class="nf-recent">
      <h2>{strings().recent}</h2>
      <ul>
        {#each recent() as post}
        <li><a href={post.url}>{post.title}</a></li>
        {/each}
      </ul>
    </div>
    {/if}
  </div>
</div>
{/if}
