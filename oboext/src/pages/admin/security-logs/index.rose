<script>

  let d = $data(() => __rvLoad("admin.security-logs", {}));
  function copy() {
    return d().s || {};
  }
  function items() { return d().items || []; }
  function total() { return d().total || 0; }
  function page() { return d().page || 1; }
  function pages() { return d().pages || 1; }
  function curType() { return d().type || ""; }
  function curTypePrefix() { return d().typePrefix || ""; }
  function curAccount() { return d().account || ""; }
  function curIp() { return d().ip || ""; }
  function param(k, v) { return v ? "&" + k + "=" + encodeURIComponent(v) : ""; }
  function anyFilter() { return !!(curType() || curTypePrefix() || curAccount() || curIp()); }
  // One-click triage: the account/ip cells point straight at the indexed arm
  // that filters the same value, so "who else came from this address" is a
  // click instead of a copy-paste into the box.
  function byAccount(v) { return "/admin/security-logs?account=" + encodeURIComponent(v); }
  function byIp(v) { return "/admin/security-logs?ip=" + encodeURIComponent(v); }
  function href(p) {
    return "/admin/security-logs?page=" + p + param("type", curType())
      + param("typePrefix", curTypePrefix())
      + param("account", curAccount()) + param("ip", curIp());
  }
  const EVENT_LABEL = {
    "login.success": copy().loginOk,
    "login.fail": copy().loginFail,
    "login.locked": copy().loginLock,
    "login.challenge": copy().loginChallenge,
    "password.reset.request": copy().resetRequest,
    "password.reset.done": copy().resetDone,
  };
  function eventLabel(t) {
    return EVENT_LABEL[t] || t;
  }
  function eventStyle(t) {
    if (t === "login.success") return "background:rgba(22,163,74,.14);color:#4ade80;";
    if (t === "login.fail") return "background:rgba(220,38,38,.14);color:#f87171;";
    if (t === "login.locked") return "background:rgba(217,119,6,.15);color:#fbbf24;";
    if (t === "login.challenge") return "background:rgba(59,130,246,.14);color:#93c5fd;";
    return "background:rgba(120,120,130,.18);color:#d4d4d8;";
  }
  function fmt(iso) {
    if (!iso) return "—";
    const dt = new Date(iso);
    if (isNaN(dt.getTime())) return "—";
    const pad = (n) => String(n).padStart(2, "0");
    return dt.getFullYear() + "-" + pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) + " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes()) + ":" + pad(dt.getSeconds());
  }
  function detailText(e) {
    const parts = [];
    if (e.detail && typeof e.detail === "object") {
      const stage = e.detail.stage;
      if (stage) parts.push(copy().stage + stage);
    }
    if (e.userAgent) parts.push(e.userAgent);
    return parts.join(" · ");
  }
  function emptyHint() { return items().length ? [] : [1]; }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div style="display:flex;align-items:center;gap:8px;">
    <span class="adm-ic" style="--i:url(/public/icons/scroll-text.svg);width:20px;height:20px;color:#818cf8;"></span>
    <strong style="font-size:16px">{copy().title}</strong>
    <span class="adm-hint" style="margin:0;">{copy().totalLabel} {total()} {copy().countUnit}</span>
  </div>
</div>

<form method="get" class="adm-toolbar" style="gap:8px;">
  <select class="adm-select" name="type" data-val={curType()} style="max-width:220px;">
    <option value="">{copy().filterAll}</option>
    <option value="login.success">{copy().loginOk}</option>
    <option value="login.fail">{copy().loginFail}</option>
    <option value="login.locked">{copy().loginLock}</option>
    <option value="password.reset.request">{copy().resetRequest}</option>
    <option value="password.reset.done">{copy().resetDone}</option>
  </select>
  <select class="adm-select" name="typePrefix" data-val={curTypePrefix()} style="max-width:220px;" aria-label={copy().typePrefix}>
    <option value="">{copy().typePrefix}</option>
    <option value="admin.">{copy().adminPrefix}</option>
  </select>
  <input class="adm-input" name="account" value={curAccount()} maxlength="120"
         placeholder={copy().phAccount} aria-label={copy().accountFilter} style="max-width:220px;">
  <input class="adm-input" name="ip" value={curIp()} maxlength="45"
         placeholder={copy().phIp} aria-label={copy().ipFilter} style="max-width:160px;">
  <button class="adm-btn adm-btn-ghost adm-btn-sm" type="submit">{copy().filter}</button>
  {#if anyFilter()}
  <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/security-logs">{copy().clear}</a>
  {/if}
</form>

<div class="adm-card adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:170px">{copy().colTime}</th>
        <th style="width:130px">{copy().colEvent}</th>
        <th style="width:140px">{copy().colAccount}</th>
        <th style="width:130px">IP</th>
        <th>{copy().colUa}</th>
      </tr>
    </thead>
    <tbody>
      {#each items() as e}
      <tr>
        <td class="adm-hint">{fmt(e.createdAt)}</td>
        <td><span class="adm-tag" style="{eventStyle(e.eventType)}">{eventLabel(e.eventType)}</span></td>
        <td>{#if e.account}<a href={byAccount(e.account)} title={copy().seeThisAccount}>{e.account}</a>{/if}{#if !e.account}{e.userId ? copy().userHash + e.userId : "—"}{/if}</td>
        <td class="adm-hint">{#if e.ip}<a href={byIp(e.ip)} title={copy().seeThisIp}>{e.ip}</a>{/if}{#if !e.ip}—{/if}</td>
        <td class="adm-hint">{detailText(e)}</td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-card-bd adm-empty">{copy().empty}</div>
  {/each}
</div>

{#if pages() > 1}
<div class="adm-toolbar" style="gap:6px;">
  {#if page() > 1}
  <a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(page() - 1)}>{copy().pagerPrev}</a>
  {/if}
  <span class="adm-hint" style="margin:0;">{copy().pagePrefix}{page()} / {pages()}{copy().pageSuffix}</span>
  {#if page() < pages()}
  <a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(page() + 1)}>{copy().pagerNext}</a>
  {/if}
</div>
{/if}
