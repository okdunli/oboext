<script>
  // /api/feed — RSS 2.0 feed (zh alias of the canonical /feed.xml).
  // R144: same validator + 304 contract as the middleware feed branches
  // (xmlResponse) — a reader polling this alias revalidates bodiless too.
  import { documents, xmlResponse } from "@server/loaders";

  export async function GET(request) {
    const origin = new URL(request.url).origin;
    const xml = await documents.feed({ origin });
    return xmlResponse(xml, request, {
      "content-type": "application/rss+xml; charset=utf-8",
      "cache-control": "public, max-age=600",
    });
  }
</script>
