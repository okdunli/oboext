<script>
  // GET /api/newsletter/unsubscribe?token=…
  //
  // One-click unsubscribe: the token that rode the mail IS the credential, so
  // this is a plain link the mail client can follow (List-Unsubscribe shape).
  // 302 to /?unsubscribed=1 on success, /?newsletter_error=1 for an unknown
  // token; returns immediately, no hold, no stream.
  import { unsubscribe } from "@server/newsletter";

  export async function GET(request) {
    const url = new URL(request.url);
    const token = url.searchParams.get("token") ?? "";
    const ok = await unsubscribe(token);
    const to = new URL("/", url.origin);
    to.searchParams.set(ok ? "unsubscribed" : "newsletter_error", "1");
    return new Response(null, { status: 302, headers: { location: to.toString() } });
  }
</script>
