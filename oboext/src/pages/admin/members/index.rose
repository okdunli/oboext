<script>

  let s = $data(() => __rvLoad("admin.members", {}));
  function copy() {
    return (s() && s().s) || {};
  }
  function g(k, dflt) {
    const v = s()[k];
    return v == null || v === "" ? (dflt == null ? "" : dflt) : v;
  }
  function on(k) {
    return s()[k] ? "1" : "0";
  }
  function codesText() {
    return (s().inviteCodes || []).join("\n");
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<form data-adm-form="members">
  <div class="adm-toolbar">
    <strong style="font-size:16px">{copy().title}</strong>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">{copy().save}</button>
  </div>
  <p class="adm-hint" style="margin:0 0 16px;">
    {copy().openHint}
  </p>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{copy().open}</span><span class="d">{copy().offHint}</span></span><input type="checkbox" name="registerEnabled" data-on={on('registerEnabled')} data-bool></label>
      <div class="adm-field" data-show-if="registerEnabled=1" style="margin-top:14px;">
        <label>{copy().path}</label>
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="adm-hint" style="margin:0;">/</span>
          <input class="adm-input" name="registerPath" value={g('registerPath', '/user').replace(/^\//, '')} placeholder="user" spellcheck="false" style="max-width:280px;">
        </div>
        <p class="adm-hint" style="margin:6px 0 0;">
          {copy().pathRule}
        </p>
        <p class="adm-hint" style="margin:6px 0 0;">
          {copy().pathConflict}
        </p>
      </div>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <div class="adm-section-title" style="margin-top:0;">{copy().fields}</div>
      <label class="adm-switch"><span><span class="t">{copy().nameRequired}</span><span class="d">{copy().nameOff}</span></span><input type="checkbox" name="nameRequired" data-on={on('nameRequired')} data-bool></label>
      <label class="adm-switch"><span><span class="t">{copy().passwordRequired}</span><span class="d">{copy().passwordOff}</span></span><input type="checkbox" name="passwordRequired" data-on={on('passwordRequired')} data-bool></label>
      <label class="adm-switch"><span><span class="t">{copy().emailRequired}</span><span class="d">{copy().emailOff}</span></span><input type="checkbox" name="emailRequired" data-on={on('emailRequired')} data-bool></label>
      <label class="adm-switch"><span><span class="t">{copy().phoneRequired}</span><span class="d">{copy().phoneOff}</span></span><input type="checkbox" name="phoneRequired" data-on={on('phoneRequired')} data-bool></label>
      <label class="adm-switch"><span><span class="t">{copy().captcha}</span><span class="d">{copy().captchaHint}</span></span><input type="checkbox" name="captchaEnabled" data-on={on('captchaEnabled')} data-bool></label>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{copy().inviteOn}</span><span class="d">{copy().inviteHint}</span></span><input type="checkbox" name="inviteOnly" data-on={on('inviteOnly')} data-bool></label>
      <div class="adm-field" data-show-if="inviteOnly=1" style="margin-top:14px;">
        <label>{copy().inviteCodes}</label>
        <textarea class="adm-textarea" name="inviteCodes" rows="5" placeholder="WELCOME-2026&#10;VIP-8888">{codesText()}</textarea>
        <p class="adm-hint" style="margin:6px 0 0;">{copy().inviteHint2}</p>
      </div>
      <div class="adm-field" style="margin-top:14px;">
        <label>{copy().defaultRole}</label>
        <select class="adm-select" name="defaultRole" data-val={g('defaultRole', 'subscriber')} style="max-width:280px;">
          <option value="subscriber">{copy().roleSubscriber}</option>
          <option value="author">{copy().roleAuthor}</option>
        </select>
      </div>
    </div>
  </div>

  <p class="adm-hint" style="margin:0;">
    {copy().codeNote}
  </p>
</form>
