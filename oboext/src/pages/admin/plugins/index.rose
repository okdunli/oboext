<script>
  let data = $data(() => __rvLoad("admin.plugins", {}));
  function copy() {
    return data().s || {};
  }
  function list() { return data().plugins || []; }
  function iconUrl(p) {
    var name = (p.manifest && p.manifest.icon) || "plug";
    // Icon files are stored kebab-case (calendar-check.svg), but manifests may spell the name in camelCase/PascalCase ("calendarCheck") or with //.
    var kebab = String(name)
      .replace(/([a-z0-9])([A-Z0-9])/g, "$1-$2")
      .replace(/[_\s]+/g, "-")
      .toLowerCase();
    return "/public/icons/" + kebab + ".svg";
  }
  function statusStyle(p) {
    return p.enabled
      ? "background:rgba(22,163,74,.14);color:#4ade80;"
      : "background:rgba(120,120,130,.18);color:#d4d4d8;";
  }
  function statusText(p) { return p.enabled ? copy().enabled : copy().disabled; }
  function versionBadge(p) { return p.version ? "v" + p.version : "—"; }
  function authorText(p) { return p.author ? p.author : "—"; }
  function toggleIcon(p) {
    return p.enabled ? "/public/icons/circle-x.svg" : "/public/icons/circle-check.svg";
  }
  function toggleText(p) { return p.enabled ? copy().disable : copy().enable; }
  // The toggle button used to be a plain adm-iconbtn, so an enabled plugin's green "已启用" badge sat next to a colourless "禁用" button and the row //.
  function toggleClass(p) { return p.enabled ? "plg-toggle is-on" : "plg-toggle is-off"; }
  function iconBg(p) { return p.enabled ? "rgba(79,70,229,.15)" : "var(--adm-panel-2)"; }
  function iconColor(p) { return p.enabled ? "#22c55e" : "#ef4444"; }
  function emptyHint() { return list().length ? [] : [1]; }

  function hasSettings(p) {
    const sections = (p.manifest && p.manifest.settings) || [];
    for (let i = 0; i < sections.length; i++) {
      const fields = sections[i].fields || [];
      for (let j = 0; j < fields.length; j++) {
        if (fields[j].type !== "hidden" && fields[j].type !== "group") return true;
      }
    }
    return false;
  }
  // Homepage market metadata; only http(s) links become an <a href> (same guard as the themes page).
  function homepageUrl(p) {
    var h = p.manifest && p.manifest.homepage;
    return h && /^https?:\/\//i.test(h) ? h : "";
  }
  function ic(n) {
    return '<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/' + n + '.svg)"></span>';
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div style="display:flex;align-items:center;gap:8px;">
    <span class="adm-ic" style="--i:url(/public/icons/plug.svg);width:20px;height:20px;color:#818cf8;"></span>
    <strong style="font-size:16px">{copy().title}</strong>
    <span class="adm-hint" style="margin:0">{list().length} {copy().installedUnit}</span>
  </div>
  <span style="flex:1"></span>
  <label class="adm-btn adm-btn-ghost adm-btn-sm" style="cursor:pointer">
    <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/upload.svg)"></span>{copy().upload}
    <input type="file" accept=".zip" class="adm-hidden-file" data-adm-act="plugin-upload">
  </label>
</div>

{#each list() as p}
<div class="adm-card" style="margin-bottom:12px;padding:16px 18px;">
  <div style="display:flex;align-items:flex-start;gap:14px;">
    <div style="width:40px;height:40px;flex-shrink:0;border-radius:10px;display:flex;align-items:center;justify-content:center;background:{iconBg(p)};">
      <span class="adm-ic" style="--i:url({iconUrl(p)});width:20px;height:20px;color:{iconColor(p)};"></span>
    </div>
    <div style="flex:1;min-width:0;">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <strong style="font-size:14px;">{p.name}</strong>
        <span style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:10px;color:var(--adm-faint);background:var(--adm-hover);border-radius:4px;padding:2px 6px;">{versionBadge(p)}</span>
        <span class="adm-tag" style="{statusStyle(p)}">{statusText(p)}</span>
        {#if !p.installed}
          <span class="adm-tag" style="background:rgba(217,119,6,.15);color:#fbbf24;">{copy().fileMissing}</span>
        {/if}
      </div>
      {#if p.description}<p style="margin:4px 0 0;font-size:13px;color:var(--adm-muted);line-height:1.5;">{p.description}</p>{/if}
      <div style="margin-top:6px;display:flex;align-items:center;gap:12px;font-size:11px;color:var(--adm-faint);flex-wrap:wrap;">
        <span>{copy().authorLabel}{authorText(p)}</span>
        {#if homepageUrl(p) !== ""}
        <a href={homepageUrl(p)} target="_blank" rel="noreferrer noopener" style="color:inherit;display:inline-flex;align-items:center;gap:4px;">{copy().home}<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span></a>
        {/if}
        <span>slug: <code style="font-family:ui-monospace,Menlo,Consolas,monospace;">{p.slug}</code></span>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
      {#if hasSettings(p)}
      <button class="adm-iconbtn" data-plg-settings data-slug={p.slug} title="{copy().pluginWord}{copy().settings}">
        <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/settings-2.svg)"></span>
        {copy().settings}
      </button>
      {/if}
      {#if p.hasAdmin && p.enabled}
      <a class="adm-iconbtn" href={"/admin/plugins/" + p.slug} title="{copy().manage}{copy().panel}">
        <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span>
        {copy().panel}
      </a>
      {/if}
      <button class={"adm-iconbtn " + toggleClass(p)} data-adm-act="plugin-toggle" data-slug={p.slug} data-enabled={p.enabled ? "1" : "0"}>
        <span class="adm-ic adm-ic-sm" style="--i:url({toggleIcon(p)})"></span>
        {toggleText(p)}
      </button>
    </div>
  </div>
</div>
{/each}

{#each emptyHint() as _}
<div class="adm-empty" style="border:1px dashed var(--adm-border);border-radius:var(--adm-radius);">
  {copy().empty}<br>
  <span class="adm-hint">{copy().uploadHint}</span>
</div>
{/each}

<div class="adm-modal" data-plg-modal hidden>
  <div class="adm-modal-box" style="max-width:min(94vw,920px);">
    <div class="adm-modal-hd">
      <div>
        <h2 style="margin:0;font-size:15px;" data-plg-title>{copy().pluginWord}{copy().settings}</h2>
        <p class="adm-hint" style="margin:3px 0 0;" data-plg-sub></p>
      </div>
      <button type="button" class="adm-modal-x" data-plg-close aria-label="{copy().close}">{@html ic("x")}</button>
    </div>
    <div class="adm-modal-bd">
      <div class="adm-thp-grid">
        <nav class="adm-thp-nav">
          <div class="adm-thp-navgroup" data-plg-navgroup>
            <div class="adm-thp-navlist" data-plg-nav></div>
          </div>
        </nav>
        <div class="adm-thp-body" data-plg-body></div>
      </div>
    </div>
    <div class="adm-modal-ft">
      <span class="adm-thp-msg" data-plg-msg style="margin-right:auto;"></span>
      <button type="button" class="adm-btn adm-btn-ghost" data-plg-close>{copy().cancel}</button>
      <button type="button" class="adm-btn" data-plg-save>{copy().saveVerb}{copy().settings}</button>
    </div>
  </div>
</div>
