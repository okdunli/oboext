<script>

  //   POST { action: "status" | "delete", ids: number[], status?: published|pending|spam }
  import { apiGate, readBody, setCommentsStatus, deleteComments, jsonFail } from "@server/admin";

  export async function POST(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const ids = Array.isArray(body.ids)
        ? body.ids.map(Number).filter((n) => Number.isInteger(n) && n > 0)
        : [];
      if (ids.length > 500) return jsonFail("批量操作一次最多 500 项", 422);
      if (body.action === "delete") {
        return { ids: await deleteComments(getContext().user, ids) };
      }
      if (body.action === "status") {
        const status = String(body.status || "");
        if (status !== "published" && status !== "pending" && status !== "spam") {
          return jsonFail("非法的评论状态", 422);
        }
        return { ids: await setCommentsStatus(getContext().user, ids, status) };
      }
      return jsonFail("未知的批量操作", 422);
    });
  }
</script>
