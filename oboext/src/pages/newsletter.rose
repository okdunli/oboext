<script>
  // Public newsletter subscribe page (/newsletter) — double-opt-in step 1.
  //
  // R345: the page is now a NATIVE form + server action. The endpoint's
  // answer is DELIBERATELY uniform (`{ ok: true }` whether the address is
  // brand new, already confirmed, or a re-request), so the outcome message
  // can never probe the list; the action maps the endpoint's three outcomes
  // (ok / 422 invalid / anything else failed) onto the same three states the
  // old client bundle used. Without JavaScript the browser performs the
  // native POST and the server re-renders the page with the message; with
  // JavaScript the framework adopts the submit in place. The form posts to
  // /newsletter from BOTH twins — the /en catch-all carries no action, so a
  // single action export can not live there without turning every unmatched
  // path's POST into a subscribe (rejected). The subscriber's locale rides
  // the hidden `l` field the loader stamps, so the confirmation mail stays
  // in the language of the page the visitor read.
  //
  // Exactly one bare script block (R246 / handbook AV: the compiler's
  // COMPONENT_RE is not global, so a second block is eaten at build time with
  // no warning).
  import { subscribe } from "@server/newsletter";

  let d = $data(() => __rvLoad("newsletter", {}));
  let status = $state("");

  function s() {
    return d().s || {};
  }
  function formHtml() {
    return d().form || "";
  }
  function msgText() {
    const k = status();
    if (k === "ok") return s().confirm_pending;
    if (k === "invalid") return s().email_invalid;
    if (k === "failed") return s().failed;
    return "";
  }
  function msgStyle() {
    return status() === "ok" ? "color:#4ade80" : "color:#f87171";
  }

  export async function action(form: FormData) {
    const locale = String(form.get("l") || getContext().locale || "zh-CN");
    try {
      const r = await subscribe(form.get("email"), locale);
      return { status: r.ok ? "ok" : "failed" };
    } catch (e) {
      const code = e instanceof Error && "status" in e ? (e as { status?: number }).status : 0;
      return { status: code === 422 ? "invalid" : "failed" };
    }
  }
</script>

{#if d().head}
<head>
  {@html d().head}
</head>
{/if}

<section class="df-card">
  {@html d().main}
  {@html formHtml()}
  {#if status()}
  <p class="df-suggest-status mt-2" style={msgStyle()} role="status">{msgText()}</p>
  {/if}
</section>
