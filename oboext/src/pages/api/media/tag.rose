<script>
  // /api/media/tag — POST {ids:[...], tags:"a,b", mode:"add"|"replace"}
  // batch tagging: add merges into each item's tags, replace overwrites.
  // A literal route, so it wins over [id].rose.
  import { apiGate, readBody, jsonFail } from "@server/admin";
  import { tagMediaMany } from "@server/media";

  export async function POST(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const ids = Array.isArray(body.ids)
        ? body.ids.map((n) => Number(n)).filter((n) => Number.isInteger(n) && n > 0)
        : [];
      if (!ids.length) return jsonFail("缺少 ids", 400);
      if (typeof body.tags !== "string") return jsonFail("缺少 tags", 400);
      const mode = body.mode === "replace" ? "replace" : "add";
      return tagMediaMany(getContext().user, ids, body.tags, mode);
    });
  }
</script>
