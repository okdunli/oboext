<script>
  // Comment moderation — reads the live DB per request. Actions go through
  // /api/comments/:id (PATCH status | DELETE) via admin.js delegation.
  let d = $data(() =>
    __rvLoad("admin.comments", {
      status: __rvQs().get("status") || "",
      page: __rvQs().get("page"),
      after: __rvQs().get("after") || "",
    }),
  );
  // NB: {#each} compiles its expression as a zero-arg call, so iteration
  // targets must be function accessors, never bare arrays.
  function rows() {
    return d().items;
  }
  // The loader hands down every visible string in the request's language
  // (R488, same contract as the dashboard and the post list).
  function copy() {
    return d().s || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function totalHint() {
    return hint("total", { n: d().total });
  }
  function pageHint() {
    return hint("pagerPage", { page: d().page });
  }
  function fmt(iso) {
    if (!iso) return "—";
    const dt = new Date(iso);
    const pad = (n) => String(n).padStart(2, "0");
    return dt.getFullYear() + "-" + pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) +
      " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes());
  }
  function label(v) {
    const c = copy();
    return v === "published" ? c.published : v === "pending" ? c.pending : c.spam;
  }
  function tabClass(s) {
    return (__rvQs().get("status") || "") === s ? "is-active" : "";
  }
  function hasPrev() {
    return d().page > 1;
  }
  function hasNext() {
    return d().page * d().limit < d().total;
  }
  function hasPager() {
    return d().total > d().limit || d().page > 1;
  }
  function emptyHint() {
    return rows().length ? [] : [1];
  }
  // each-predicate wrapper: same-kind blocks can't nest in .rose templates
  function pager() {
    return hasPager() ? [1] : [];
  }
  function statusQ() {
    return __rvQs().get("status") || "";
  }
  function href(p) {
    return "/admin/comments?page=" + p + (statusQ() ? "&status=" + statusQ() : "");
  }
  // 实时刷新：轮询循环与 5s 节流在 /public/admin-live.js（admin 页共享，
  // 三份内联副本曾各自漂移）；refresh() 是框架 runtime 的 SWR 重取 hook。
  onMount(function () {
    window.startAdminLive(function () { refresh(); });
  });
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div class="adm-tabs">
    <a class={tabClass("")} href="/admin/comments">{copy().filterAll}</a>
    <a class={tabClass("pending")} href="/admin/comments?status=pending">{copy().pending}</a>
    <a class={tabClass("published")} href="/admin/comments?status=published">{copy().published}</a>
    <a class={tabClass("spam")} href="/admin/comments?status=spam">{copy().spam}</a>
  </div>
  <span style="flex:1"></span>
  <span class="adm-hint">{totalHint()}</span>
</div>

<div class="adm-toolbar" style="gap:8px;">
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/comments/bulk" data-op="published">{copy().bulkApprove}</button>
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/comments/bulk" data-op="spam">{copy().bulkSpam}</button>
  <button class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-url="/api/comments/bulk" data-op="delete">{copy().bulkDelete}</button>
</div>

<div class="adm-card adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all"></th>
        <th style="width:150px">{copy().colAuthor}</th>
        <th>{copy().colComment}</th>
        <th style="width:170px">{copy().colPost}</th>
        <th style="width:80px">{copy().colStatus}</th>
        <th style="width:130px">{copy().colDate}</th>
        <th style="width:210px"></th>
      </tr>
    </thead>
    <tbody>
      {#each rows() as c}
      <tr>
        <td><input type="checkbox" class="adm-check" value={c.id}></td>
        <td>
          <div class="title">{c.authorName || copy().anonymous}</div>
          <div class="sub">{c.authorEmail || ""}</div>
        </td>
        <td style="max-width:380px">
          <div style="white-space:pre-wrap;line-height:1.6">{esc(c.content)}</div>
        </td>
        <td class="adm-hint">{c.postTitle}</td>
        <td><span class={"adm-tag " + c.status}>{label(c.status)}</span></td>
        <td class="adm-hint">{fmt(c.createdAt)}</td>
        <td>
          <div class="row-actions" style="flex-wrap:wrap;gap:4px">
            <button class="adm-iconbtn" data-adm-act="comment" data-id={c.id} data-what="published">{copy().actApprove}</button>
            <button class="adm-iconbtn" data-adm-act="comment" data-id={c.id} data-what="pending">{copy().actPending}</button>
            <button class="adm-iconbtn" data-adm-act="comment" data-id={c.id} data-what="spam">{copy().actSpam}</button>
            <button class="adm-iconbtn danger" data-adm-act="comment" data-id={c.id} data-what="delete">{copy().actDelete}</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">{copy().empty}</div>
  {/each}
</div>

{#each pager() as _}
<div class="adm-pager">
  {pageHint()}
  <span style="flex:1"></span>
  {#if hasPrev()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(d().page - 1)}>{copy().pagerPrev}</a>{/if}
  {#if hasNext()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(d().page + 1)}>{copy().pagerNext}</a>{/if}
</div>
{/each}
