<script>
  // /api/tags/:id — GET one (public, mirrors the original), PUT update,
  // DELETE remove.
  import { apiGate, readBody, jsonFail, updateTag, deleteTag } from "@server/admin";
  import { getTag } from "@server/queries";

  function pathId(request) {
    const n = Number(new URL(request.url).pathname.split("/").filter(Boolean)[2]);
    return Number.isInteger(n) && n > 0 ? n : 0;
  }

  export async function GET(request) {
    return apiGate(async () => {
      const id = pathId(request);
      if (!id) return jsonFail("标签不存在", 404);
      return getTag(id);
    });
  }

  export async function PUT(request) {
    return apiGate(async () =>
      updateTag(getContext().user, pathId(request), await readBody(request)),
    );
  }

  export async function DELETE(request) {
    return apiGate(async () => deleteTag(getContext().user, pathId(request)));
  }
</script>
