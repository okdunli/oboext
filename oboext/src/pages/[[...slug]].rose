<script>
  export const bundle = 'split';
  // TTFB: the whole public content surface (home + posts + pages) memoizes
  // for 1s per cookie principal. Server actions (comment/member/admin
  // POSTs) invalidate the memo on write, so edits surface immediately.
  // 1s (not 0) keeps a tiny burst cache for TTFB while letting the read
  // counter increment on (almost) every distinct visitor — cache=15 was
  // under-counting everyone who arrived inside the same 15s window.
  export const cache = 1;
  // The single public content entry point (original parity:
  // app/(site)/[[...slug]]/page.tsx). `slug` arrives as the segment ARRAY;
  // the "resolve" loader maps it through the permalink gateway to the
  // entity's canonical view model, so renaming or deleting a prefix in

  //
  // An unresolvable path throws notFound(): the framework answers with the
  // app's own 404 route and a real 404 status (the nearest segment's
  // _notfound.rose, or the root 404.rose). Fixed routes (/search, /archives)
  // outrank this catch-all through the router's specificity order.
  let slug = $state([]);
  let view = $data(async () => {
    const v = await __rvLoad("resolve", {
      segments: slug(),
      page: Number(__rvQs().get("page") || 1),
    });
    if (!v) notFound();
    return v;
  });
</script>

{#if view().head || view().headTitle}
<head>
  {#if view().head}{@html view().head}{/if}
  {#if view().headTitle}
  <title>{view().headTitle}</title>
  {@html view().pluginHead ?? ""}
  {/if}
</head>
{/if}

{@html view().main}
