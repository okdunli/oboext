<script>
  // 404 page settings admin — port of Oboext app/admin/notfound/page.tsx.
  // Uses data-adm-form="notfound" for admin.js to handle submission.
  let cfg = $data(() => __rvLoad("notFoundConfig", {}));

  function v(k, dflt) {
    const x = cfg()[k];
    return x == null || x === "" ? (dflt == null ? "" : dflt) : x;
  }
  function on(k) {
    return cfg()[k] ? "1" : "0";
  }
  function copy() {
    return cfg().s || {};
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<form data-adm-form="notfound">
  <div class="adm-toolbar">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span class="adm-ic" style="--i: url(/public/icons/file-question.svg); width: 22px; height: 22px; color: #818cf8;"></span>
      <strong style="font-size:16px">{copy().title}</strong>
    </div>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">{copy().save}</button>
  </div>

  <div data-adm-msg></div>

  <div class="adm-section-title">{copy().copyLabel}</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-field">
        <label>{copy().colTitle}</label>
        <input class="adm-input" name="title" value={v('title', copy().defaultTitle)} maxlength="120">
      </div>
      <div class="adm-field" style="margin-top: 1rem;">
        <label>{copy().colBody}</label>
        <textarea class="adm-textarea" name="message" rows="4" maxlength="500" data-dv={v('message', copy().defaultMessage)} style="min-height: 6rem; resize: vertical;"></textarea>
        <div class="adm-hint">{copy().bodyHint}</div>
      </div>
    </div>
  </div>

  <div class="adm-section-title" style="margin-top: 1.5rem;">{copy().modules}</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-field">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <label style="margin-bottom: 0.25rem;">{copy().showSearch}</label>
            <div class="adm-hint">{copy().showSearchHint}</div>
          </div>
          <label class="adm-switch">
            <input type="checkbox" name="showSearch" value="1" data-on={on('showSearch')}>
          </label>
        </div>
      </div>
      <div class="adm-field" style="margin-top: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <label style="margin-bottom: 0.25rem;">{copy().showRecent}</label>
            <div class="adm-hint">{copy().showRecentHint}</div>
          </div>
          <label class="adm-switch">
            <input type="checkbox" name="showRecent" value="1" data-on={on('showRecent')}>
          </label>
        </div>
      </div>
    </div>
  </div>
</form>

