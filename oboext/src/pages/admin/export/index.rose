<script>

  let s = $data(() => __rvLoad("admin.session", {}));
  function copy() {
    return (s() && s().export) || {};
  }

  // {copy().import}面板的浏览器端绑定。
  //
  // 为什么必须待在这唯一一个 script 块里：编译器的 COMPONENT_RE
  // （the framework compiler's COMPONENT_RE）不带 g，只匹配第一个 script 块，后面的块既
  // 不进 script 也不留在模板里，构建成功且零警告地被丢掉
  // （_FRAMEWORK_GOTCHAS.md §2.1）。
  //
  // 为什么用 onMount 而不是裸 IIFE：编译器的裸 IIFE 既不触发 needsClient，
  // 本页就会落进 noJsRoutes，连这一块脚本都不发给浏览器（构建期 :6214 的
  // zero-JS 文档直接收尾），按钮依旧是死的。onMount 是框架的挂载钩子，
  // 在 document 缺失时直接返回（rosezm/runtime 的 index），因此服务端渲染
  // 不会抛；它同时是「本页需要客户端包」的判定依据。
  onMount(function () {
    var box = document.querySelector("[data-adm-import]");
    if (!box || box.__impBound) return;
    box.__impBound = true;
    var out = box.querySelector("#imp-out");
    var fileInput = box.querySelector("#imp-file");
    function policy() {
      var r = box.querySelector('input[name="imp-policy"]:checked');
      return r ? r.value : "skip";
    }
    function say(text) {
      out.textContent = text;
    }
    // Catalog sentences carry {name} slots; the numbers are only known here.
    function fill(tpl, vars) {
      return String(tpl || "").replace(/{([a-z0-9_]+)}/g, function (m, k) {
        return vars[k] === undefined ? m : String(vars[k]);
      });
    }
    function describe(data) {
      var lines = [];
      var p = data.posts || {}, g = data.pages || {};
      var label = data.format === "markdown" ? "Markdown" : data.format === "wxr" ? "WordPress (WXR)" : data.format === "zip" ? copy().fmtZip : "JSON";
      lines.push(copy().fmtLabel + label);
      if (data.bundle) {
        var skipped = data.bundle.skipped || [];
        lines.push(fill(copy().zipParsed, { parsed: data.bundle.files }) + (skipped.length ? fill(copy().zipSkipped, { skipped: skipped.length }) : ""));
        if (skipped.length) lines.push(copy().skippedLabel + skipped.slice(0, 5).map(function (s) {
          return s.name + " (" + s.reason + ")";
        }).join(copy().listSep) + (skipped.length > 5 ? copy().andMore : ""));
      }
      lines.push(fill(copy().postsSummary, { total: p.total, creatable: p.creates, conflicts: p.conflicts, invalid: p.issues }));
      if (g.total) lines.push(fill(copy().pagesSummary, { total: g.total, creatable: g.creates, conflicts: g.conflicts, invalid: g.issues }));
      if (data.comments) lines.push(fill(copy().commentsSummary, { n: data.comments }));
      if (data.applied) {
        var a = data.applied;
        lines.push(copy().executed + copy().postsCreated + a.posts.created + copy().postsOverwritten + a.posts.updated + copy().postsSkipped + a.posts.skipped +
          (g.total ? copy().pagesCreated + a.pages.created + copy().postsOverwritten + a.pages.updated + copy().postsSkipped + a.pages.skipped : ""));
        if (a.comments) lines.push(fill(copy().commentsImported, { n: a.comments }));
        if (a.terms && (a.terms.categories || a.terms.tags)) {
          lines.push(fill(copy().catsCreated, { n: a.terms.categories, m: a.terms.tags }));
        }
        if (a.authors && (a.authors.matched || a.authors.created || a.authors.capped)) {
          var au = a.authors;
          lines.push(fill(copy().authorsAttributed, { n: au.matched, m: au.created }) +
            (au.capped ? fill(copy().authorsExceeded, { n: au.capped }) : ""));
        }
        if (a.errors && a.errors.length) lines.push(fill(copy().failedN, { n: a.errors.length }) + a.errors.slice(0, 5).join(copy().listSep));
      }
      if (data.issues && data.issues.length) {
        lines.push(copy().invalidItems + data.issues.slice(0, 5).map(function (i) {
          return (i.title || "#" + i.index) + " (" + i.reason + ")";
        }).join(copy().listSep));
      }
      return lines.join("\n");
    }
    async function run(dry) {
      var f = fileInput.files && fileInput.files[0];
      if (!f) { say(copy().selectFile); return; }
      if (!dry && !confirm(copy().confirmRun.split("{action}")[0] + copy().runImport + copy().confirmRun.split("{action}")[1])) return;
      var fd = new FormData();
      fd.append("file", f);
      fd.append("policy", policy());
      if (dry) fd.append("dryRun", "1");
      say(copy().processing);
      try {
        var r = await fetch("/api/admin/import", { method: "POST", credentials: "same-origin", body: fd });
        var data = null;
        try { data = await r.json(); } catch (e) {}
        if (!r.ok) {
          say(copy().importFailed + r.status + "）：" + ((data && data.error) || copy().unknownError));
          return;
        }
        say(describe(data));
      } catch (e) {
        say(copy().importRequestFailed + String(e));
      }
    }
    box.querySelector("#imp-dry").addEventListener("click", function () { run(true); });
    box.querySelector("#imp-run").addEventListener("click", function () { run(false); });
  });
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div style="display:flex;align-items:center;gap:8px;">
    <span class="adm-ic" style="--i:url(/public/icons/file-text.svg);width:20px;height:20px;color:#818cf8;"></span>
    <strong style="font-size:16px">{copy().title}</strong>
  </div>
</div>

{#if (function(){ try { return ($query().get("err") || "") === "noscope"; } catch { return false; } })()}
          <div class="adm-hint" style="margin-bottom:10px;color:#f87171">{copy().noscope}</div>
          {/if}
<form method="get" action="/api/admin/export">
  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-hd"><strong style="font-size:14px;">{copy().scope}</strong></div>
    <div class="adm-card-bd" style="display:grid;gap:10px;">
      <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().posts}</span><span class="d">{copy().postsDesc}</span></span><input type="checkbox" name="scope" value="posts" checked></label>
      <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().pages}</span><span class="d">{copy().pagesDesc}</span></span><input type="checkbox" name="scope" value="pages" checked></label>
      <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().comments}</span><span class="d">{copy().commentsDesc}</span></span><input type="checkbox" name="scope" value="comments" checked></label>
      <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().taxonomies}</span><span class="d">{copy().taxonomiesDesc}</span></span><input type="checkbox" name="scope" value="taxonomies" checked></label>
      <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().siteSettings}</span><span class="d">{copy().settingsDesc}</span></span><input type="checkbox" name="scope" value="settings" checked></label>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-hd"><strong style="font-size:14px;">{copy().format}</strong></div>
    <div class="adm-card-bd" style="display:grid;gap:10px;">
      <label class="adm-switch" style="margin:0;"><span><span class="t">JSON</span><span class="d">{copy().jsonDesc}</span></span><input type="radio" name="format" value="json" checked></label>
      <label class="adm-switch" style="margin:0;"><span><span class="t">Markdown</span><span class="d">{copy().markdownDesc}</span></span><input type="radio" name="format" value="markdown"></label>
      <label class="adm-switch" style="margin:0;"><span><span class="t">WordPress (WXR)</span><span class="d">{copy().wxrDesc}</span></span><input type="radio" name="format" value="wxr"></label>
      <p class="adm-hint" style="margin:4px 0 0;">{copy().complement}</p>
    </div>
  </div>

  <div class="adm-toolbar">
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/download.svg)"></span>{copy().start}</button>
  </div>
</form>

<div class="adm-card" style="margin-top:16px;" data-adm-import>
  <div class="adm-card-hd"><strong style="font-size:14px;">{copy().import}</strong><span class="adm-hint" style="margin-left:auto">{copy().importNote}</span></div>
  <div class="adm-card-bd" style="display:grid;gap:10px;">
    <input type="file" id="imp-file" accept=".json,.md,.markdown,.txt,.xml,.zip">
    <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().skipExisting}</span><span class="d">{copy().skipHint}</span></span><input type="radio" name="imp-policy" value="skip" checked></label>
    <label class="adm-switch" style="margin:0;"><span><span class="t">{copy().overwrite}</span><span class="d">{copy().overwriteHint}</span></span><input type="radio" name="imp-policy" value="overwrite"></label>
    <p class="adm-hint" style="margin:0;">{copy().importDetail}</p>
    <div class="adm-toolbar">
      <span style="flex:1"></span>
      <button class="adm-btn adm-btn-ghost" type="button" id="imp-dry">{copy().dryRun}</button>
      <button class="adm-btn" type="button" id="imp-run">{copy().runImport}</button>
    </div>
    <div class="adm-hint" id="imp-out" style="margin:0;white-space:pre-wrap;"></div>
  </div>
</div>
