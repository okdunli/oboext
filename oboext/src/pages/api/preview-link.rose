<script>
  // /api/preview-link — mint a shareable URL that shows an unpublished post or
  // page to anyone who has the link (no account needed, 7 days).
  // Posts: adminGetPost enforces content:read plus the author/manager rule.
  // Pages: pages are manager-only content, so the capability is required here.
  import { apiGate, adminGetPost, requireCap } from "@server/admin";
  import { adminGetPage } from "@server/pages";
  import { previewTokenFor, previewTtlMs } from "@server/preview-link";
  import { resolveOrigin } from "@server/site-origin";

  export async function GET(request) {
    return apiGate(async () => {
      const url = new URL(request.url);
      const id = Number(url.searchParams.get("id"));
      const kind = url.searchParams.get("kind") === "page" ? "page" : "post";
      if (!Number.isInteger(id) || id <= 0) {
        return new Response(JSON.stringify({ error: "id 无效" }), {
          status: 422,
          headers: { "content-type": "application/json; charset=utf-8" },
        });
      }
      const user = getContext().user;
      let target;
      if (kind === "page") {
        requireCap(user, "content:update:any");
        target = await adminGetPage(user, id);
      } else {
        target = await adminGetPost(user, id);
      }
      // Absolute, from the site origin (SITE_ORIGIN when configured, else the
      // request host): an admin who opened the panel on an IP or a preview
      // domain must still copy a link that works for the public site.
      const origin = resolveOrigin(request.headers);
      return {
        url: `${origin}${target.url}?preview=${previewTokenFor(kind, target.id)}`,
        expiresAt: new Date(Math.ceil((Date.now() + previewTtlMs()) / 1000) * 1000).toISOString(),
        kind,
      };
    });
  }
</script>
