<script>
  // Menu manager (port of components/MenuManager.tsx).
  let d = $data(() => __rvLoad("admin.menus", {}));
  function menus() {
    return d().menus || [];
  }
  function activeMenu() {
    var ms = menus();
    return ms.length ? ms[0] : null;
  }
  // tree -> flat rows with depth + parentId, in display order
  function flatten(nodes, depth, parentId, out) {
    (nodes || []).forEach(function (n, i) {
      out.push({
        id: n.id,
        parentId: parentId,
        order: i,
        type: n.type || "custom",
        label: n.label || "",
        url: n.url || "",
        referenceSlug: n.referenceSlug || "",
        target: n.target || "_self",
        icon: n.icon || "",
        depth: depth,
      });
      if (n.children && n.children.length) flatten(n.children, depth + 1, n.id, out);
    });
    return out;
  }
  function rows() {
    var m = activeMenu();
    return m ? flatten(m.items, 0, null, []) : [];
  }
  function payload() {
    return JSON.stringify(d());
  }
  function refLabel(r) {
    return r.label || r.referenceSlug;
  }
  // {#if} predicates must be zero-arg function calls; keep all inline
  // comparisons behind named helpers.
  function menuIsRef(r) {
    return r.type !== "custom";
  }
  function menuIsCustom(r) {
    return r.type === "custom";
  }
  function menuIsIndented(r) {
    return r.depth > 0;
  }
  function refState(r) {
    return r.referenceSlug ? (r.url || "已选择") : "未选择";
  }
  function indentStyle(r) {
    return "margin-left:" + r.depth * 20 + "px";
  }
  function depthLabel(r) {
    return "L" + (r.depth + 1);
  }
  function emptyClass() {
    // Hidden unconditionally on the server.
    return "adm-empty adm-menu-empty is-hidden";
  }
</script>

<head>
  <title>菜单 - 管理后台</title>
</head>

<div class="adm-menu" data-menu-manager data-menus={payload()}>
  <div class="adm-menu-head">
    <div class="adm-menu-tabs" data-menu-tabs>
      {#each menus() as m}
      <button type="button" class="adm-menu-tab" data-menu-tab data-id={m.id}>{m.name} <span class="adm-menu-loc">({m.location})</span></button>
      {/each}
    </div>
    <span class="adm-menu-auto">改动自动保存</span>
  </div>

  <p class="adm-menu-msg" data-menu-msg></p>

  <div class="adm-menu-rows" data-menu-rows>
    {#each rows() as r}
    <div class="adm-menu-row" data-menu-row style={indentStyle(r)}>
      <span class="adm-menu-depth">{depthLabel(r)}</span>
      <select class="adm-select adm-menu-type" data-f="type">
        <option value="custom">自定义链接</option>
        <option value="post">文章</option>
        <option value="page">页面</option>
        <option value="category">分类</option>
        <option value="tag">标签</option>
      </select>
      {#if (() => menuIsRef(r))()}
      <select class="adm-select adm-menu-ref" data-f="ref">
        <option value={r.referenceSlug}>{refLabel(r)}</option>
      </select>
      {/if}
      <input class="adm-input adm-menu-label" data-f="label" value={r.label} placeholder="显示文字">
      {#if (() => menuIsCustom(r))()}
      <input class="adm-input adm-menu-url" data-f="url" value={r.url} placeholder="链接 /">
      {/if}
      {#if (() => menuIsRef(r))()}
      <span class="adm-menu-mono" title={r.url}>{refState(r)}</span>
      {/if}
      <input class="adm-input adm-menu-icon" data-f="icon" data-icon-picker="compact" value={r.icon} placeholder="图标标识" title="设置图标">
      <div class="adm-menu-tools">
        <button type="button" class="adm-iconbtn" data-menu-act="up" title="上移" aria-label="上移"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/chevron-up.svg)"></span></button>
        <button type="button" class="adm-iconbtn" data-menu-act="down" title="下移" aria-label="下移"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/chevron-down.svg)"></span></button>
        <button type="button" class="adm-iconbtn" data-menu-act="indent" title="作为上一项的子项" aria-label="缩进"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/corner-down-right.svg)"></span></button>
        {#if (() => menuIsIndented(r))()}
        <button type="button" class="adm-iconbtn" data-menu-act="outdent" title="升回顶级" aria-label="升回顶级"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/corner-up-left.svg)"></span></button>
        {/if}
        <button type="button" class="adm-iconbtn danger" data-menu-act="del" title="删除" aria-label="删除"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span></button>
      </div>
    </div>
    {/each}
  </div>

  <div class={emptyClass()} data-menu-empty>
    <div style="margin-bottom:8px;display:flex;justify-content:center"><span class="adm-ic" style="width:32px;height:32px;--i:url(/public/icons/compass.svg)"></span></div>
    <p>这个菜单还没有项目。</p>
  </div>

  <button type="button" class="adm-btn adm-btn-ghost adm-menu-add" data-menu-add><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/plus.svg)"></span>添加菜单项</button>
</div>
