<script>
  // Theme-aware chrome shell. The active theme's nav/body/aside/footer HTML
  // comes from the "chrome" loader (per request, live DB). Skyscraper's
  // drawer/dark-mode/scroll-reveal interactions live in /public/theme.js;
  // other themes ship zero framework JS on purpose (csr=false).
  // Key the chrome loader by admin/public so the startup warm-up of /admin/*
  // routes (which returns the minimal admin stub, deliberately without cssHref)
  // cannot poison the cached public chrome and strip the stylesheet link from
  // every front-end page. rosefd memoizes $data by loader key + payload, so a
  // path-distinct payload keeps the two results in separate cache slots.
  let chrome = $data(() => __rvLoad("chrome", { admin: adminPath() }));

  function adminPath() {
    const p =
      typeof window !== "undefined"
        ? window.location.pathname
        : String(getContext().pathname || "");
    return p.indexOf("/admin") === 0;
  }
  function publicPath() {
    return !adminPath();
  }
  function isSkyscraper() {
    return chrome().themeSlug === "skyscraper";
  }
  function isBluemix() {
    return chrome().themeSlug === "bluemix";
  }
  function isNotSkyscraper() {
    return chrome().themeSlug !== "skyscraper";
  }
  // Safety net: guarantees links never render as default-underlined even if a
  // theme's own stylesheet fails to load or a class mismatch leaves an <a>
  // unstyled. Themes still set their own link colour via their stylesheet.
  // Injected as raw HTML (not a template literal) because the CSS braces would
  // otherwise be parsed as a template expression.
  function linkResetHtml() {
    return isNotSkyscraper()
      ? '<style id="rv-link-reset">a{text-decoration:none}</style>'
      : '';
  }
  // The theme stylesheet, inlined to keep it off the critical path. Same
  // pattern as linkResetHtml above, and for the same reason: a literal
  // <style> element in a .rose source is the component's scoped stylesheet and
  // is removed from the template by the compiler. Empty string when the theme
  // does not inline, and the caller falls back to the <link>.
  function cssInlineHtml() {
    var css = chrome().cssInline;
    if (!css) return "";
    return '<style id="rv-theme-css">' + css + "</style>";
  }
</script>

<head>
  <title>{chrome().siteTitle}</title>
  <meta name="description" content={chrome().siteDescription}>
  <link rel="alternate" type="application/rss+xml" title="RSS" href="/api/feed">

  <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={chrome().siteTitle}>
  <meta property="og:description" content={chrome().siteDescription}>
  <meta property="og:type" content="website">

  <meta property="og:url" content={chrome().siteUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={chrome().siteTitle}>
  <meta name="twitter:description" content={chrome().siteDescription}>
  <!-- The theme's stylesheet, inlined. A <link rel=stylesheet> is
       render-blocking: the parser halts at it, so on a throttled connection
       that single request sits on the critical path ahead of every script
       (measured: 542ms, and it was what held Speed Index to 3.9s). The same
       bytes in the document cost less than the serialized fetch did. The
       stylesheet is unchanged - only how it arrives.

       Written as one {@html} string, not a literal <style> element: a <style>
       in a .rose source is this component's SCOPED stylesheet - the compiler
       pulls it out, runs scopeCss() over it and deletes it from the template.
       A literal element here therefore vanished and left its contents in
       place as template text, which is not valid JS. Building the tag in the
       expression is the only form that survives. -->
  {@html cssInlineHtml()}
  {#if !chrome().cssInline}
  {#if chrome().cssHref}
  <link rel="stylesheet" href={chrome().cssHref}>
  {/if}
  {/if}
  <!-- Wraps window.fetch so same-origin writes carry the CSRF header. A guest
       has no token and the request goes out unchanged, which is correct: the
       server only requires the header when a session cookie rides along. -->
  <script src="/public/csrf.js"></script>
  {@html linkResetHtml()}
  {@html chrome().themeHead}
  {@html chrome().themeScripts}
  {#if publicPath()}{@html chrome().siteHead}{/if}
  {#if publicPath()}{@html chrome().pluginHead}{/if}
  <link rel="icon" href="data:,">

  <html lang="zh-CN">
  {#if publicPath()}
  <body class="min-h-screen bg-[var(--bg)] text-[var(--text)] antialiased">
  {/if}
  {#if adminPath()}
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
  {/if}
</head>

{#if adminPath()}
<slot />
{/if}
{#if publicPath()}
{@html chrome().bodyFix}
{#if isSkyscraper()}
{@html chrome().nav}
<div class="th-skyscraper">
{@html chrome().bodyOpen}
<slot />
{@html chrome().bodyClose}
{@html chrome().aside}
</div></main></div>
{@html chrome().footer}
</div>
{@html chrome().pluginFooter}
{/if}
{#if isNotSkyscraper()}
{@html chrome().bodyOpen}
<slot />
{@html chrome().bodyClose}
{@html chrome().pluginFooter}
{/if}
{/if}
