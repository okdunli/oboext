<script>
  // skyscraper chrome shell. Interactions (drawers, dark mode, share bar,
  // scroll-reveal, cardFlip) live in /public/theme.js as vanilla JS. Routes
  // ship zero framework JS on purpose (csr=false). Chrome HTML comes from
  // the live database through the "chrome" loader ($data, per request) and
  // is emitted with the {@html} primitive (rosezm 0.2.4).
  let chrome = $data(() => __rvLoad("chrome", {}));

  function adminPath() {
    const p =
      typeof window !== "undefined"
        ? window.location.pathname
        : String(getContext().pathname || "");
    return p.indexOf("/admin") === 0;
  }
  function publicPath() {
    return !adminPath();
  }
</script>

<head>
  <title>{chrome().siteTitle}</title>
  <meta name="description" content={chrome().siteDescription}>
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={chrome().siteTitle}>
  <meta property="og:description" content={chrome().siteDescription}>
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={chrome().siteTitle}>
  <meta name="twitter:description" content={chrome().siteDescription}>
  <link rel="stylesheet" href="/public/theme.css">
  {@html chrome().themeHead}
  <link rel="icon" href="data:,">
</head>

{#if adminPath()}
<slot />
{/if}
{#if publicPath()}
<script src="/public/noflash.js"></script>
<script src="/public/theme.js"></script>
<script src="/public/comments.js"></script>
<div class="th-skyscraper">
{@html chrome().nav}
  <div class="sk-body"><main id="sk-main"><div class="container"><div class="main-column"><div class="sk-frame">
  <slot />
  </div></div><aside class="sidebar-column with-separate-line"><div class="sidebar-content">{@html chrome().aside}</div></aside></div></main></div>
{@html chrome().footer}
</div>
{/if}
