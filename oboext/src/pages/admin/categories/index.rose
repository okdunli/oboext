<script>
  // Categories manager — port of <TaxonomyManager type="category" />. Same
  // shape as the tags page: a horizontal add bar, one full-width table, and
  // a modal for editing. Categories additionally carry a parent, description
  // and an icon (a lucide kebab name; any other text is shown verbatim).
  let d = $data(() => __rvLoad("admin.taxonomies", {}));
  function cats() {
    return d().categories || [];
  }
  function topCats() {
    return cats().filter((c) => !c.parentId);
  }
  function parentName(c) {
    if (!c.parentId) return "—";
    const p = cats().find((x) => x.id === c.parentId);
    return p ? p.name : "—";
  }
  function descOf(c) {
    return c.description || "";
  }
  function iconOf(c) {
    return c.icon || "";
  }
  function parentOf(c) {
    return c.parentId || "";
  }
  function emptyHint() {
    return cats().length ? [] : [1];
  }
  function confirmDelete(c) {
    return "确认删除分类「" + c.name + "」？子分类会提升为顶级分类。";
  }
  function ic(n) {
    return '<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/' + n + '.svg)"></span>';
  }
  function catGlyph(c) {
    const v = (c.icon || "").trim();
    if (/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(v)) return ic(v);
    // Reject emoji / arbitrary glyphs: fall back to the folder icon so the
    // admin stays icon-consistent. The icon picker only offers SVG names.
    return ic("folder");
  }
  // Computed here because the rose compiler rejects a template {:else}.
  function taxNameClass(c) {
    return c.parentId ? "adm-tax-name is-child" : "adm-tax-name";
  }
</script>

<head>
  <title>分类 - 管理后台</title>
</head>

<form class="adm-card adm-tax-add adm-tax-add-cat" data-adm-form="create-category">
  <div class="adm-tax-fields">
    <div class="adm-field">
      <label>名称</label>
      <input class="adm-input" name="name" required placeholder="例如：技术随笔">
    </div>
    <div class="adm-field">
      <label>别名（可选）</label>
      <input class="adm-input" name="slug" placeholder="留空自动生成">
    </div>
    <div class="adm-field">
      <label>父分类</label>
      <select class="adm-select" name="parentId">
        <option value="">无（顶级）</option>
        {#each topCats() as c}
        <option value={c.id}>{c.name}</option>
        {/each}
      </select>
    </div>
    <div class="adm-field adm-tax-grow">
      <label>描述（可选）</label>
      <input class="adm-input" name="description" placeholder="分类说明">
    </div>
    <div class="adm-field">
      <label>图标（可选）</label>
      <input class="adm-input" name="icon" data-icon-picker placeholder="留空则用默认图标">
    </div>
  </div>
  <button class="adm-btn" type="submit">{@html ic("plus")} 添加</button>
</form>

<div class="adm-toolbar" style="gap:8px;">
  <button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-op="delete" data-url="/api/categories" data-confirm="确认删除选中的分类？其下文章将转为未分类，子分类升级为顶级。">批量删除</button>
</div>

<div class="adm-card adm-table-wrap adm-tax-table">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all" title="全选"></th>
        <th style="width:32px"></th>
        <th>名称</th>
        <th style="width:24%">别名</th>
        <th style="width:120px">父分类</th>
        <th>描述</th>
        <th style="width:200px;text-align:right">操作</th>
      </tr>
    </thead>
    <tbody>
      {#each cats() as c}
      <tr data-cat-id={c.id} data-parent-id={c.parentId || ""}>
        <td><input type="checkbox" class="adm-check" value={c.id}></td>
        <td class="adm-cat-td">
          <button type="button" class="adm-iconbtn adm-cat-ic" data-cat-icon-id={c.id} data-cat-icon-val={iconOf(c)} title="更换图标">{@html catGlyph(c)}</button>
          <span class="adm-drag-handle" draggable="true" title="拖动排序（拖到行左侧空白＝同级/置顶，拖到行身＝成为其子分类）">{@html ic("grip-vertical")}</span>
        </td>
        <td>
          <span class={taxNameClass(c)}>{c.name}</span>
        </td>
        <td><span class="adm-muted">{c.slug}</span></td>
        <td><span class="adm-muted">{parentName(c)}</span></td>
        <td><span class="adm-muted">{descOf(c)}</span></td>
        <td>
          <div class="row-actions">
            <a class="adm-iconbtn" href={"/blog/category/" + c.slug} target="_blank" title="查看">
              {@html ic("external-link")}
            </a>
            <button
              type="button"
              class="adm-iconbtn"
              data-tax-edit
              data-id={c.id}
              data-name={c.name}
              data-slug={c.slug}
              data-description={descOf(c)}
              data-icon={iconOf(c)}
              data-parentid={parentOf(c)}
              title="编辑名称 / 描述 / 图标"
            >{@html ic("pencil")} 编辑</button>
            <button
              type="button"
              class="adm-iconbtn danger"
              data-adm-act="delete"
              data-url={"/api/categories/" + c.id}
              data-confirm={confirmDelete(c)}
              title="删除"
            >{@html ic("trash-2")} 删除</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">还没有分类，在上方添加第一个吧。</div>
  {/each}
</div>

<div class="adm-modal" data-tax-modal hidden>
  <div class="adm-modal-box">
    <form data-adm-form="edit-category">
      <div class="adm-modal-hd">
        <h2>编辑分类</h2>
        <button type="button" class="adm-modal-x" data-tax-cancel>{@html ic("x")}</button>
      </div>
      <div class="adm-modal-bd">
        <input type="hidden" name="id">
        <div class="adm-field">
          <label>名称</label>
          <input class="adm-input" name="name" required maxlength="100">
        </div>
        <div class="adm-field">
          <label>别名（留空保存则保持现有别名）</label>
          <input class="adm-input" name="slug" maxlength="120">
        </div>
        <div class="adm-field">
          <label>父分类</label>
          <select class="adm-select" name="parentId">
            <option value="">无（顶级）</option>
            {#each topCats() as c}
            <option value={c.id}>{c.name}</option>
            {/each}
          </select>
        </div>
        <div class="adm-field">
          <label>描述</label>
          <textarea class="adm-textarea" name="description" rows="2" maxlength="500"></textarea>
        </div>
        <div class="adm-field">
          <label>图标</label>
          <input class="adm-input" name="icon" data-icon-picker placeholder="留空则用默认图标">
        </div>
      </div>
      <div class="adm-modal-ft">
        <button type="button" class="adm-btn adm-btn-ghost" data-tax-cancel>取消</button>
        <button type="submit" class="adm-btn">保存</button>
      </div>
    </form>
  </div>
</div>
