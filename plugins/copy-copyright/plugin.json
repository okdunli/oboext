{
  "slug": "copy-copyright",
  "name": "复制版权声明",
  "description": "访客复制正文内容时自动在剪贴板末尾追加版权声明与原文链接，文案可自定义，短复制不追加。",
  "version": "1.0.0",
  "author": "Oboext",
  "icon": "Copyright",
  "hooks": [
    "footer.html"
  ],
  "settings": [
    {
      "key": "general",
      "label": "版权设置",
      "fields": [
        {
          "key": "template",
          "label": "追加文案",
          "type": "textarea",
          "default": "\\n\\n—— 著作权归作者所有，转载请注明出处。\\n原文：{url}",
          "help": "可用占位符：{url} 原文链接、{title} 文章标题"
        },
        {
          "key": "onlyArticle",
          "label": "仅在文章/独立页面追加",
          "type": "switch",
          "default": true,
          "half": true
        },
        {
          "key": "minChars",
          "label": "最少复制字数",
          "type": "number",
          "default": 30,
          "min": 0,
          "unit": "字",
          "half": true,
          "help": "复制内容短于该字数时不追加，方便复制短句、代码"
        }
      ]
    }
  ]
}
