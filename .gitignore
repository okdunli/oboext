# build output
dist/

# Vercel zero-config hardcodes its static glob to `public/**/*` at the deploy
# root; tools/build.mjs mirrors oboext/public here so that directory exists.
# Generated - the source of truth is oboext/public.
/public/

# Vercel CLI state: .env.production.local holds the DATABASE_URL with the Neon
# password, project.json pins the project id. Local only - none of it belongs in
# the repo, and Vercel regenerates all of it on every build.
.vercel/

# local verification scratch: a throwaway `npm install vercel --ignore-scripts`
# used to run `vercel build` locally. Not part of the app.
.vercel-tools/

# go single-binary server artifacts
oboext-server
oboext-server.exe

# deps
node_modules/

# local env files (may contain secrets) - never commit
.env
.env.*
!.env.example

# local dev database (created by running the app)
.data/

# local scratch: dev-server logs, one-off probe *.log
tmp/
.vfy/

# test infrastructure — 100% developer-side; the build / deploy /
# runtime never import these. Unit tests + smoke live in scripts/,
# integration / perf / security checks + benches + demo seed in tests/.
scripts/
tests/

# local verification snapshots (tools/ snapshot diffing across iterations)
.snapshots/

# isolated test database + its single-process lock (live suite runs here)
.data-test/
.data-test.app-lock

# agent / editor workspace
.workbuddy/

# one-off python scratch from past investigations
.r47-*.py

# generated by tools/ at deploy time
db-reports/
deploy-logs/

# rosezm build artifact inside the content app (routes.ts etc.) - regenerated
# by every `npm run build`, source of truth is oboext/src/pages/.
oboext/src/.rosezm/
.rosezm-export/
# rosezm CLI scratch (per-process build/dev caches at the app root)
oboext/.rosezm-build/
oboext/.rosezm-dev/

# runtime upload target: ship the empty dir, never the uploaded files
content/uploads/*
!content/uploads/.gitkeep

# generated by tools/gen.mjs from what is actually installed (plugins/<slug>/plugin.json,
# themes/<slug>/manifest.json). Never committed: a table describing one machine's install
# set is a lie on every other checkout, and a stale one made a fresh clone fail to build.
oboext/src/server/plugin-entries.ts
oboext/src/server/theme-entries.ts
oboext/theme.css
oboext/public/theme.css

# macOS Finder metadata - never belongs in the repo
.DS_Store
