<script>
  // Media library (port of components/MediaLibrary.tsx).
  let d = $data(() => __rvLoad("admin.media", {}));
  function copy() {
    return d().s || {};
  }
  function items() {
    return d().items || [];
  }
  function dataJson() {
    return JSON.stringify(d());
  }
  function isImage(m) {
    return String(m.mimeType || "").indexOf("image/") === 0;
  }
  function tagList(m) {
    return String(m.tags || "").split(",").map(function (t) { return t.trim(); }).filter(Boolean);
  }
  function sizeText(n) {
    n = Number(n) || 0;
    if (n < 1024) return n + " B";
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
    return (n / 1024 / 1024).toFixed(1) + " MB";
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<form class="adm-card adm-media-upload" data-media-upload-form>
  <div class="adm-card-bd">
    <div class="adm-dropzone" data-media-drop role="button" tabindex="0">
      <input type="file" class="adm-hidden-file" data-media-file>
      <div class="adm-dz-icon"><span class="adm-ic adm-ic-xl" style="--i:url(/public/icons/upload.svg)"></span></div>
      <p class="adm-dz-text" data-media-dz-text>{copy().uploadHint}</p>
      <p class="adm-dz-hint">{copy().pasteHint}</p>
    </div>
    <div class="adm-upload-row">
      <div class="adm-field" style="flex:1;min-width:240px">
        <span class="adm-hint" style="display:block;margin-bottom:4px">{copy().altLabel}</span>
        <input class="adm-input" data-media-alt placeholder="{copy().phAlt}">
      </div>
      <button type="submit" class="adm-btn adm-btn-green" data-media-submit disabled>{copy().upload}</button>
      <span class="adm-media-msg" data-media-msg></span>
    </div>
  </div>
</form>

<!-- shared hidden input for the "replace file" action (kept outside the
     upload form so it never rides along with a normal upload) -->
<input type="file" class="adm-hidden-file" data-media-replace-file>

<div class="adm-toolbar" style="margin-top:16px">
  <label class="adm-check-line"><input type="checkbox" data-media-all> {copy().selectAll}</label>
  <input class="adm-input" data-media-search placeholder="{copy().phSearch}" style="max-width:220px">
  <select class="adm-input" data-media-type style="max-width:120px">
    <option value="">{copy().filterAll}</option>
    <option value="image">{copy().filterImages}</option>
    <option value="doc">{copy().filterNonImages}</option>
  </select>
  <input class="adm-input" data-media-tagfilter placeholder="{copy().phTags}" style="max-width:130px">
  <span style="flex:1"></span>
  <span class="adm-hint" data-media-count>{copy().selectedN}</span>
  <button type="button" class="adm-btn adm-btn-sm" data-media-copyall disabled title="{copy().titleCopyAll}">{copy().titleCopy}</button>
  <button type="button" class="adm-btn adm-btn-sm" data-media-tagbtn disabled title="{copy().titleBulkTag}">{copy().tag}</button>
  <button type="button" class="adm-btn adm-btn-sm" data-media-variants-all title="{copy().titleVariants}">{copy().variants}</button>
  <button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-media-bulk disabled>{copy().bulkDelete}</button>
</div>

<div class="adm-media-grid" data-media-grid data-media={dataJson()} title="{copy().titleDrag}">
  {#each items() as m}
  <div class="adm-media-card" data-media-id={m.id} draggable="true">
    <label class="adm-media-check">
      <input type="checkbox" class="adm-media-sel" value={m.id}>
    </label>
    {#if (() => isImage(m))()}
    <img class="adm-media-thumb" src={m.url} alt={m.alt || m.filename} loading="lazy" data-media-preview-btn>
    {/if}
    {#if (() => !isImage(m))()}
    <div class="adm-media-file" data-media-preview-btn><span class="adm-ic adm-ic-lg" style="--i:url(/public/icons/file.svg)"></span><span>{m.mimeType}</span></div>
    {/if}
    <div class="adm-media-meta">
      <p class="adm-media-name" title={m.filename}>{m.filename}</p>
      <p class="adm-hint">{sizeText(m.size)}</p>
      {#if (() => tagList(m).length)()}
      <p class="adm-media-tags">{#each tagList(m) as t}<span class="adm-media-tag">{t}</span>{/each}</p>
      {/if}
      <div class="adm-media-actions">
        <div class="row-actions">
          <button type="button" class="adm-iconbtn" data-media-preview-btn title="{copy().titleView}"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/eye.svg)"></span></button>
          <button type="button" class="adm-iconbtn" data-media-copy data-url={m.url} title="{copy().titleCopy}"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/link.svg)"></span></button>
          <button type="button" class="adm-iconbtn" data-media-edit-btn title={copy().titleEdit}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/pencil.svg)"></span></button>
          <button type="button" class="adm-iconbtn" data-media-replace-btn title="{copy().titleReplace}"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/replace.svg)"></span></button>
        </div>
        <button type="button" class="adm-iconbtn danger" data-media-del data-url={"/api/media/" + m.id} data-confirm="{copy().confirmDelete}" title={copy().titleDelete}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span></button>
      </div>
    </div>
  </div>
  {/each}
</div>

<div style="margin-top:16px;text-align:center">
  <button type="button" class="adm-btn adm-btn-ghost" data-media-more hidden>{copy().loadMore}</button>
  <p class="adm-hint" data-media-total style="margin-top:8px"></p>
</div>

<div class={"adm-empty adm-media-empty" + (items().length ? " is-hidden" : "")} data-media-empty style="padding:48px 16px">
  <div style="margin-bottom:8px;display:flex;justify-content:center"><span class="adm-ic" style="width:32px;height:32px;--i:url(/public/icons/image.svg)"></span></div>
  <p>{copy().empty}</p>
  <p class="adm-hint">使用上方{copy().upload}区添加你的第一张图片或文档。</p>
</div>

<!-- edit alt text modal -->
<div class="adm-modal" data-media-edit hidden>
  <div class="adm-modal-box">
    <div class="adm-modal-hd">
      <strong>{copy().editTitle}</strong>
      <button type="button" class="adm-iconbtn" data-media-edit-close aria-label={copy().close}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/x.svg)"></span></button>
    </div>
    <div class="adm-modal-bd">
      <label class="adm-field" style="display:block">
        <span class="adm-hint" style="display:block;margin-bottom:4px">{copy().editAlt}</span>
        <textarea class="adm-textarea" rows="3" data-media-edit-alt></textarea>
      </label>
      <label class="adm-field" style="display:block;margin-top:10px">
        <span class="adm-hint" style="display:block;margin-bottom:4px">{copy().editTags}</span>
        <input class="adm-input" data-media-edit-tags placeholder="{copy().phBulkTags}">
      </label>
      <div class="adm-hint" style="margin-top:10px">
        {copy().editFile}
        <div class="adm-media-realname" data-media-edit-name></div>
      </div>
      <img class="adm-media-edit-img" data-media-edit-img alt="">
      <div class="adm-hint" style="margin-top:10px" data-media-edit-usage hidden></div>
    </div>
    <div class="adm-modal-ft">
      <button type="button" class="adm-btn adm-btn-ghost" data-media-edit-close>{copy().cancel}</button>
      <button type="button" class="adm-btn" data-media-edit-save>{copy().save}</button>
    </div>
  </div>
</div>

<!-- preview modal -->
<div class="adm-modal" data-media-preview hidden>
  <button type="button" class="adm-modal-x" data-media-preview-close aria-label={copy().close}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/x.svg)"></span></button>
  <div class="adm-modal-preview" data-media-preview-inner>
    <img class="adm-media-preview-img" data-media-preview-img alt="">
    <a class="adm-btn adm-btn-ghost adm-media-preview-open" target="_blank" rel="noopener" data-media-preview-open>{copy().openFile}</a>
    <div class="adm-media-preview-meta" data-media-preview-meta></div>
  </div>
</div>

<!-- batch tag modal -->
<div class="adm-modal" data-media-tagmodal hidden>
  <div class="adm-modal-box">
    <div class="adm-modal-hd">
      <strong>批量{copy().tag}</strong>
      <button type="button" class="adm-iconbtn" data-media-tag-close aria-label={copy().close}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/x.svg)"></span></button>
    </div>
    <div class="adm-modal-bd">
      <p class="adm-hint" data-media-tag-count style="margin-top:0"></p>
      <input class="adm-input" data-media-tag-input placeholder={copy().phTagsEdit}>
      <div style="margin-top:10px;display:flex;flex-direction:column;gap:6px">
        <label class="adm-check-line"><input type="radio" name="media-tag-mode" value="add" checked> {copy().tagAppend}</label>
        <label class="adm-check-line"><input type="radio" name="media-tag-mode" value="replace"> {copy().tagOverwrite}</label>
      </div>
    </div>
    <div class="adm-modal-ft">
      <button type="button" class="adm-btn adm-btn-ghost" data-media-tag-close>{copy().cancel}</button>
      <button type="button" class="adm-btn" data-media-tag-save>{copy().save}</button>
    </div>
  </div>
</div>
