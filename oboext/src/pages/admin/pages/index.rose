<script>
  // Static pages list (all statuses, live DB). Port of app/admin/pages/page.tsx.
  let data = $data(() =>
    __rvLoad("admin.pages", {
      status: __rvQs().get("status") || "",
      page: __rvQs().get("page"),
      after: __rvQs().get("after") || "",
      sort: __rvQs().get("sort") || "",
    }),
  );
  // NB: {#each} compiles its expression as a zero-arg call, so iteration
  // targets must be function accessors, never bare arrays.
  function rows() {
    return data().items;
  }
  // Every visible string comes from the loader in the request's language
  // (R489, same contract as the dashboard / posts / comments).
  function copy() {
    return data().s || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function pagerSummary() {
    return hint("pagerSummary", { total: data().total, page: data().page });
  }
  function confirmDeleteOne(title) {
    return hint("confirmDeleteOne", { title: title });
  }
  function fmtDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") +
      "-" + String(d.getDate()).padStart(2, "0");
  }
  function statusLabel(v) {
    const c = copy();
    return v === "published" ? c.published : v === "draft" ? c.draft : c.archived;
  }
  function hasNext() {
    return data().page * data().limit < data().total;
  }
  function hasPrev() {
    return data().page > 1;
  }
  function hasPager() {
    return data().total > data().limit || data().page > 1;
  }
  function pagerHref(p) {
    const status = __rvQs().get("status");
    const parts = [];
    if (status) parts.push("status=" + encodeURIComponent(status));
    if (byOrder()) parts.push("sort=order");
    parts.push("page=" + p);
    return "/admin/pages?" + parts.join("&");
  }
  function byOrder() {
    return __rvQs().get("sort") === "order";
  }
  function sortHref() {
    const status = __rvQs().get("status");
    return byOrder()
      ? "/admin/pages" + (status ? "?status=" + encodeURIComponent(status) : "")
      : "/admin/pages?sort=order" + (status ? "&status=" + encodeURIComponent(status) : "");
  }
  function emptyHint() {
    return rows().length ? [] : [1];
  }
  function pager() {
    return hasPager() ? [1] : [];
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div class="adm-tabs">
    <a class={(__rvQs().get("status") || "") === "" ? "is-active" : ""} href="/admin/pages">{copy().filterAll}</a>
    <a class={__rvQs().get("status") === "published" ? "is-active" : ""} href="/admin/pages?status=published">{copy().published}</a>
    <a class={__rvQs().get("status") === "draft" ? "is-active" : ""} href="/admin/pages?status=draft">{copy().draft}</a>
    <a class={__rvQs().get("status") === "archived" ? "is-active" : ""} href="/admin/pages?status=archived">{copy().archived}</a>
  </div>
  <span style="flex:1"></span>
  <a class="adm-btn" href="/admin/pages/new"><span class="adm-ic" style="--i:url(/public/icons/plus.svg)"></span>{copy().write}</a>
</div>

<div class="adm-toolbar" style="gap:8px;">
  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/pages" data-op="publish">{copy().bulkPublish}</button>
  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/pages" data-op="draft">{copy().bulkDraft}</button>
  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/pages" data-op="archive">{copy().bulkArchive}</button>
  <button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-url="/api/pages" data-op="delete" data-confirm={copy().confirmBulkDelete}>{copy().bulkDelete}</button>
  <span style="flex:1"></span>
  {#if byOrder()}<span class="adm-hint">{copy().sortHint}</span>{/if}
  <a class="adm-btn adm-btn-ghost adm-btn-sm" href={sortHref()}>{byOrder() ? copy().sortByUpdated : copy().sortByOrder}</a>
</div>

<div class="adm-card adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all"></th>
        <th>{copy().colTitle}</th>
        <th style="width:90px">{copy().colStatus}</th>
        <th style="width:72px">{copy().colOrder}</th>
        <th style="width:120px">{copy().colUpdated}</th>
        <th style="width:130px"></th>
      </tr>
    </thead>
    <tbody>
      {#each rows() as p}
      <tr>
        <td><input type="checkbox" class="adm-check" value={p.id}></td>
        <td>
          <a class="title" href={"/admin/pages/" + p.id}>{p.title}</a>
          <div class="sub">/{p.slug}{#if p.locale === 'en'} · EN{/if}{#if p.pair} <a href={"/admin/pages/" + p.pair.id} style="margin-left:8px">↔ {p.pair.slug}</a>{/if}</div>
        </td>
        <td><span class={"adm-tag " + p.status}>{statusLabel(p.status)}</span></td>
        <td class="adm-hint">{p.order}</td>
        <td class="adm-hint">{fmtDate(p.updatedAt)}</td>
        <td>
          <div class="row-actions">
            <a class="adm-iconbtn" href={p.url} target="_blank" rel="noopener"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/eye.svg)"></span>{copy().actView}</a>
            <a class="adm-iconbtn" href={"/admin/pages/" + p.id}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/pencil.svg)"></span>{copy().actEdit}</a>
            <button class="adm-iconbtn danger" data-adm-act="delete" data-url={"/api/pages/" + p.id} data-confirm={confirmDeleteOne(p.title)}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span>{copy().actDelete}</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">{copy().empty}</div>
  {/each}
</div>

{#each pager() as _}
<div class="adm-pager">
  {pagerSummary()}
  <span style="flex:1"></span>
  {#if hasPrev()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={pagerHref(data().page - 1)}>{copy().pagerPrev}</a>{/if}
  {#if hasNext()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={pagerHref(data().page + 1)}>{copy().pagerNext}</a>{/if}
</div>
{/each}
