<script>
  // Admin login. Public (middleware-whitelisted); POST /api/auth/login sets
  // the HttpOnly cms_session cookie, then we hard-navigate into the shell.
  // The card itself (four modes: password / code / reset / 2FA) is shared
  // with the disguised secret entry — one pre-rendered string via the
  // loginCard loader, all behaviour in admin.js's initLogin().
  let card = $data(() => __rvLoad("loginCard", {}));
  function cardHtml() {
    return card().html || "";
  }
</script>

<head>
  <title>登录 - 管理后台</title>
</head>

<div class="adm-auth">
  <div class="adm-auth-side">
    <div class="adm-auth-brand"><span class="adm-auth-mark">O</span> oboext</div>
    <div>
      <h1>内容管理后台</h1>
      <p>动态全栈博客：文章、评论、分类、标签、用户与站点设置，全部按请求实时读写数据库。</p>
      <ul>
        <li>jose HS256 会话 + bcrypt 密码哈希</li>
        <li>登录失败滑动窗口限流</li>
        <li>邮箱 / 手机验证码登录与两步验证</li>
      </ul>
    </div>
    <div class="adm-hint">oboext on rosezm · Node runtime</div>
  </div>
  <div class="adm-auth-main">
    {@html cardHtml()}
  </div>
</div>
