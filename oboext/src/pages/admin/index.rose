<script>
  // Dashboard — counters, post status distribution, recent activity, API entry.
  let st = $data(() => __rvLoad("admin.dashboard", {}));
  // Accessors, never eager top-level reads: the compiler initializes $data
  // state after the script body (0.2.4), so reading st() here is a TDZ error.
  function counts() {
    return st().counts;
  }
  // The loader hands down every visible string in the request's language
  // (prefix -> cookie -> Accept-Language, resolved by the middleware), so the
  // template only ever reads copy() - no literal lives here twice.
  function copy() {
    return st().s || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function trendsHint() {
    return hint("trendsHint", { posts: trendTotal().posts, comments: trendTotal().comments });
  }
  function sourcesHint() {
    return hint("sourcesHint", { views: sourceTotal() });
  }
  function postStatus() {
    return st().postStatus;
  }
  // NB: {#each} compiles its expression as a zero-arg call — arrays exposed to
  // the template must ride function accessors.
  function recentPosts() {
    return st().recentPosts;
  }
  function recentComments() {
    return st().recentComments;
  }
  // Stat cards pushed by plugins through the dashboard.cards filter hook.
  function pluginCards() {
    return st().cards || [];
  }
  // 近 7 天每日新增（loader 返回，升序 7 项：{d:"2026-10-20",posts,comments}）。
  function trends() {
    return st().trends || [];
  }
  // One bar set per series: x/y/w/h precomputed against the day max so the
  // template stays a dumb rect list. Zero days keep a 1px stub - flat enough
  // to read as "nothing", tall enough to stay hoverable for its <title>.
  function trendBars(kind) {
    const rows = trends();
    let max = 0;
    rows.forEach(function (r) {
      const v = Number(r[kind]) || 0;
      if (v > max) max = v;
    });
    return rows.map(function (r, i) {
      const v = Number(r[kind]) || 0;
      const h = Math.max(1, max > 0 ? Math.round((v / max) * 44) : 0);
      return { x: i * 40 + 6, y: 46 - h, w: 28, h: h, v: v, d: r.d };
    });
  }
  // {#each} compiles its expression as a zero-arg call, so each series needs
  // its own accessor instead of trendBars("posts").
  function trendPostBars() {
    return trendBars("posts");
  }
  function trendCommentBars() {
    return trendBars("comments");
  }
  function trendTotal() {
    return trends().reduce(
      function (acc, r) {
        return {
          posts: acc.posts + (Number(r.posts) || 0),
          comments: acc.comments + (Number(r.comments) || 0),
        };
      },
      { posts: 0, comments: 0 },
    );
  }
  // 今日来源分布（R255，loader 返回，按 views 降序：{kind,views,uniques}）。
  // 空数组 = 尚无可统计的数据（rollup 每分钟跑一次），此时整张卡片不渲染，
  // 而不是画五个 0 让人误以为"今天没流量"。
  function sources() {
    return st().sources || [];
  }
  function sourceTotal() {
    return sources().reduce(function (acc, r) {
      return acc + (Number(r.views) || 0);
    }, 0);
  }
  function sourceKindLabel(k) {
    const c = copy();
    return k === "search" ? c.srcSearch
      : k === "social" ? c.srcSocial
      : k === "internal" ? c.srcInternal
      : k === "direct" ? c.srcDirect
      : c.srcOther;
  }
  // 占比条：以当前最大来源为满格，避免一个 90% 的搜索引擎把其余全压成 0px。
  function sourcePct(r) {
    var max = 0;
    sources().forEach(function (x) {
      var v = Number(x.views) || 0;
      if (v > max) max = v;
    });
    var v = Number(r.views) || 0;
    return max > 0 ? Math.max(2, Math.round((v / max) * 100)) : 0;
  }
  // {#each} 编译成零参调用，所以逐行百分比也要有自己的访问器。
  function sourceRows() {
    return sources().map(function (r) {
      return { kind: r.kind, views: Number(r.views) || 0, uniques: Number(r.uniques) || 0, pct: sourcePct(r) };
    });
  }
  // 来源 × 文章（R256，loader 返回：近 7 日按渠道各取 Top 文章，views 降序，
  // {kind,postId,title,views}）。空数据同样整卡不渲染 —— 没有一周流量时画一张
  // 空表会让人以为功能坏了，而不是"还没数据"。
  function topSourcePosts() {
    return st().topSourcePosts || [];
  }
  function topSourcePostRows() {
    return topSourcePosts().map(function (r) {
      return {
        kind: r.kind,
        postId: r.postId,
        title: r.title,
        views: Number(r.views) || 0,
      };
    });
  }
  function linkedCards() {
    return pluginCards().filter(function (c) { return !!c.href; });
  }
  function plainCards() {
    return pluginCards().filter(function (c) { return !c.href; });
  }
  // R481: the seed card is gated on the SAME rule the service enforces (no
  // posts and no pages), so the button is never shown where it would 409.
  function isEmptySite() {
    const c = counts() || {};
    return !Number(c.posts) && !Number(c.pages);
  }
  function fmtDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") +
      "-" + String(d.getDate()).padStart(2, "0") + " " +
      String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
  }
  function statusLabel(v) {
    const c = copy();
    return v === "published" ? c.published : v === "draft" ? c.draft : c.archived;
  }
  function commentStatusLabel(v) {
    const c = copy();
    return v === "published" ? c.commentApproved : v === "pending" ? c.commentPending : c.commentSpam;
  }
  function short(t, n) {
    t = String(t || "");
    return t.length > n ? t.slice(0, n) + "…" : t;
  }
  function ic(n, size) {
    size = size || 16;
    return '<span class="adm-ic" aria-hidden="true" style="width:' + size +
      "px;height:" + size + "px;--i:url(/public/icons/" + n + ".svg)\"></span>";
  }
  // 实时刷新：轮询循环与 5s 节流在 /public/admin-live.js（admin 页共享，
  // 三份内联副本曾各自漂移）。框架的 store 广播（客户端 EventSource 连
  // /__rosezm_store）在这里**故意不用**：prod 形态没挂载那个端点，连接会
  // 落到 SPA fallback 上无限重连；且它的开启条件是全应用任一 .rose 脚本
  // 原文匹配 store 调用，写一行注释都算——本页不含该调用，tests 有守卫。
  // 三份内联副本曾各自漂移）；refresh() 是框架 runtime 的 SWR 重取 hook。
  onMount(function () {
    window.startAdminLive(function () { refresh(); });
  });

  // R479: first-run demo seed. Guarded: the compiler also evaluates this
  // module on the server (no document there).
  if (typeof document !== "undefined") document.addEventListener("click", async (e) => {
    const btn = e.target instanceof Element ? e.target.closest("[data-adm-demo-seed]") : null;
    if (!btn) return;
    btn.disabled = true;
    try {
      const r = await fetch("/api/admin/demo-content", { method: "POST", credentials: "same-origin" });
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || copy().seedFail);
      if (typeof window.admToast === "function") window.admToast(copy().seedOk, "ok");
      setTimeout(() => location.reload(), 600);
    } catch (err) {
      btn.disabled = false;
      if (typeof window.admToast === "function") window.admToast(err instanceof Error ? err.message : copy().seedFail, "err");
    }
  });
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-grid adm-stats">
  <a class="adm-card adm-stat" href="/admin/posts"><div class="k">{@html ic("file-text")} {copy().posts}</div><div class="v">{counts().posts}</div></a>
  <a class="adm-card adm-stat" href="/admin/pages"><div class="k">{@html ic("file")} {copy().pages}</div><div class="v">{counts().pages}</div></a>
  <a class="adm-card adm-stat" href="/admin/comments"><div class="k">{@html ic("message-square")} {copy().comments}</div><div class="v">{counts().comments}</div>{#if counts().commentsPending > 0}<div class="sub">{counts().commentsPending} {copy().pendingUnit}</div>{/if}</a>
  <a class="adm-card adm-stat" href="/admin/media"><div class="k">{@html ic("image")} {copy().media}</div><div class="v">{counts().media}</div></a>
  <a class="adm-card adm-stat" href="/admin/categories"><div class="k">{@html ic("folder")} {copy().categories}</div><div class="v">{counts().categories}</div></a>
  <a class="adm-card adm-stat" href="/admin/tags"><div class="k">{@html ic("tags")} {copy().tags}</div><div class="v">{counts().tags}</div></a>
  <a class="adm-card adm-stat" href="/admin/users"><div class="k">{@html ic("users")} {copy().users}</div><div class="v">{counts().users}</div></a>
</div>

{#if linkedCards().length > 0}
<div class="adm-grid adm-stats">
  {#each linkedCards() as c}
  <a class="adm-card adm-stat" href={c.href}><div class="k">{c.label}</div><div class="v">{c.value}</div>{#if c.sub}<div class="sub">{c.sub}</div>{/if}</a>
  {/each}
</div>
{/if}

{#if plainCards().length > 0}
<div class="adm-grid adm-stats">
  {#each plainCards() as c}
  <div class="adm-card adm-stat"><div class="k">{c.label}</div><div class="v">{c.value}</div>{#if c.sub}<div class="sub">{c.sub}</div>{/if}</div>
  {/each}
</div>
{/if}

{#if isEmptySite()}
<div class="adm-card" style="margin-top:16px;">
  <div class="adm-card-hd">{copy().firstRun}</div>
  <div class="adm-card-bd">
    <p class="adm-hint" style="margin:0 0 10px">{copy().firstRunLead}</p>
    <button class="adm-btn adm-btn-sm" type="button" data-adm-demo-seed>{copy().seed}</button>
  </div>
</div>
{/if}

<div class="adm-grid adm-cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
  <div class="adm-card">
    <div class="adm-card-hd">{copy().postStatus}
      <span class="spacer" style="flex:1"></span>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/posts/new">{copy().writePost}</a>
    </div>
    <div class="adm-card-bd">
      <div class="adm-kv">
        <span class="k">{copy().published}</span><b>{postStatus().published}</b>
        <span class="k">{copy().draft}</span><b>{postStatus().draft}</b>
        <span class="k">{copy().archived}</span><b>{postStatus().archived}</b>
      </div>
    </div>
  </div>
  <div class="adm-card">
    <div class="adm-card-hd">{copy().quickActions}</div>
    <div class="adm-card-bd" style="display:flex;flex-wrap:wrap;gap:8px;">
      <a class="adm-btn adm-btn-sm" href="/admin/posts/new">{copy().newPost}</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/comments">{copy().reviewComments}</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/security-logs?typePrefix=admin.">{copy().auditLog}</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/categories">{copy().categories}</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/settings">{copy().settings}</a>
    </div>
  </div>
</div>

{#if trends().length > 0}
<div class="adm-card adm-trends" style="margin-top:16px;">
  <div class="adm-card-hd">{copy().trends}
    <span class="spacer" style="flex:1"></span>
    <span class="adm-hint" style="font-size:12px">{trendsHint()}</span>
  </div>
  <div class="adm-card-bd">
    <div class="adm-trend-row" style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <span style="width:40px;flex:none;display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--adm-muted)">
        <i style="width:8px;height:8px;border-radius:2px;background:var(--adm-accent);display:inline-block"></i>{copy().posts}
      </span>
      <svg class="adm-spark" viewBox="0 0 280 48" width="280" height="48" role="img" aria-label={copy().chartPosts} style="height:auto;max-width:100%;">
        {#each trendPostBars() as b}
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="2" fill="var(--adm-accent)"><title>{b.d} {copy().tipPosts} +{b.v}</title></rect>
        {/each}
      </svg>
    </div>
    <div class="adm-trend-row" style="display:flex;align-items:center;gap:10px;">
      <span style="width:40px;flex:none;display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--adm-muted)">
        <i style="width:8px;height:8px;border-radius:2px;background:var(--adm-green);display:inline-block"></i>{copy().comments}
      </span>
      <svg class="adm-spark" viewBox="0 0 280 48" width="280" height="48" role="img" aria-label={copy().chartComments} style="height:auto;max-width:100%;">
        {#each trendCommentBars() as b}
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="2" fill="var(--adm-green)"><title>{b.d} {copy().tipComments} +{b.v}</title></rect>
        {/each}
      </svg>
    </div>
  </div>
</div>
{/if}

{#if sources().length > 0}
<div class="adm-card" style="margin-top:16px;">
  <div class="adm-card-hd">{copy().sources}
    <span class="spacer" style="flex:1"></span>
    <span class="adm-hint" style="font-size:12px">{sourcesHint()}</span>
  </div>
  <div class="adm-card-bd">
    {#each sourceRows() as r}
    <div class="adm-trend-row" style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
      <span style="width:76px;flex:none;font-size:13px;color:var(--adm-muted)">{sourceKindLabel(r.kind)}</span>
      <span style="flex:1;height:8px;border-radius:4px;background:var(--adm-border);overflow:hidden;display:block;">
        <i style={"display:block;height:100%;border-radius:4px;background:var(--adm-accent);width:" + r.pct + "%"}></i>
      </span>
      <span class="adm-hint" style="width:88px;flex:none;text-align:right;font-size:12px">{r.views} {copy().visits} / {r.uniques} {copy().visitors}</span>
    </div>
    {/each}
  </div>
</div>
{/if}

{#if topSourcePostRows().length > 0}
<div class="adm-card" style="margin-top:16px;">
  <div class="adm-card-hd">{copy().sourcesByPost}
    <span class="spacer" style="flex:1"></span>
    <span class="adm-hint" style="font-size:12px">{copy().sourcesByPostHint}</span>
  </div>
  <div class="table-responsive">
    <table class="adm-table">
      <thead><tr><th>{copy().channel}</th><th>{copy().postTitle}</th><th style="text-align:right">{copy().views}</th></tr></thead>
      <tbody>
        {#each topSourcePostRows() as r}
        <tr>
          <td style="white-space:nowrap">{sourceKindLabel(r.kind)}</td>
          <td><a href={"/admin/posts/" + r.postId}><div class="title">{short(r.title, 28)}</div></a></td>
          <td class="adm-hint" style="text-align:right">{r.views} {copy().visits}</td>
        </tr>
        {/each}
      </tbody>
    </table>
  </div>
</div>
{/if}

<div class="adm-grid adm-cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
  <div class="adm-card">
    <div class="adm-card-hd">{copy().recentPosts}<span class="spacer" style="flex:1"></span>
      <a href="/admin/posts" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--adm-muted)">{copy().all}{@html ic("arrow-right", 14)}</a>
    </div>
    <div class="table-responsive">
      <table class="adm-table">
        <thead><tr><th>{copy().title}</th><th>{copy().status}</th><th>{copy().updated}</th></tr></thead>
        <tbody>
          {#each recentPosts() as p}
          <tr>
            <td><a href={"/admin/posts/" + p.id}><div class="title">{short(p.title, 28)}</div></a></td>
            <td><span class={"adm-tag " + p.status}>{statusLabel(p.status)}</span></td>
            <td class="adm-hint">{fmtDate(p.updatedAt)}</td>
          </tr>
          {/each}
        </tbody>
      </table>
    </div>
  </div>
  <div class="adm-card">
    <div class="adm-card-hd">{copy().recentComments}<span class="spacer" style="flex:1"></span>
      <a href="/admin/comments" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--adm-muted)">{copy().all}{@html ic("arrow-right", 14)}</a>
    </div>
    <div class="table-responsive">
      <table class="adm-table">
        <thead><tr><th>{copy().comments}</th><th>{copy().status}</th><th>{copy().time}</th></tr></thead>
        <tbody>
          {#each recentComments() as c}
          <tr>
            <td>
              <div class="title">{short(c.content, 24)}</div>
              <div class="sub">{c.authorName} · {short(c.postTitle, 18)}</div>
            </td>
            <td><span class={"adm-tag " + c.status}>{commentStatusLabel(c.status)}</span></td>
            <td class="adm-hint">{fmtDate(c.createdAt)}</td>
          </tr>
          {/each}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="adm-card" style="margin-top:16px;">
  <div class="adm-card-hd">{copy().api}</div>
  <div class="adm-card-bd">
    <p class="adm-hint" style="margin:0 0 10px">{copy().apiLead}</p>
    <ul class="adm-api-list">
      <li>REST：<code>GET /api/posts?status=published</code></li>
      <li>GraphQL：<code>POST /api/graphql</code>{copy().apiPlayground}</li>
      <li>{copy().apiFeeds}<code>GET /feed.xml</code> · {copy().apiSitemap}<code>GET /sitemap.xml</code></li>
    </ul>
  </div>
</div>