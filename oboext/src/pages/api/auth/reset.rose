<script>
  // POST /api/auth/reset { account, code, password } Password reset step two: the emailed reset code IS the second factor (single use).
  import { jsonOk, jsonFail, readBody, apiGate } from "@server/admin";
  import {
    findUserByAccount,
    resetUserPassword,
    recordLoginEvent,
    LOGIN_EVENTS,
    clientIp,
    clientUa,
  } from "@server/auth";
  import { getAdminSecurity, isEntryReferer } from "@server/security";
  import { verifyCode } from "@server/verify-codes";
  import { passwordError } from "@server/password-policy";
  import { makeT, headerLocale } from "@server/i18n";

  export async function POST(request) {
    const t = makeT(headerLocale(request));
    return apiGate(async () => {
      const body = await readBody(request);
      const account = String(body.account || "").trim();
      const code = String(body.code || "").trim();
      const password = String(body.password || "");
      if (!account || !code || !password) return jsonFail(t("api.reset_required"), 422);

      const sec = await getAdminSecurity();
      if (!isEntryReferer(request, sec)) return jsonFail(t("api.no_entry"), 404);

      const ip = clientIp(request);
      const user = await findUserByAccount(account);
      if (!user?.email) {

        return jsonFail(t("api.reset_wrong"), 401);
      }

      // Context rule (reject a password containing the user's own email/name)
      // must apply here too, exactly like changeOwnPassword - so the check runs
      // AFTER the user is resolved, with { email, name } in hand.
      const pwErr = passwordError(password, { email: user.email, name: user.name });
      if (pwErr) return jsonFail(t(pwErr.key || "api.pw_common", pwErr.params), pwErr.status);

      try {
        await verifyCode({
          channel: "email",
          target: user.email,
          purpose: "reset",
          code,
        });
      } catch {
        return jsonFail(t("api.reset_wrong"), 401);
      }

      await resetUserPassword(user.id, password);
      await recordLoginEvent({
        eventType: LOGIN_EVENTS.RESET_DONE,
        userId: user.id,
        account,
        ip,
        userAgent: clientUa(request),
      });
      return { reset: true };
    }, t);
  }
</script>
