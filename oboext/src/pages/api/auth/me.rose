<script>
  // GET /api/auth/me — the current session user, or { user: null } for
  // guests. The site comment box / OAuth buttons call this unauthenticated
  // to decide which UI to show, so a guest must NOT be a 401.
  import { apiGate } from "@server/admin";

  export async function GET() {
    return apiGate(async () => {
      const user = getContext().user;
      return { user: user ?? null };
    });
  }
</script>
