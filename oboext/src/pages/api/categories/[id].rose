<script>
  // /api/categories/:id — PUT update, DELETE remove (children promoted up).
  import { apiGate, readBody, updateCategory, deleteCategory } from "@server/admin";

  function pathId(request) {
    return Number(new URL(request.url).pathname.split("/").filter(Boolean)[2]);
  }

  export async function PUT(request) {
    return apiGate(async () =>
      updateCategory(getContext().user, pathId(request), await readBody(request)),
    );
  }

  export async function DELETE(request) {
    return apiGate(async () => deleteCategory(getContext().user, pathId(request)));
  }
</script>
