<script>

  //

  import { parse, validate, execute as executeGraphql, specifiedRules } from "graphql";
  import { schema, buildContext } from "@server/graphql";
  import { checkQueryDepth, estimateCost, MAX_COST } from "@server/graphql-guard";

  // GET selects GraphiQL HTML vs JSON on the Accept header; partition the hot
  // cache on it so one representation is never replayed as the other.
  export const hotVary = ["accept"];

  // Same-origin by default.
  function corsOrigin() {
    const raw = process.env.GRAPHQL_ALLOWED_ORIGIN;
    if (!raw) return null;
    const allowed = raw.split(",").map((s) => s.trim()).filter(Boolean);
    return allowed.length ? allowed : null;
  }

  function withCors(origin) {
    const h = { "access-control-allow-methods": "POST, OPTIONS", "access-control-allow-headers": "content-type, authorization" };
    const allow = corsOrigin();
    // Reflect the request origin only when it is on the allowlist.
    if (allow && origin && allow.includes(origin)) {
      h["access-control-allow-origin"] = origin;
      h["vary"] = "origin";
    }
    return h;
  }

  function jsonOut(obj, status, origin) {
    return new Response(JSON.stringify(obj), {
      status: status || 200,
      headers: { "content-type": "application/json; charset=utf-8", ...withCors(origin) },
    });
  }

  // Introspection is how an attacker maps the whole data model in one request.
  // It is a development affordance; on a public endpoint it is reconnaissance.
  function introspectionAllowed() {
    return process.env.NODE_ENV !== "production";
  }

  async function execute(request, payload) {
    const origin = request.headers.get("origin");
    const query = payload.query;
    if (typeof query !== "string" || !query) {
      return jsonOut({ errors: [{ message: "Must provide query string." }] }, 400, origin);
    }

    // Parsed once and reused three times: the guards need the AST, and handing
    // the same document to execute() avoids a second parse of the same text.
    let document;
    try {
      document = parse(query);
    } catch (e) {
      return jsonOut({ errors: [{ message: e instanceof Error ? e.message : "Parse error" }] }, 400, origin);
    }

    // Validation runs before the guards so a malformed query fails on its own terms rather than being reported as "too deep".
    const problems = validate(schema, document, specifiedRules);
    if (problems.length) {
      return jsonOut({ errors: problems.map((p) => ({ message: p.message })) }, 400, origin);
    }

    if (!introspectionAllowed()) {
      for (const def of document.definitions || []) {
        if (def.kind === "OperationDefinition" && def.operation === "query") {
          const names = ((def.selectionSet && def.selectionSet.selections) || []).map((s) => s.name && s.name.value);
          if (names.includes("__schema") || names.includes("__type")) {
            return jsonOut({ errors: [{ message: "Introspection is disabled." }] }, 403, origin);
          }
        }
      }
    }

    // Both guards run on the parsed document, before any resolver fires, so a
    // rejected query costs one parse and no database work at all.
    const tooDeep = checkQueryDepth(document);
    if (tooDeep) return jsonOut({ errors: [{ message: tooDeep }] }, 400, origin);

    const cost = estimateCost(document);
    if (cost > MAX_COST) {
      return jsonOut({ errors: [{ message: "Query is too expensive (estimated " + cost + ", max " + MAX_COST + ")." }] }, 400, origin);
    }

    const contextValue = await buildContext(request);
    const result = await executeGraphql({
      schema,
      document,
      variableValues: payload.variables,
      operationName: payload.operationName,
      contextValue,
    });
    return jsonOut(result, 200, origin);
  }

  function graphiqlHtml() {
    return [
      "<!DOCTYPE html>",
      "<html><head><meta charset=\"utf-8\"><title>GraphiQL</title>",
      "<link rel=\"stylesheet\" href=\"https://unpkg.com/graphiql@3/graphiql.min.css\">",
      "<st" + "yle>body{margin:0}#graphiql{height:100vh}</st" + "yle></head>",
      "<body><div id=\"graphiql\">Loading...</div>",
      "<scr" + "ipt src=\"https://unpkg.com/react@17/umd/react.production.min.js\"><\/script>",
      "<scr" + "ipt src=\"https://unpkg.com/react-dom@17/umd/react-dom.production.min.js\"><\/script>",
      "<scr" + "ipt src=\"https://unpkg.com/graphiql@3/graphiql.min.js\"><\/script>",
      "<scr" + "ipt>",
      "ReactDOM.render(React.createElement(GraphiQL,{fetcher:GraphiQL.createFetcher({url:'/api/graphql'})}),document.getElementById('graphiql'));",
      "<\/script></body></html>",
    ].join("\n");
  }

  export async function GET(request) {
    const url = new URL(request.url);
    const origin = request.headers.get("origin");
    if ((request.headers.get("accept") || "").includes("text/html")) {

      // The playground reveals the entire schema to anyone who asks. It stays a
      // development tool; on a public endpoint it is reconnaissance.
      if (process.env.NODE_ENV === "production") return jsonOut({ errors: [{ message: "Not found" }] }, 404, origin);
      return new Response(graphiqlHtml(), {
        headers: { "content-type": "text/html; charset=utf-8", ...withCors(origin) },
      });
    }
    let variables;
    const rawVars = url.searchParams.get("variables");
    if (rawVars) {
      try {
        variables = JSON.parse(rawVars);
      } catch {
        return jsonOut({ errors: [{ message: "Variables are invalid JSON." }] }, 400, origin);
      }
    }
    return execute(request, {
      query: url.searchParams.get("query"),
      variables,
      operationName: url.searchParams.get("operationName"),
    });
  }

  export async function POST(request) {
    let body;
    try {
      body = await request.json();
    } catch {
      return jsonOut({ errors: [{ message: "POST body sent invalid JSON." }] }, 400, request.headers.get("origin"));
    }
    return execute(request, body);
  }

  // Same-origin by default (see corsOrigin above).
  export async function OPTIONS(request) {
    return new Response(null, { status: 204, headers: withCors(request.headers.get("origin")) });
  }

</script>
