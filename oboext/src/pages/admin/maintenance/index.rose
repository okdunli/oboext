<script>

  let c = $data(() => __rvLoad("admin.maintenance", {}));
  function v(k, dflt) {
    const x = c()[k];
    return x == null || x === "" ? (dflt == null ? "" : dflt) : x;
  }
  function on(k) {
    return c()[k] ? "1" : "0";
  }
  function copy() {
    return c().s || {};
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<form data-adm-form="maintenance">
  <div class="adm-toolbar">
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="adm-ic" style="--i:url(/public/icons/construction.svg);width:20px;height:20px;color:#818cf8;"></span>
      <strong style="font-size:16px">{copy().title}</strong>
    </div>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">{copy().save}</button>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{copy().closeSite}</span><span class="d">{copy().closeHint}</span></span><input type="checkbox" name="enabled" data-on={on('enabled')} data-bool></label>
      <div class="adm-field" data-show-if="enabled=1" hidden style="margin-top:14px;">
        <p class="adm-hint" style="margin:0;color:#fbbf24;">{copy().apisHint}</p>
      </div>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-hd"><strong style="font-size:14px;">{copy().pageTitle}</strong></div>
    <div class="adm-card-bd">
      <div class="adm-field">
        <label>{copy().colTitle}</label>
        <input class="adm-input" name="title" value={v('title', copy().phDefault)} maxlength="120" placeholder={copy().phTitle}>
      </div>
      <div class="adm-field" style="margin-top:12px;">
        <label>{copy().colBody}</label>
        <textarea class="adm-textarea" name="message" rows="5" maxlength="1000" data-dv={v('message')} placeholder={copy().phBody}></textarea>
        <p class="adm-hint" style="margin:6px 0 0;">{copy().bodyHint}</p>
      </div>
    </div>
  </div>
</form>
