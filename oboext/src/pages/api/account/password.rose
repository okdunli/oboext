<script>

  import { jsonFail, readBody, apiGate } from "@server/admin";
  import { changeOwnPassword } from "@server/account";

  export async function POST(request) {
    return apiGate(async () => {
      const me = getContext().user;
      if (!me) return jsonFail("未认证", 401);
      const body = await readBody(request);
      const currentPassword = String(body.currentPassword || "");
      const newPassword = String(body.newPassword || "");
      if (!newPassword) return jsonFail("请输入新密码", 422);
      if (newPassword.length < 8 || newPassword.length > 200) {
        return jsonFail("新密码长度需为 8~200 个字符", 422);
      }
      await changeOwnPassword(me, currentPassword, newPassword);
      return { ok: true };
    });
  }
</script>
