<script>
  // Generic host for plugin-owned admin pages (original parity: app/admin/plugins/[slug]/page.tsx).
  let slug = $state("");
  let d = $data(async () => {
    const v = await __rvLoad("admin.plugin-panel", { slug: slug() });
  function copy() {
    return v.s || {};
  }
    if (!v.plugin) notFound();
    return v;
  });

  function plugin() {
    return d().plugin;
  }
  function panelHtml() {
    return d().html || "";
  }
  function panelScriptSrc() {
    return d().scriptSrc || "";
  }
  function version() {
    const v = plugin().version;
    return v ? "v" + v : "";
  }
</script>

<head>
  <title>{plugin().name} - {copy().adminSuffix}</title>
</head>

<div class="adm-toolbar">
  <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/plugins"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/arrow-left.svg)"></span>{copy().back}</a>
</div>

<div class="adm-card" style="margin-bottom:16px;">
  <div class="adm-card-hd">
    <strong style="font-size:15px;">{plugin().name}</strong>
    <span class="spacer" style="flex:1"></span>
    <span class="adm-tag published">{copy().enabled}</span>
  </div>
  <div class="adm-card-bd">
    <p style="margin:0;font-size:13px;color:var(--adm-muted);line-height:1.6;">{plugin().description}</p>
    <p class="adm-hint" style="margin:6px 0 0;">plugins/{slug()} · {version()}</p>
  </div>
</div>

{#if panelHtml() !== ""}
{@html panelHtml()}
{/if}
{#if panelScriptSrc() !== ""}
{@html '<script src="' + panelScriptSrc() + '" defer></script>'}
{/if}
{#if panelHtml() === ""}
<div class="adm-card">
  <div class="adm-card-bd adm-empty">
    {copy().noPanel}<br>
    <span class="adm-hint">{copy().noPanelHint}</span>
  </div>
</div>
{/if}
