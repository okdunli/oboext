# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Authorizes on-demand ISR revalidation requests (POST /__rosezm/revalidate).
# Generate a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
rosezm_REVALIDATE_TOKEN=

# Signed preview links (?preview=<token>): lifetime in days, 1..365.
# Anything outside the range falls back to 7. Leave unset for the default.
OBOEXT_PREVIEW_TTL_DAYS=7

# Require the builtin arithmetic captcha for guest comments (signed-in staff
# skip it). Off unless set to 1.
OBOEXT_COMMENT_CAPTCHA=

# Guest comment rate limit: at most MAX posts per IP per WINDOW_MIN minutes.
# Staff are exempt. Defaults: 20 / 10.
OBOEXT_COMMENT_RATE_MAX=20
OBOEXT_COMMENT_RATE_WINDOW_MIN=10

# Other operator knobs (all optional; defaults shown):
#   OBOEXT_MEDIA_MAX_BYTES       max upload size in bytes (26214400 = 25MB)
#   OBOEXT_SITEMAP_SLICE         URLs per sitemap shard (10000)
#   OBOEXT_WEBMENTION_RATE_MAX   webmention receives per window (30)
#   OBOEXT_SECURITY_LOG_DAYS     security event retention in days (90)
#   OBOEXT_LOG_LEVEL             debug | info | warn | error (info)
#   OBOEXT_DB_STATS              "1" logs per-request query counts/timings

# ---- database ----
# Default driver is pglite: a self-contained embedded Postgres whose data dir
# lives at ./.data/pglite_live (PGLITE_DATA_DIR overrides). That requires a
# WRITABLE filesystem — fine on a VPS, Docker or `rosezm serve`, fatal on
# Vercel/AWS Lambda where /var/task is read-only. Deploying serverless:
#   DB_DRIVER=postgres
#   DATABASE_URL=postgres://user:pass@host/db
# (a Neon URL also gets a free keepalive ping; POSTGRES_MAX / 8 and
#  POSTGRES_CONNECT_TIMEOUT / 8 tune the pool). The setup wizard and
# /admin/db-config write these into .env for you on a writable host.
DB_DRIVER=
DATABASE_URL=
PGLITE_DATA_DIR=
