<script>

  // /api/comment-captcha GET returns a fresh captcha ({ token, svg }).
  import { createCommentCaptcha } from "@server/comment-captcha";

  const HEADERS = {
    "content-type": "application/json; charset=utf-8",
    "cache-control": "no-store, max-age=0",
  };

  export async function GET() {
    return new Response(JSON.stringify(createCommentCaptcha()), {
      status: 200,
      headers: HEADERS,
    });
  }
</script>