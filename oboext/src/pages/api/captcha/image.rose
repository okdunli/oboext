<script>

  import { apiGate, jsonFail } from "@server/admin";
  import { getAdminSecurity, isEntryReferer } from "@server/security";
  import { getMemberSettings, isRegisterReferer } from "@server/members";
  import { CAPTCHA_COOKIE, captchaSvg, generateCaptchaCode, signCaptchaToken } from "@server/captcha";
  import { makeT, apiLocale } from "@server/i18n";

  // Query-tagged, NOT header-negotiated, and that is not an oversight: this
  // endpoint's only client is an <img src>, and a browser's image request
  // carries no custom header - x-locale never arrives. The query is therefore
  // the only channel that reaches it, and unlike a declared header it is
  // already part of the cache key (relTarget keeps pathname+search). See
  // /api/captcha for the same negotiation over a header, where a declaration
  // does work because that one is fetched from script.
  export async function GET(request) {
    const t = makeT(apiLocale(request));
    return apiGate(async () => {
      const [sec, member] = await Promise.all([getAdminSecurity(), getMemberSettings()]);
      if (!isEntryReferer(request, sec) && !isRegisterReferer(request, member)) {
        return jsonFail(t("api.no_entry"), 404, { "cache-control": "no-store, max-age=0" });
      }
      const builtinWanted =
        sec.captchaMode === "builtin" &&
        (sec.captchaEnabled || (member.registerEnabled && member.captchaEnabled));

      if (!builtinWanted) return jsonFail(t("api.no_entry"), 404, { "cache-control": "no-store, max-age=0" });

      const code = generateCaptchaCode();
      const token = await signCaptchaToken(code);
      return new Response(captchaSvg(code), {
        status: 200,
        headers: {
          "content-type": "image/svg+xml; charset=utf-8",
          "cache-control": "no-store",
          "set-cookie": `${CAPTCHA_COOKIE}=${encodeURIComponent(token)}; HttpOnly; SameSite=Lax; Path=/; Max-Age=600`,
        },
      });
    }, t);
  }
</script>
