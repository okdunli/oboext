<script>
  // /api/tags — GET list, POST create
  import { apiGate, readBody, createTag, bulkDeleteTags } from "@server/admin";
  import { listTags } from "@server/queries";

  export async function GET() {
    return apiGate(async () => listTags());
  }

  export async function POST(request) {
    return apiGate(async () => {
      const row = await createTag(getContext().user, await readBody(request));
      return new Response(JSON.stringify(row), {
        status: 201,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }

  // Bulk delete: { ids: number[] }. Posts lose the deleted tags automatically.
  export async function PATCH(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const ids = Array.isArray(body && body.ids) ? body.ids : [];
      if (ids.length > 500)
        return new Response(JSON.stringify({ error: "批量操作一次最多 500 项" }), {
          status: 422,
          headers: { "content-type": "application/json; charset=utf-8" },
        });
      const res = await bulkDeleteTags(getContext().user, ids);
      return new Response(JSON.stringify(res), {
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }
</script>
