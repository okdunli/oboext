<script>
  // Admin login.
  let card = $data(() => __rvLoad("loginCard", {}));
  let brand = $data(() => __rvLoad("loginBrand", {}));
  function cardHtml() {
    return card().html || "";
  }
  function blogName() {
    return brand().siteTitle || "博客";
  }
  function curYear() {
    return new Date().getFullYear();
  }
</script>

<head>
  <title>登录 - 管理后台</title>
</head>

<div class="adm-auth">
  <div class="adm-auth-side">
    <div class="adm-auth-brand"><span class="adm-auth-mark"><span class="adm-ic adm-ic-lg" style="--i:url(/public/icons/layout-dashboard.svg)"></span></span> Oboext</div>
    <div>
      <h1>{blogName()}</h1>
      <p class="adm-auth-sub">系统管理后台</p>
    </div>
    <div class="adm-hint">© {curYear()} Oboext</div>
  </div>
  <div class="adm-auth-main">
    {@html cardHtml()}
  </div>
</div>
