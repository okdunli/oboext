<script>
  // Isomorphic data endpoint.
  //
  // Server-only module (the compiler excludes pages/api/* from the client
  // bundle), so it is safe to import the live-DB loader layer here. Its
  // module side effect installs the registry the middleware and the pages'
  // server-side __rvLoad shim both use:
  //
  //   globalThis.__oboeLoaders.dispatch(key, payload, ctx)
  //
  // Browser-side __rvLoad() GETs this very endpoint; server-side it calls
  // dispatch() directly. One loader map, per-request database reads.
  import { dispatch, documents, searchRedirect, notFoundDocument } from "@server/loaders";
  import { getPost, getCategoryBySlug, getTagBySlug } from "@server/queries";
  import { ensureMigrations } from "@server/db";

  // Lazy: the framework's build imports dist/server.js for route analysis;
  // touching the DB at module top level would make builds require a DB.
  // The middleware awaits ready() before the first render.
  let readyPromise;
  const ready = () => (readyPromise ||= ensureMigrations().catch((err) => {
    console.error("[oboext] database init failed:", err);
    throw err;
  }));

  // Framework workaround (rosefd 0.1.0, reported upstream): the Node router
  // matches the FULL req.url and answers 404 for any path carrying a query
  // string - /blog?page=2, /search?q=x, even /post?utm=1. The middleware
  // asks this forwarder to RE-ENTER this same server at the bare pathname;
  // the real URL rides back in x-rv-url (the middleware reads it). This is
  // deliberately app-layer only: the framework source is not modified.
  const HOP_REQ = new Set(["host", "connection", "content-length", "accept-encoding", "x-rv-url"]);
  const HOP_RES = new Set(["content-encoding", "content-length", "transfer-encoding", "connection"]);

  async function forward(request) {
    const u = new URL(request.url);
    const bare = u.pathname.length > 1 ? u.pathname.replace(/\/+$/, "") : "/";
    const target = new URL(bare, "http://127.0.0.1:" + (process.env.PORT || "3000"));
    const headers = new Headers();
    request.headers.forEach((v, k) => {
      if (!HOP_REQ.has(k.toLowerCase())) headers.set(k, v);
    });
    headers.set("accept-encoding", "identity");
    headers.set("x-rv-url", u.origin + u.pathname + u.search);
    const init = { method: request.method, headers, redirect: "manual" };
    // page POSTs arrive as form bodies
    if (request.method !== "GET" && request.method !== "HEAD") {
      init.body = await request.formData();
    }
    const res = await fetch(target, init);
    const out = new Headers();
    const cookies = typeof res.headers.getSetCookie === "function" ? res.headers.getSetCookie() : [];
    res.headers.forEach((v, k) => {
      if (k !== "set-cookie" && !HOP_RES.has(k.toLowerCase())) out.set(k, v);
    });
    for (const c of cookies) out.append("set-cookie", c);
    return new Response(res.body, { status: res.status, headers: out });
  }

  globalThis.__oboeLoaders = {
    ready,
    dispatch,
    documents,
    forward: (request) => forward(request).catch((err) => {
      console.error("[oboext] query forward failed:", err);
      return new Response("Bad Gateway", { status: 502, headers: { "content-type": "text/plain; charset=utf-8" } });
    }),
    searchRedirect: async (q) => {
      await ready();
      return searchRedirect(q);
    },
    notFound: async (ctx) => {
      await ready();
      return notFoundDocument(ctx);
    },
    exists: {
      post: async (s) => {
        await ready();
        return Boolean(await getPost(s));
      },
      category: async (s) => {
        await ready();
        return Boolean(await getCategoryBySlug(s));
      },
      tag: async (s) => {
        await ready();
        return Boolean(await getTagBySlug(s));
      },
    },
  };

  export async function GET(request) {
    await ready();
    const u = new URL(request.url);
    const key = u.searchParams.get("r") || "";
    let payload = {};
    try {
      payload = JSON.parse(u.searchParams.get("d") || "{}");
    } catch (e) {}
    const data = await dispatch(key, payload, getContext());
    return new Response(JSON.stringify(data), {
      status: 200,
      headers: {
        "content-type": "application/json; charset=utf-8",
        "cache-control": "no-store",
      },
    });
  }
</script>
