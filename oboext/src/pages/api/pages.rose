<script>
  // /api/pages GET page list (?status=&limit=&offset=).
  import { apiGate, readBody, jsonFail, can, parseBulkAction } from "@server/admin";
  import { adminListPages, listPublishedPages, createPage, bulkPages } from "@server/pages";

  export async function GET(request) {
    return apiGate(async () => {
      const user = getContext().user;
      const q = new URL(request.url).searchParams;
      const status = q.get("status") || undefined;
      const limit = q.get("limit") ? Number(q.get("limit")) : undefined;
      const offset = q.get("offset") ? Number(q.get("offset")) : undefined;
      const sort = q.get("sort") || undefined;
      if (user && can(user.role, "content:read")) {
        return adminListPages(user, { status, limit, offset, sort });
      }
      return listPublishedPages({ limit, offset });
    });
  }

  export async function POST(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const page = await createPage(getContext().user, body);
      return new Response(JSON.stringify(page), {
        status: 201,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }

  // Bulk status/delete. Action is whitelisted (a typo must 422, never silently
  // fall through to "draft"); ids must be a non-empty array of positive ints.
  export async function PATCH(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const action = parseBulkAction(body.action);
      if (!action) return jsonFail("未知的批量操作", 422);
      const ids = Array.isArray(body.ids)
        ? body.ids.map(Number).filter((n) => Number.isInteger(n) && n > 0)
        : [];
      if (!ids.length) return jsonFail("未选择任何项目", 422);
      if (ids.length > 500) return jsonFail("批量操作一次最多 500 项", 422);
      return bulkPages(getContext().user, ids, action);
    });
  }
</script>
