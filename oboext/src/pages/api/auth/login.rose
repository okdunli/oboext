<script>
  // POST /api/auth/login { account, password } Sliding-window throttle (5 fails / 15 min, same account or IP), bcrypt verify.
  import { jsonOk, jsonFail, readBody, apiGate } from "@server/admin";
  import {
    verifyCredentials,
    assertLoginAllowed,
    recordLoginEvent,
    LOGIN_EVENTS,
    signChallengeTicket,
    clientIp,
    clientUa,
    LoginThrottledError,
  } from "@server/auth";
  import { sessionCookiePair, withCookies } from "@server/csrf";
  import { getAdminSecurity, isEntryReferer } from "@server/security";
  import { verifyLoginCaptcha, readCaptchaCookie } from "@server/captcha";
  import { applyAsyncFilters, doAction, HOOKS } from "@server/hooks";
  import { v, parseOrThrow } from "@server/validate";
  import { makeT, headerLocale } from "@server/i18n";

  export async function POST(request) {
    const t = makeT(headerLocale(request));
    return apiGate(async () => {
      const body = await readBody(request);
      const account = String(body.account || "").trim();
      const password = String(body.password || "");
      if (!account || !password) return jsonFail(t("api.login_required"), 422);
      parseOrThrow(
        v.object({
          account: v.string({ max: 120, label: "v.field.account" }),
          password: v.string({ max: 200, trim: false, label: "v.field.password" }),
        }),
        { account, password },
        t,
      );

      const sec = await getAdminSecurity();
      if (!isEntryReferer(request, sec)) return jsonFail(t("api.no_entry"), 404);

      const captchaError = await verifyLoginCaptcha(
        sec,
        body.captcha,
        readCaptchaCookie(request),
        t,
      );
      if (captchaError) return jsonFail(captchaError, 400);

      const ip = clientIp(request);
      const ua = clientUa(request);
      try {
        await assertLoginAllowed(account, ip);
      } catch (e) {
        await recordLoginEvent({ eventType: LOGIN_EVENTS.LOCKED, account, ip, userAgent: ua });
        if (e instanceof LoginThrottledError)
          return jsonFail(t("api.throttled", { n: e.minutes }), 429);
        throw e;
      }

      const user = await verifyCredentials(account, password);
      if (!user) {
        await recordLoginEvent({ eventType: LOGIN_EVENTS.FAIL, account, ip, userAgent: ua });
        return jsonFail(t("api.login_wrong"), 401);
      }

      const challenged = await applyAsyncFilters(HOOKS.authChallenge, {
        user,
        challenge: null,
      });
      if (challenged.challenge) {
        const ticket = await signChallengeTicket(user);
        return {
          twoFactorRequired: true,
          challengeType: challenged.challenge.type,
          ticket,
        };
      }

      await recordLoginEvent({
        eventType: LOGIN_EVENTS.SUCCESS,
        userId: user.id,
        account,
        ip,
        userAgent: ua,
      });
      doAction(HOOKS.userLoggedIn, { user });
      return withCookies(
        new Response(JSON.stringify({ user }), {
          status: 200,
          headers: { "content-type": "application/json; charset=utf-8" },
        }),
        await sessionCookiePair(user),
      );
    }, t);
  }
</script>
