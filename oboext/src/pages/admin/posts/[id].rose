<script>
  // Post editor (new + existing).
  let id = $state("");
  function copy() {
    return (d() && d().s) || {};
  }
  let d = $data(async () => {
    const r = await __rvLoad("admin.post", { id: id() });
    // R228: a dead bookmark answers the admin segment's 404, not a 500.
    if (r.notFound) notFound();
    return r;
  });

  function p() {
    return d().post;
  }
  function isNew() {
    return !d().post;
  }
  function val(f) {
    const x = d().post;
    return x && x[f] != null ? x[f] : "";
  }
  function localTime() {
    const x = d().post;
    if (!x || !x.publishedAt) return "";
    const dt = new Date(x.publishedAt);
    if (Number.isNaN(dt.getTime())) return "";
    const pad = (n) => String(n).padStart(2, "0");
    return (
      dt.getFullYear() + "-" + pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) +
      "T" + pad(dt.getHours()) + ":" + pad(dt.getMinutes())
    );
  }
  function cats() {
    return d().categories || [];
  }
  function tagList() {
    return d().tags || [];
  }
  function authors() {
    return d().authors || [];
  }
  function hasAuthors() {
    return authors().length > 0;
  }
  function isLive() {
    const x = d().post;
    return !!x && x.status === "published";
  }
  function postUrl() {
    const x = d().post;
    return x ? x.url || "/blog/" + x.slug : "#";
  }
  function formatDefs() {
    return d().formats || [];
  }

  // {copy().sources30d}摘要（R256，loader 返回 {kind,views,uniques} 按 views 降序）。
  // 空数组 = 这篇近 30 天没有可统计的落地访问，整块不渲染而不是画零。
  function postSources() {
    return (d().postSources || []).map(function (r) {
      return {
        label: r.kind === "search" ? copy().srcSearch
          : r.kind === "social" ? copy().srcSocial
          : r.kind === "internal" ? copy().srcInternal
          : r.kind === "direct" ? copy().srcDirect
          : copy().srcOther,
        views: Number(r.views) || 0,
        uniques: Number(r.uniques) || 0,
      };
    });
  }

  function curFormat() {
    const v = d().post ? d().post.format : "";
    const list = formatDefs();
    return (
      list.find((f) => f.value === v) ||
      list.find((f) => f.value === "standard") ||
      list[0] || { value: "standard", label: copy().standard, icon: "file-text", description: "" }
    );
  }
  function fmVal(key) {
    const m = d().post ? d().post.formatMeta : null;
    return m && m[key] != null ? m[key] : "";
  }
  function cardThemeVal() {
    return fmVal("card_color");
  }
  function swatches() {
    return [
      "#3b6ea5", "#5f7ad1", "#e0853b", "#7a5fa8", "#3aa37f",
      "#b5548f", "#c75f5f", "#58595b", "#2d8f9e", "#6f8f3a",
    ];
  }
  function deleteUrl() {
    const x = d().post;
    return x ? "/api/posts/" + x.id : "";
  }
  // Newsletter manual fanout: only for a post that is (already) published.
  function canFanout() {
    return isLive() && !isNew();
  }
  function fanoutPostId() {
    const x = d().post;
    return x ? String(x.id) : "";
  }
  function postDataAttr() {
    return JSON.stringify(d());
  }
  if (typeof document !== "undefined") {
    // Newsletter manual fanout button: confirm -> POST /api/newsletter/send ->
    // toast the claimed count. The endpoint returns immediately (SMTP is
    // fire-and-forget server-side); queued = newly claimed (post, subscriber)
    // pairs, 0 = already sent or no confirmed subscriber.
    const nlBtn = document.querySelector("[data-adm-newsletter-send]");
    if (nlBtn) {
      nlBtn.addEventListener("click", async () => {
        const postId = nlBtn.getAttribute("data-post-id") || "";
        if (!postId) return;
        if (!confirm(copy().confirmBroadcast)) return;
        nlBtn.disabled = true;
        try {
          const r = await fetch("/api/newsletter/send", {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ postId: Number(postId) }),
          });
          const data = r.ok ? await r.json() : null;
          if (!r.ok || !data || data.ok !== true) {
            throw new Error((data && data.error) || copy().broadcastFailed + r.status + "）");
          }
          const n = Number(data.queued) || 0;
          if (typeof window.admToast === "function") {
            window.admToast(n > 0 ? copy().broadcastQueued + n + copy().broadcastDone : copy().broadcastNoNew, n > 0 ? "ok" : "err");
          }
        } catch (e) {
          if (typeof window.admToast === "function") {
            window.admToast(e instanceof Error ? e.message : copy().broadcastFailed2, "err");
          }
        } finally {
          nlBtn.disabled = false;
        }
      });
    }
  }
  if (typeof document !== "undefined") {
    const revBox = document.querySelector('[data-adm-revisions="post"]');
    if (revBox) {
      const targetId = Number(revBox.getAttribute("data-adm-rev-id"));
      const list = revBox.querySelector("[data-adm-rev-list]");
      let before = null;
      const fmt = (iso) => {
        const dt = new Date(iso);
        if (Number.isNaN(dt.getTime())) return "";
        const pad = (n) => String(n).padStart(2, "0");
        return pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) + " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes());
      };
      const statusLabel = (s) => (s === "published" ? copy().statusPublished : s === "draft" ? copy().statusDraft : s === "archived" ? copy().statusArchived : s);
      async function load() {
        const qs = new URLSearchParams({ kind: "post", targetId: String(targetId) });
        if (before) qs.set("before", String(before));
        const r = await fetch("/api/revisions?" + qs.toString(), { credentials: "same-origin" });
        if (!r.ok) {
          list.innerHTML = '<div class="adm-hint">' + copy().historyLoadFailed + r.status + "）</div>";
          return;
        }
        const data = await r.json();
        if (!data.items.length && !list.querySelector(".adm-rev-row")) {
          list.innerHTML = '<div class="adm-hint">' + copy().noHistory + '</div>';
          return;
        }
        for (const it of data.items) {
          const row = document.createElement("div");
          row.className = "adm-rev-row";
          const time = document.createElement("span");
          time.className = "adm-rev-time";
          time.textContent = fmt(it.createdAt);
          const title = document.createElement("span");
          title.className = "adm-rev-title";
          title.textContent = it.title || copy().untitled;
          const st = document.createElement("span");
          st.className = "adm-rev-status";
          st.textContent = statusLabel(it.status);
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "adm-btn adm-btn-ghost adm-btn-sm";
          btn.textContent = copy().rollbackTo;
          btn.addEventListener("click", async () => {
            if (!confirm(copy().rollbackToNamed + (it.title || copy().untitled2) + "」（" + fmt(it.createdAt) + copy().rollbackNote)) return;
            btn.disabled = true;
            const pr = await fetch("/api/revisions", {
              method: "POST",
              credentials: "same-origin",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ kind: "post", targetId, revisionId: it.id }),
            });
            if (!pr.ok) {
              alert(copy().rollbackFailed + (await pr.text()).slice(0, 160));
              btn.disabled = false;
              return;
            }
            location.reload();
          });
          row.appendChild(time);
          row.appendChild(title);
          row.appendChild(st);
          row.appendChild(btn);
          list.appendChild(row);
        }
        before = data.nextBefore;
        if (before) {
          const more = document.createElement("button");
          more.type = "button";
          more.className = "adm-btn adm-btn-sm";
          more.textContent = copy().loadEarlier;
          more.addEventListener("click", () => {
            more.remove();
            load();
          });
          list.appendChild(more);
        }
      }
      load();
    }
  }
  if (typeof document !== "undefined") {
    // Server auto-draft channel (api/autodraft): 10s debounced POST while
    // writing + a restore hint when the stored draft is newer than what the
    // editor loaded. Failures are silent — never interrupt writing.
    const adm = location.pathname.match(/^\/admin\/(posts|pages)\/(new|\d+)/);
    if (adm) {
      const adKey = adm[1] + ":" + adm[2];
      // djb2 over key-sorted JSON: same content hashes equal regardless of
      // object key order (JSON.stringify compare was key-order sensitive).
      function adHash(v) {
        const cj = (x) => Array.isArray(x) ? "[" + x.map(cj).join(",") + "]"
          : (x && typeof x === "object") ? "{" + Object.keys(x).sort().map((k) => JSON.stringify(k) + ":" + cj(x[k])).join(",") + "}"
          : JSON.stringify(x) ?? "null";
        let h = 5381;
        const s = cj(v);
        for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0;
        return (h >>> 0).toString(16);
      }
      let adEd = null;
      let adTimer = null;
      function adCapture() {
        if (!adEd || typeof adEd.payload !== "function") return;
        try {
          const titleEl = adEd.root.querySelector("[name=title]");
          const title = titleEl ? String(titleEl.value || "") : "";
          const blocks = Array.isArray(adEd.blocks) ? adEd.blocks : [];
          if (!title.trim() && !blocks.length) return;
          fetch("/api/autodraft", {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ key: adKey, title, content: JSON.stringify(blocks) }),
          }).catch(() => {});
        } catch {}
      }
      function adBoot(tries) {
        adEd = window.__admEditor;
        if (!adEd || typeof adEd.payload !== "function") {
          if (tries < 100) setTimeout(() => adBoot(tries + 1), 50);
          return;
        }
        const arm = () => {
          clearTimeout(adTimer);
          adTimer = setTimeout(adCapture, 10000);
        };
        adEd.root.addEventListener("input", arm);
        adEd.root.addEventListener("change", arm);
        fetch("/api/autodraft?key=" + encodeURIComponent(adKey), { credentials: "same-origin" })
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            const draft = data && data.draft;
            if (!draft || typeof draft.content !== "string" || !draft.content) return;
            let blocks = null;
            try { blocks = JSON.parse(draft.content); } catch { return; }
            if (!Array.isArray(blocks)) return;
            const title = String(draft.title || "").trim();
            if (!blocks.length && !title) return;
            const cur = Array.isArray(adEd.blocks) ? adEd.blocks : [];
            if (adHash(blocks) === adHash(cur)) return;
            if (adEd.entity && adEd.entity.updatedAt && String(draft.updatedAt || "") <= String(adEd.entity.updatedAt)) return;
            const form = document.querySelector("[data-adm-editor]");
            if (!form || form.querySelector(".adm-autodraft-banner")) return;
            const bar = document.createElement("div");
            bar.className = "adm-autodraft-banner";
            bar.setAttribute("role", "status");
            bar.style.cssText = "display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 14px;margin:0 0 14px;border:1px solid #ecd9a8;border-radius:10px;background:#fff9e8;color:#6b5410;font-size:13px";
            const msg = document.createElement("span");
            const dt = draft.updatedAt ? new Date(draft.updatedAt) : null;
            const pad = (n) => String(n).padStart(2, "0");
            const when = dt && !isNaN(dt.getTime())
              ? pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) + " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes())
              : "";
            msg.textContent = copy().serverDraftFound + (when ? "（" + when + copy().draftSavedAgo : "") + copy().draftNewer;
            const sp = document.createElement("span");
            sp.style.cssText = "flex:1";
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "adm-btn adm-btn-sm";
            btn.textContent = copy().restoreDraft;
            const drop = document.createElement("button");
            drop.type = "button";
            drop.className = "adm-btn adm-btn-ghost adm-btn-sm";
            drop.textContent = copy().ignore;
            const dismiss = () => { if (bar.parentNode) bar.parentNode.removeChild(bar); };
            btn.addEventListener("click", () => {
              try {
                const titleEl = adEd.root.querySelector("[name=title]");
                if (titleEl && draft.title != null) titleEl.value = String(draft.title);
                adEd.blocks = blocks;
                if (typeof adEd.render === "function") adEd.render();
                if (typeof window.admToast === "function") window.admToast(copy().draftRestored, "ok");
              } catch (e) {
                if (typeof window.admToast === "function") window.admToast(copy().restoreFailed, "err");
              }
              dismiss();
            });
            drop.addEventListener("click", dismiss);
            bar.appendChild(msg);
            bar.appendChild(sp);
            bar.appendChild(btn);
            bar.appendChild(drop);
            form.insertBefore(bar, form.firstChild);
          })
          .catch(() => {});
      }
      adBoot(0);
    }
  }

  // R408: copy a shareable preview link for this (possibly unpublished) post.
  // The server mints the token; the button only carries the id.
  // Guarded: the compiler also evaluates this module on the server to
  // collect state, where `document` does not exist.
  if (typeof document !== "undefined") document.addEventListener("click", async (e) => {
    const btn = e.target instanceof Element ? e.target.closest("[data-adm-preview-link]") : null;
    if (!btn) return;
    const pid = btn.getAttribute("data-adm-preview-link");
    if (!pid) return;
    try {
      const kind = btn.getAttribute("data-adm-preview-kind") || "post";
      const r = await fetch("/api/preview-link?kind=" + kind + "&id=" + encodeURIComponent(pid), { credentials: "same-origin" });
      const data = await r.json().catch(() => ({}));
      if (!r.ok || !data.url) throw new Error(data.error || copy().generateFailed);
      const abs = new URL(data.url, location.origin).href;
      if (navigator.clipboard && navigator.clipboard.writeText) await navigator.clipboard.writeText(abs);
      else window.prompt(copy().copyPreview, abs);
      const exp = Date.parse(data.expiresAt);
      const days = Number.isFinite(exp) ? Math.max(1, Math.round((exp - Date.now()) / 86400000)) : 7;
      if (typeof window.admToast === "function") window.admToast(copy().previewCopied + days + copy().previewValid, "ok");
    } catch (err) {
      if (typeof window.admToast === "function") window.admToast(err instanceof Error ? err.message : copy().generateFailed, "err");
    }
  });
</script>

<head>
  <title>{copy().editPostTitle}</title>
</head>

<form data-adm-editor data-adm-form="post" data-post={postDataAttr()}>
  <div class="adm-toolbar">
    <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/posts"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/arrow-left.svg)"></span>{copy().backToPosts}</a>
    <span style="flex:1"></span>
    {#if isLive()}
    <a class="adm-btn adm-btn-ghost adm-btn-sm" href={postUrl()} target="_blank">{copy().viewPost}<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span></a>
    {/if}
    {#if !isNew()}
    <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-preview-link={p().id} data-adm-preview-kind="post">{copy().previewLink}</button>
    <button
      type="button"
      class="adm-btn adm-btn-danger adm-btn-sm"
      data-adm-act="delete"
      data-url={deleteUrl()}
      data-confirm={copy().confirmDelete}
    >{copy().genericDelete}</button>
    {/if}
    {#if canFanout()}
    <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-newsletter-send data-post-id={fanoutPostId()}>{copy().newsletterSend}</button>
    {/if}
    <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm" data-save-as="draft">{copy().saveDraft}</button>
    <button type="submit" class="adm-btn adm-btn-sm" data-save-as="">{copy().genericSave}</button>
    <button type="submit" class="adm-btn adm-btn-green adm-btn-sm" data-save-as="published">{copy().publish}</button>
  </div>

  <div class="adm-grid adm-cols-editor">
    <div>
      <div class="adm-card">
        <div class="adm-card-bd">
          <input
            class="adm-input adm-title-input"
            name="title"
            placeholder={copy().titlePhFull}
            value={val('title')}
          >
          <div class="adm-permalink">
            <span>{copy().permalink}</span>
            <input name="slug" placeholder={copy().slugPhFull} value={val('slug')}>
          </div>
          <!-- textarea is a raw-text element: template comment markers would
               leak into its value, so the excerpt rides a data attribute and
               admin.js copies it into .value at init -->
          <textarea
            class="adm-textarea"
            name="excerpt"
            rows="2"
            placeholder="{copy().excerptPlaceholder}"
            data-dv={val('excerpt')}
          ></textarea>
        </div>
      </div>

      <div class="adm-card" style="margin-top:16px">
        <div class="adm-card-bd">
          <div class="adm-card-hd" style="padding:0 0 12px;border-bottom:none">
            <strong>{copy().bodyBlocks}</strong>
            <span class="spacer"></span>
            <span class="adm-hint">{copy().blocksHint}</span>
          </div>
          <div class="adm-blocks"></div>
          <div class="adm-block-add">
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="paragraph"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/pilcrow.svg)"></span>{copy().blockParagraph}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="heading"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/heading.svg)"></span>{copy().blockHeading}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="image"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/image.svg)"></span>{copy().blockImage}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="quote"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/quote.svg)"></span>{copy().blockQuote}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="code"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/code.svg)"></span>{copy().blockCode}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="list"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/list.svg)"></span>{copy().blockList}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="divider"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/minus.svg)"></span>{copy().blockDivider}</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="html"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/code-xml.svg)"></span>HTML</button>
          </div>
        </div>
      </div>
    </div>

    <div class="adm-side-sticky">
      <div class="adm-card">
        <div class="adm-card-hd"><strong>{copy().publish}</strong></div>
        <div class="adm-card-bd">
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().status}</span>
            <select class="adm-select" name="status">
              <option value="draft">{copy().statusDraft}</option>
              <option value="published">已{copy().publish}</option>
              <option value="archived">{copy().statusArchived}</option>
            </select>
          </div>
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().publish}时间</span>
            <input class="adm-input" type="datetime-local" name="publishedAt" value={localTime()}>
            <div class="adm-hint" style="margin-top:4px">草稿设为未来时间即定时{copy().publish}，到点自动上线；留空按保存时间。</div>
          </div>
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().comments}</span>
            <select class="adm-select" name="commentStatus">
              <option value="open">开放{copy().comments}</option>
              <option value="closed">关闭{copy().comments}</option>
            </select>
          </div>
          {#if hasAuthors()}
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().author}</span>
            <select class="adm-select" name="authorId">
              <option value="">{copy().authorSelf}</option>
              {#each authors() as a}
              <option value={a.id}>{a.name}</option>
              {/each}
            </select>
          </div>
          {/if}
          <div class="adm-field" style="margin-bottom:0">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().featuredImageUrl}</span>
            <input class="adm-input" name="featuredImage" placeholder="https://…" value={val('featuredImage')}>
          </div>

          <div class="adm-field" style="margin-top:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().postFormat}</span>
            <select class="adm-select" name="format">
              {#each formatDefs() as f}
              <option value={f.value}>{f.label}</option>
              {/each}
            </select>
            <div class="adm-hint" style="margin-top:4px" data-adm-format-desc>{curFormat().description}</div>
          </div>
          <div data-adm-format-fields>
            {#each curFormat().extraFields || [] as field}
            <div class="adm-field" style="margin-top:10px">
              <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{field.label}</span>
              {#if field.type === "textarea"}
              <textarea class="adm-textarea" rows="2" data-fm={field.key} placeholder={field.placeholder || ""} data-dv={fmVal(field.key)}></textarea>
              {/if}
              {#if field.type !== "textarea"}
              <input class="adm-input" type={field.type === "url" ? "url" : "text"} data-fm={field.key} placeholder={field.placeholder || ""} value={fmVal(field.key)}>
              {/if}
            </div>
            {/each}
          </div>
          <div class="adm-field" style="margin-top:12px" data-cardtheme>
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">{copy().cardColor}</span>
            <div style="display:flex;flex-wrap:wrap;gap:6px" data-ctheme-dots>
              {#each swatches() as c}
              <button type="button" class="adm-ctheme-dot" style={"background:" + c} data-ctheme-dot={c} title={c} aria-label={"选择 " + c}></button>
              {/each}
            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
              <span class="adm-ctheme-chip" data-ctheme-chip></span>
              <input class="adm-input" data-ctheme-input placeholder="#rrggbb" style="max-width:120px" value={cardThemeVal()}>
              <button type="button" class="adm-btn adm-btn-sm" data-ctheme-apply>{copy().apply}</button>
              <button type="button" class="adm-btn adm-btn-sm" data-ctheme-detect>{copy().detectFromImage}</button>
              <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-ctheme-clear hidden>{copy().clear}</button>
            </div>
            <div class="adm-hint" style="margin-top:4px">
              <span data-ctheme-msg></span>
              <span data-ctheme-note>{copy().cardColorHint}</span>
            </div>
          </div>
          <div class="adm-switch" style="margin-top:10px">
            <div>
              <div class="t">{copy().pinned}</div>
              <div class="d">固定在{copy().backToPosts}顶部</div>
            </div>
            <input type="checkbox" name="pinned" data-bool>
          </div>
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>{copy().categories}</strong></div>
        <div class="adm-card-bd">
          <div class="adm-checklist">
            {#each cats() as c}
            <label><input type="checkbox" name="categoryIds[]" value={c.id}> {c.name}</label>
            {/each}
          </div>
          <div class="adm-hint" style="margin-top:8px">没有合适的{copy().categories}？先去「{copy().categories}」页面创建。</div>
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>{copy().tags}</strong></div>
        <div class="adm-card-bd">
          <div class="adm-checklist">
            {#each tagList() as t}
            <label><input type="checkbox" name="tagIds[]" value={t.id}> {t.name}</label>
            {/each}
          </div>
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>{copy().translation}</strong></div>
        <div class="adm-card-bd">
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <select class="adm-input" name="locale" style="width:auto">
              <option value="zh-CN" selected={val('locale') !== 'en'}>{copy().langZh}</option>
              <option value="en" selected={val('locale') === 'en'}>{copy().langEn}</option>
            </select>
            <input
              class="adm-input"
              name="translationOf"
              type="number"
              min="1"
              data-num
              style="width:140px"
              placeholder="{copy().translationIdPh}"
              value={val('translationOf') || ""}
            >
            {#if d().translationOriginal}
            <a href={d().translationOriginal.editHref} style="font-size:12px;color:var(--muted)">
              ↳ {d().translationOriginal.title}
            </a>
            {/if}
          </div>
          <div class="adm-hint" style="margin-top:8px">
            英文译文可填写它翻译的中文文章 ID；中文原文留空。两篇将互为翻译对（{copy().publish}语义在后续版本接入 SEO 输出）。
          </div>
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>SEO</strong></div>
        <div class="adm-card-bd">
          <input class="adm-input" name="seoTitle" placeholder="SEO {copy().blockHeading}" value={val('seoTitle')} style="margin-bottom:10px">
          <textarea
            class="adm-textarea"
            name="seoDescription"
            rows="2"
            placeholder="{copy().seoDesc}"
            data-dv={val('seoDescription')}
          ></textarea>
          <input class="adm-input" name="seoKeywords" placeholder="{copy().seoKeywords}" value={val('seoKeywords')} style="margin-top:10px">
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>{copy().customFields}</strong></div>
        <div class="adm-card-bd">
          <div class="adm-metas" data-adm-metas></div>
          <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-meta" style="margin-top:8px"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/plus.svg)"></span>{copy().addField}</button>
          <div class="adm-hint" style="margin-top:8px">{copy().kvForThemes}</div>
        </div>
      </div>
    </div>
  </div>
</form>

{#if !isNew()}
<div class="adm-card" style="margin-top:16px" data-adm-revisions="post" data-adm-rev-id={p().id}>
  <div class="adm-card-hd"><strong>{copy().revisions}</strong><span class="adm-hint" style="margin-left:auto">{copy().revisionsHint}</span></div>
  <div class="adm-card-bd">
    <div class="adm-rev-list" data-adm-rev-list></div>
  </div>
</div>
{/if}

{#if !isNew() && postSources().length > 0}
<div class="adm-card" style="margin-top:16px">
  <div class="adm-card-hd"><strong>{copy().sources30d}</strong><span class="adm-hint" style="margin-left:auto">{copy().sourcesHint}</span></div>
  <div class="adm-card-bd">
    {#each postSources() as r}
    <div class="adm-hint" style="margin-bottom:4px">{r.label}：{r.views} 访次 / {r.uniques} 访客</div>
    {/each}
  </div>
</div>
{/if}
