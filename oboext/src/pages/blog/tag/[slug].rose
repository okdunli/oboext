<script>
  // Tag archive. Missing tags are real 404s on cold GETs (middleware
  // existence check); there is no client-side router.
  let slug = $state("");
  let list = $data(() =>
    __rvLoad("tag", {
      slug: slug(),
      page: Number(__rvQs().get("page") || 1),
    })
  );
</script>

<head>
  <title>{list().headTitle}</title>
</head>

{list().main}
