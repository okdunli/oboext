<script>
  // Site settings — the whole form is generated from SITE_SETTINGS_SCHEMA by
  // admin.js sfForm (the same engine the theme panel and plugin settings use),

  // picker and the webmaster-verification inputs all come for free. The
  // payload (resolved values + schema with runtime options injected) is
  // embedded; saving is one PATCH /api/settings.
  let p = $data(() => __rvLoad("admin.settings", {}));
  function payload() {
    return JSON.stringify({ settings: p().settings, schema: p().schema });
  }
</script>

<head>
  <title>站点设置 - 管理后台</title>
</head>

<div class="adm-thp" data-set-panel data-set-panel-data={payload()}>
  <div class="adm-thp-head">
    <div>
      <h1 class="adm-h1">站点设置</h1>
      <p class="adm-thp-desc">站点身份、阅读、SEO、评论与代码注入。保存后立即生效。</p>
    </div>
    <div class="adm-thp-headbtns">
      <button type="button" class="adm-btn" data-set-save>
        <span data-set-save-label>保存设置</span>
      </button>
    </div>
  </div>

  <div class="adm-thp-msg" data-set-msg></div>

  <div class="adm-thp-grid">
    <nav class="adm-thp-nav">
      <div class="adm-thp-navgroup" data-set-nav-group>
        <div class="adm-thp-navlist" data-set-nav></div>
      </div>
    </nav>

    <div class="adm-thp-body" data-set-body></div>
  </div>
</div>