<script>
  // /api/posts GET public post list (?status=&authorId=&categoryId=&tagId=&search= &limit=&offset=).
  import {
    apiGate,
    readBody,
    jsonFail,
    createPost,
    bulkPosts,
    parseBulkAction,
  } from "@server/admin";
  import { listPosts } from "@server/queries";

  export async function GET(request) {
    return apiGate(async () => {
      const user = getContext().user;
      const q = new URL(request.url).searchParams;
      // Guests are pinned to published, exactly like the original GET.
      const status = user ? q.get("status") || undefined : "published";
      return listPosts({
        status,
        authorId: q.get("authorId") ? Number(q.get("authorId")) : undefined,
        categoryId: q.get("categoryId") ? Number(q.get("categoryId")) : undefined,
        tagId: q.get("tagId") ? Number(q.get("tagId")) : undefined,
        search: q.get("search")?.trim() || undefined,
        limit: q.get("limit") ? Number(q.get("limit")) : 20,
        offset: q.get("offset") ? Number(q.get("offset")) : 0,
      });
    });
  }

  export async function POST(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const post = await createPost(getContext().user, body);
      return new Response(JSON.stringify(post), {
        status: 201,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }

  export async function PATCH(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const action = parseBulkAction(body.action);
      if (!action) return jsonFail("未知的批量操作", 422);
      const ids = Array.isArray(body.ids)
        ? body.ids.map(Number).filter((n) => Number.isInteger(n) && n > 0)
        : [];
      if (!ids.length) return jsonFail("未选择任何项目", 422);
      return bulkPosts(getContext().user, ids, action);
    });
  }
</script>
