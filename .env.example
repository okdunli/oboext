# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Authorizes on-demand ISR revalidation requests (POST /__rosezm/revalidate).
# Generate a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
rosezm_REVALIDATE_TOKEN=

# Signed preview links (?preview=<token>): lifetime in days, 1..365.
# Anything outside the range falls back to 7. Leave unset for the default.
OBOEXT_PREVIEW_TTL_DAYS=7
