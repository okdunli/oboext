<script>
  // Dashboard — counters, post status distribution, recent activity, API entry.
  let st = $data(() => __rvLoad("admin.dashboard", {}));
  // Accessors, never eager top-level reads: the compiler initializes $data
  // state after the script body (0.2.4), so reading st() here is a TDZ error.
  function counts() {
    return st().counts;
  }
  function postStatus() {
    return st().postStatus;
  }
  // NB: {#each} compiles its expression as a zero-arg call — arrays exposed to
  // the template must ride function accessors.
  function recentPosts() {
    return st().recentPosts;
  }
  function recentComments() {
    return st().recentComments;
  }
  // Stat cards pushed by plugins through the dashboard.cards filter hook.
  function pluginCards() {
    return st().cards || [];
  }
  function linkedCards() {
    return pluginCards().filter(function (c) { return !!c.href; });
  }
  function plainCards() {
    return pluginCards().filter(function (c) { return !c.href; });
  }
  function fmtDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") +
      "-" + String(d.getDate()).padStart(2, "0") + " " +
      String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
  }
  function statusLabel(s) {
    return s === "published" ? "已发布" : s === "draft" ? "草稿" : "已归档";
  }
  function commentStatusLabel(s) {
    return s === "published" ? "已通过" : s === "pending" ? "待审核" : "垃圾";
  }
  function short(t, n) {
    t = String(t || "");
    return t.length > n ? t.slice(0, n) + "…" : t;
  }
  function ic(n, size) {
    size = size || 16;
    return '<span class="adm-ic" aria-hidden="true" style="width:' + size +
      "px;height:" + size + "px;--i:url(/public/icons/" + n + ".svg)\"></span>";
  }
</script>

<head>
  <title>仪表盘 - 管理后台</title>
</head>

<div class="adm-grid adm-stats">
  <a class="adm-card adm-stat" href="/admin/posts"><div class="k">{@html ic("file-text")} 文章</div><div class="v">{counts().posts}</div></a>
  <a class="adm-card adm-stat" href="/admin/pages"><div class="k">{@html ic("file")} 页面</div><div class="v">{counts().pages}</div></a>
  <a class="adm-card adm-stat" href="/admin/comments"><div class="k">{@html ic("message-square")} 评论</div><div class="v">{counts().comments}</div>{#if counts().commentsPending > 0}<div class="sub">{counts().commentsPending} 条待审</div>{/if}</a>
  <a class="adm-card adm-stat" href="/admin/media"><div class="k">{@html ic("image")} 媒体</div><div class="v">{counts().media}</div></a>
  <a class="adm-card adm-stat" href="/admin/categories"><div class="k">{@html ic("folder")} 分类</div><div class="v">{counts().categories}</div></a>
  <a class="adm-card adm-stat" href="/admin/tags"><div class="k">{@html ic("tags")} 标签</div><div class="v">{counts().tags}</div></a>
  <a class="adm-card adm-stat" href="/admin/users"><div class="k">{@html ic("users")} 用户</div><div class="v">{counts().users}</div></a>
</div>

{#if linkedCards().length > 0}
<div class="adm-grid adm-stats">
  {#each linkedCards() as c}
  <a class="adm-card adm-stat" href={c.href}><div class="k">{c.label}</div><div class="v">{c.value}</div>{#if c.sub}<div class="sub">{c.sub}</div>{/if}</a>
  {/each}
</div>
{/if}

{#if plainCards().length > 0}
<div class="adm-grid adm-stats">
  {#each plainCards() as c}
  <div class="adm-card adm-stat"><div class="k">{c.label}</div><div class="v">{c.value}</div>{#if c.sub}<div class="sub">{c.sub}</div>{/if}</div>
  {/each}
</div>
{/if}

<div class="adm-grid adm-cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
  <div class="adm-card">
    <div class="adm-card-hd">文章状态分布
      <span class="spacer" style="flex:1"></span>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/posts/new">写文章</a>
    </div>
    <div class="adm-card-bd">
      <div class="adm-kv">
        <span class="k">已发布</span><b>{postStatus().published}</b>
        <span class="k">草稿</span><b>{postStatus().draft}</b>
        <span class="k">已归档</span><b>{postStatus().archived}</b>
      </div>
    </div>
  </div>
  <div class="adm-card">
    <div class="adm-card-hd">快捷操作</div>
    <div class="adm-card-bd" style="display:flex;flex-wrap:wrap;gap:8px;">
      <a class="adm-btn adm-btn-sm" href="/admin/posts/new">新建文章</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/comments">审核评论</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/categories">管理分类</a>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/settings">站点设置</a>
    </div>
  </div>
</div>

<div class="adm-grid adm-cols-2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
  <div class="adm-card">
    <div class="adm-card-hd">最近文章<span class="spacer" style="flex:1"></span>
      <a href="/admin/posts" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--adm-muted)">全部{@html ic("arrow-right", 14)}</a>
    </div>
    <div class="table-responsive">
      <table class="adm-table">
        <thead><tr><th>标题</th><th>状态</th><th>更新时间</th></tr></thead>
        <tbody>
          {#each recentPosts() as p}
          <tr>
            <td><a href={"/admin/posts/" + p.id}><div class="title">{short(p.title, 28)}</div></a></td>
            <td><span class={"adm-tag " + p.status}>{statusLabel(p.status)}</span></td>
            <td class="adm-hint">{fmtDate(p.updatedAt)}</td>
          </tr>
          {/each}
        </tbody>
      </table>
    </div>
  </div>
  <div class="adm-card">
    <div class="adm-card-hd">最近评论<span class="spacer" style="flex:1"></span>
      <a href="/admin/comments" style="display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--adm-muted)">全部{@html ic("arrow-right", 14)}</a>
    </div>
    <div class="table-responsive">
      <table class="adm-table">
        <thead><tr><th>评论</th><th>状态</th><th>时间</th></tr></thead>
        <tbody>
          {#each recentComments() as c}
          <tr>
            <td>
              <div class="title">{short(c.content, 24)}</div>
              <div class="sub">{c.authorName} · {short(c.postTitle, 18)}</div>
            </td>
            <td><span class={"adm-tag " + c.status}>{commentStatusLabel(c.status)}</span></td>
            <td class="adm-hint">{fmtDate(c.createdAt)}</td>
          </tr>
          {/each}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="adm-card" style="margin-top:16px;">
  <div class="adm-card-hd">API 接入</div>
  <div class="adm-card-bd">
    <p class="adm-hint" style="margin:0 0 10px">本系统提供 REST 与 GraphQL 两种接口：</p>
    <ul class="adm-api-list">
      <li>REST：<code>GET /api/posts?status=published</code></li>
      <li>GraphQL：<code>POST /api/graphql</code>（浏览器访问可打开 Playground）</li>
      <li>订阅源：<code>GET /feed.xml</code> · 站点地图：<code>GET /sitemap.xml</code></li>
    </ul>
  </div>
</div>