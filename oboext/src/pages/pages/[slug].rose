<script>
  // Static page detail (/pages/:slug by default permalink config). The
  // [slug] segment arrives pre-seeded as state; the "page" loader reads the
  // live database per request (blocks, comments, recent posts). Cold GETs
  // for a missing slug get a real 404 from the middleware pre-check; an
  // in-SPA hop to a deleted slug reloads so the server can answer 404.
  let slug = $state("");
  let page = $data(() => __rvLoad("page", { slug: slug() }));

  onMount(() => {
    if (page() && page().notFound) window.location.reload();
  });
</script>

<head>
  {page().head}
</head>

{page().main}
