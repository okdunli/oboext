<script>
  // POST /api/auth/login-2fa { ticket, code } Login step two: redeem the 10-minute challenge ticket issued by /api/auth/login (or login-code)
  import { jsonOk, jsonFail, readBody, apiGate } from "@server/admin";
  import {
    verifyChallengeTicket,
    recordLoginEvent,
    LOGIN_EVENTS,
    clientIp,
    clientUa,
  } from "@server/auth";
  import { sessionCookiePair } from "@server/csrf";
  import { applyAsyncFilters, doAction, HOOKS } from "@server/hooks";
  import { getAdminSecurity, isEntryReferer } from "@server/security";
  import { makeT, headerLocale } from "@server/i18n";

  export async function POST(request) {
    const t = makeT(headerLocale(request));
    return apiGate(async () => {
      const body = await readBody(request);
      const ticket = String(body.ticket || "");
      const code = String(body.code || "").replace(/\s/g, "");
      if (!ticket || !code) return jsonFail(t("api.twofa_required"), 422);

      const sec = await getAdminSecurity();
      if (!isEntryReferer(request, sec)) return jsonFail(t("api.no_entry"), 404);

      const user = await verifyChallengeTicket(ticket);
      if (!user) return jsonFail(t("api.twofa_expired"), 401);

      const verdict = await applyAsyncFilters(HOOKS.authChallengeVerify, {
        user,
        code,
        ok: false,
      });
      if (!verdict.ok) {
        await recordLoginEvent({
          eventType: LOGIN_EVENTS.FAIL,
          userId: user.id,
          account: user.name,
          ip: clientIp(request),
          userAgent: clientUa(request),
        });
        return jsonFail(t("api.twofa_wrong"), 401);
      }

      await recordLoginEvent({
        eventType: LOGIN_EVENTS.SUCCESS,
        userId: user.id,
        account: user.name,
        ip: clientIp(request),
        userAgent: clientUa(request),
      });
      doAction(HOOKS.userLoggedIn, { user });
      return new Response(JSON.stringify({ user }), {
        status: 200,
        headers: {
          "content-type": "application/json; charset=utf-8",
          "set-cookie": await sessionCookiePair(user),
        },
      });
    }, t);
  }
</script>
