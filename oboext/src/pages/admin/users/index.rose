<script>
  // User management (admin only — the sidebar link itself is admin-gated and
  // the API enforces users:read/users:manage). Reads live rows per request.
  let users = $data(() => __rvLoad("admin.users", {}));
  function list() {
    return users() || [];
  }
  function copy() {
    return users().s || {};
  }
  function roles() {
    return copy().roles || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function roleLabel(r) {
    const c = roles();
    return r === "admin" ? c.admin : r === "editor" ? c.editor : r === "subscriber" ? c.subscriber : c.author;
  }
  function fmt(iso) {
    if (!iso) return "—";
    const dt = new Date(iso);
    const pad = (n) => String(n).padStart(2, "0");
    return dt.getFullYear() + "-" + pad(dt.getMonth() + 1) + "-" + pad(dt.getDate());
  }
  function userJson(u) {
    return JSON.stringify(u);
  }
  function emptyHint() {
    return list().length ? [] : [1];
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-grid adm-cols-2">
  <div class="adm-card">
    <div class="adm-card-hd"><strong id="user-form-title">{copy().add}</strong></div>
    <div class="adm-card-bd">
      <form data-adm-form="user">
        <input type="hidden" name="id">
        <div class="adm-field">
          <label>{copy().nickname}</label>
          <input class="adm-input" name="name" required placeholder={copy().phName}>
        </div>
        <div class="adm-field">
          <label>{copy().email}</label>
          <input class="adm-input" type="email" name="email" required placeholder="login@example.com">
        </div>
        <div class="adm-field">
          <label>{copy().password}</label>
          <input class="adm-input" type="password" name="password" placeholder={copy().phPassword}>
        </div>
        <div class="adm-field">
          <label>{copy().role}</label>
          <select class="adm-select" name="role">
            <option value="author">{roles().authorHint}</option>
            <option value="editor">{roles().editorHint}</option>
            <option value="admin">{roles().adminHint}</option>
            <option value="subscriber">{roles().subscriberHint}</option>
          </select>
        </div>
        <div class="adm-field">
          <label>{copy().bio}</label>
          <textarea class="adm-textarea" name="bio" rows="3" placeholder={copy().phBio}></textarea>
        </div>
        <button class="adm-btn" type="submit">{copy().add}</button>
      </form>
    </div>
  </div>

  <div class="adm-card adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>{copy().colUser}</th>
          <th style="width:90px">{copy().colRole}</th>
          <th style="width:100px">{copy().colCreated}</th>
          <th style="width:130px"></th>
        </tr>
      </thead>
      <tbody>
        {#each list() as u}
        <tr>
          <td>
            <div class="title">{u.name}</div>
            <div class="sub">{u.email}</div>
          </td>
          <td><span class={"adm-tag role-" + u.role}>{roleLabel(u.role)}</span></td>
          <td class="adm-hint">{fmt(u.createdAt)}</td>
          <td>
            <div class="row-actions">
              {#if u.role !== "subscriber"}
              <a class="adm-iconbtn" href={"/author/" + u.id} target="_blank" rel="noopener">{copy().home}</a>
              {/if}
              <button class="adm-iconbtn" data-adm-act="user-edit" data-user={userJson(u)}>{copy().edit}</button>
              <button
                class="adm-iconbtn danger"
                data-adm-act="delete"
                data-url={"/api/users/" + u.id}
                data-confirm={hint("confirmDelete", { name: u.name })}
              >{copy().delete}</button>
            </div>
          </td>
        </tr>
        {/each}
      </tbody>
    </table>
    {#each emptyHint() as _}
    <div class="adm-empty">{copy().empty}</div>
    {/each}
  </div>
</div>
