<script>

  let d = $data(() => __rvLoad("admin.session", {}));
  // The session payload carries this screen's copy (R495): admin paths have no
  // locale prefix, so it is resolved from the cookie / Accept-Language.
  function copy() {
    return d().backup || {};
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div style="display:flex;align-items:center;gap:8px;">
    <span class="adm-ic" style="--i:url(/public/icons/database-backup.svg);width:20px;height:20px;color:#818cf8;"></span>
    <strong style="font-size:16px">{copy().title}</strong>
  </div>
</div>

<div class="adm-card" style="margin-bottom:16px;">
  <div class="adm-card-hd"><strong style="font-size:14px;">{copy().download}</strong></div>
  <div class="adm-card-bd">
    <p class="adm-hint" style="margin:0 0 12px;">{copy().downloadHint}</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a class="adm-btn" href="/api/admin/backup?full=1" download><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/download.svg)"></span>{copy().full}</a>
    <a class="adm-btn adm-btn-ghost" href="/api/admin/backup" download><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/download.svg)"></span>{copy().dbOnly}</a>
    </div>
  </div>
</div>

<div class="adm-card" style="margin-bottom:16px;">
  <div class="adm-card-hd"><strong style="font-size:14px;">{copy().restore}</strong></div>
  <div class="adm-card-bd">
    <p class="adm-hint" style="margin:0 0 12px;color:#f87171;">{copy().warn}</p>
    <form data-adm-form="backup-restore">
      <div class="adm-field">
        <label>{copy().fileLabel}</label>
        <input class="adm-input" type="file" name="file" accept=".json,application/json" required>
      </div>
      <div class="adm-field" style="margin-top:12px;">
        <label>{copy().confirmLabel}</label>
        <input class="adm-input" name="confirm" placeholder="RESTORE" autocomplete="off" spellcheck="false" style="max-width:220px;" required>
      </div>
      <p class="adm-hint" style="margin:12px 0 12px;color:#f87171;" data-adm-msg></p>
      <button class="adm-btn" type="submit" style="background:#dc2626;">{copy().run}</button>
    </form>
    <p class="adm-hint" style="margin:12px 0 0;">{copy().afterHint}</p>
  </div>
</div>
