<script>

  let s = $data(() => __rvLoad("admin.security", {}));
  function g(k, dflt) {
    const v = s()[k];
    return v == null || v === "" ? (dflt == null ? "" : dflt) : v;
  }
  function on(k) {
    return s()[k] ? "1" : "0";
  }
  // this page's state accessor is already s(), so the copy block rides inside it
  function copy() {
    return (s() && s().s) || {};
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<form data-adm-form="security">
  <div class="adm-toolbar">
    <strong style="font-size:16px">{copy().title}</strong>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">{copy().save}</button>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{copy().disguise}</span><span class="d">{copy().disguiseHint}</span></span><input type="checkbox" name="entryEnabled" data-on={on('entryEnabled')} data-bool></label>
      <div class="adm-field" data-show-if="entryEnabled=1" style="margin-top:14px;">
        <label>{copy().secretPath}</label>
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="adm-hint" style="margin:0;">/</span>
          <input class="adm-input" name="entryPath" value={g('entryPath', '/secret-login').replace(/^\//, '')} placeholder="secret-login" spellcheck="false" style="max-width:280px;">
        </div>
        <p class="adm-hint" style="margin:6px 0 0;">
          {copy().secretRule}
        </p>
        <p class="adm-hint" style="margin:6px 0 0;color:#fbbf24;">
          {copy().secretBackup}
        </p>
      </div>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{copy().captchaOn}</span><span class="d">{copy().captchaHint}</span></span><input type="checkbox" name="captchaEnabled" data-on={on('captchaEnabled')} data-bool></label>
      <div class="adm-field" data-show-if="captchaEnabled=1" style="margin-top:14px;">
        <label>{copy().captchaChannel}</label>
        <select class="adm-select" name="captchaMode" data-val={g('captchaMode', 'builtin')} style="max-width:280px;">
          <option value="builtin">{copy().captchaBuiltin}</option>
          <option value="custom">{copy().captchaThird}</option>
        </select>
      </div>
      <div data-show-if="captchaMode=custom" hidden>
        <div class="adm-field">
          <label>{copy().verifyUrl}</label>
          <input class="adm-input" name="captchaVerifyUrl" value={g('captchaVerifyUrl')} placeholder="https://captcha.example.com/verify">
        </div>
        <div class="adm-field">
          <label>{copy().reqMethod}</label>
          <select class="adm-select" name="captchaVerifyMethod" data-val={g('captchaVerifyMethod', 'POST')} style="max-width:280px;">
            <option value="POST">POST</option>
            <option value="GET">GET</option>
            <option value="PUT">PUT</option>
          </select>
        </div>
        <div class="adm-field">
          <label>{copy().reqHeaders}</label>
          <textarea class="adm-textarea" name="captchaVerifyHeaders" rows="3" placeholder="Content-Type: application/json">{g('captchaVerifyHeaders')}</textarea>
        </div>
        <div class="adm-field">
          <label>{copy().bodyTemplate}</label>
          <textarea class="adm-textarea" name="captchaVerifyBody" rows="3">{g('captchaVerifyBody')}</textarea>
        </div>
        <div class="adm-field">
          <label>{copy().successRule}</label>
          <input class="adm-input" name="captchaVerifySuccess" value={g('captchaVerifySuccess')} placeholder="code=200">
        </div>
      </div>
    </div>
  </div>

  <div class="adm-card" style="margin-bottom:16px;">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{copy().rateLimit}</span><span class="d">{copy().rateHint}</span></span><input type="checkbox" name="throttleEnabled" data-on={on('throttleEnabled')} data-bool></label>
      <div class="adm-form-grid" data-show-if="throttleEnabled=1">
        <div class="adm-field">
          <label>{copy().maxFail}</label>
          <input class="adm-input" type="number" name="throttleMaxFailures" data-num value={g('throttleMaxFailures', 5)} min="3" max="50">
        </div>
        <div class="adm-field">
          <label>{copy().windowMin}</label>
          <input class="adm-input" type="number" name="throttleWindowMinutes" data-num value={g('throttleWindowMinutes', 15)} min="1" max="1440">
        </div>
      </div>
      <p class="adm-hint" style="margin:6px 0 0;">{copy().rateNote}</p>
    </div>
  </div>
</form>
