<script>
  // Post list (all statuses, live DB). Status/search/page ride the query
  // string; the middleware's loopback workaround makes them reach SSR.
  let data = $data(() =>
    __rvLoad("admin.posts", {
      status: __rvQs().get("status") || "",
      search: __rvQs().get("q") || "",
      locale: __rvQs().get("locale") || "",
      page: __rvQs().get("page"),
      after: __rvQs().get("after") || "",
    }),
  );
  // NB: {#each} compiles its expression as a zero-arg call, so iteration
  // targets must be function accessors, never bare arrays.
  function rows() {
    return data().items;
  }
  // The loader hands down every visible string in the request's language
  // (R487, same contract as the dashboard), so the template reads copy().
  function copy() {
    return data().s || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function pagerSummary() {
    return hint("pagerSummary", { total: data().total, page: data().page });
  }
  function confirmDeleteOne(title) {
    return hint("confirmDeleteOne", { title: title });
  }
  function fmtDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") +
      "-" + String(d.getDate()).padStart(2, "0");
  }
  function statusLabel(v) {
    const c = copy();
    return v === "published" ? c.published : v === "draft" ? c.draft : c.archived;
  }
  // Categories and tags render as separate chips so a row does not read as one
  // undifferentiated string; tags carry a # prefix.
  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }
  function ic(n, size) {
    const s = size || 12;
    return '<span class="adm-ic" style="width:' + s + "px;height:" + s +
      'px;--i:url(/public/icons/' + String(n).replace(/[^a-z0-9-]/g, "") + '.svg)"></span>';
  }
  function catChipHtml(list) {
    return (list || [])
      .map(function (c) {
        return '<span class="adm-tax-chip adm-tax-cat">' + ic("folder", 12) +
          esc(c.name) + "</span>";
      })
      .join("");
  }
  function tagChipHtml(list) {
    return (list || [])
      .map(function (t) {
        return '<span class="adm-tax-chip adm-tax-tag">#' + esc(t.name) + "</span>";
      })
      .join("");
  }
  // Scheduled badge: a draft whose publish time is still in the future.
  function scheduledLabel(p) {
    if (p.status !== "draft" || !p.publishedAt) return "";
    const t = new Date(p.publishedAt).getTime();
    return t > Date.now() ? copy().scheduled + " " + fmtDate(p.publishedAt) : "";
  }
  function viewUrl(p) {
    return p.url || "#";
  }
  function tabClass(s) {
    // R281: the language tabs compare against ?locale, the status tabs
    // against ?status — one helper, dimension decided by the value.
    const qs = __rvQs();
    return (s === "en" || s === "zh-CN"
      ? qs.get("locale") || ""
      : qs.get("status") || "") === s ? "is-active" : "";
  }
  function prevPage() {
    return Math.max(1, data().page - 1);
  }
  function nextPage() {
    return data().page + 1;
  }
  function hasNext() {
    return data().page * data().limit < data().total;
  }
  function pagerHref(p) {
    const q = new URLSearchParams(__rvQs().toString());
    q.set("page", String(p));
    return "/admin/posts?" + q.toString();
  }
  function hasPrev() {
    return data().page > 1;
  }
  function hasPager() {
    return data().total > data().limit || data().page > 1;
  }
  function emptyHint() {
    return rows().length ? [] : [1];
  }
  // same-kind blocks can't nest ({#if} in {#if} pairs wrongly), so the pager
  // wrapper rides an each-predicate while the prev/next flags stay {#if}
  function pager() {
    return hasPager() ? [1] : [];
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-toolbar">
  <div class="adm-tabs">
    <a class={tabClass("")} href="/admin/posts">{copy().filterAll}</a>
    <a class={tabClass("published")} href="/admin/posts?status=published">{copy().published}</a>
    <a class={tabClass("draft")} href="/admin/posts?status=draft">{copy().draft}</a>
    <a class={tabClass("archived")} href="/admin/posts?status=archived">{copy().archived}</a>
    <span style="width:1px;height:18px;background:var(--border);display:inline-block;margin:0 6px"></span>
    <a class={tabClass(__rvQs().get("locale") || "")} href="/admin/posts">{copy().languageAll}</a>
    <a class={tabClass("en")} href="/admin/posts?locale=en">EN</a>
    <a class={tabClass("zh-CN")} href="/admin/posts?locale=zh-CN">{copy().languageZh}</a>
  </div>
  <span style="flex:1"></span>
  <form class="adm-search" action="/admin/posts">
    <input class="adm-input" name="q" aria-label={copy().searchPlaceholder} placeholder={copy().searchPlaceholder} value={__rvQs().get("q") || ""}>
  </form>
  <a class="adm-btn" href="/admin/posts/new"><span class="adm-ic" style="--i:url(/public/icons/plus.svg)"></span>{copy().write}</a>
</div>

<div class="adm-toolbar" style="gap:8px;">
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/posts" data-op="publish">{copy().bulkPublish}</button>
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/posts" data-op="draft">{copy().bulkDraft}</button>
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/posts" data-op="archive">{copy().bulkArchive}</button>
  <button class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-url="/api/posts" data-op="delete" data-confirm={copy().confirmBulkDelete}>{copy().bulkDelete}</button>
</div>

<div class="adm-card adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all"></th>
        <th>{copy().colTitle}</th>
        <th style="width:110px">{copy().colAuthor}</th>
        <th style="width:60px">{copy().colLanguage}</th>
        <th style="width:90px">{copy().colStatus}</th>
        <th style="width:110px">{copy().colDate}</th>
        <th style="width:60px">{copy().colViews}</th>
        <th style="width:120px"></th>
      </tr>
    </thead>
    <tbody>
      {#each rows() as p}
      <tr>
        <td><input type="checkbox" class="adm-check" value={p.id}></td>
        <td>
          <a class="title" href={"/admin/posts/" + p.id}>{p.title}</a>
          <div class="sub adm-post-meta">
            <a class="adm-post-slug" href={"/admin/posts/" + p.id}>/{p.slug}</a>
            {#if p.pair}<a href={"/admin/posts/" + p.pair.id} style="font-size:12px">↔ {p.pair.slug}</a>{/if}
            {@html catChipHtml(p.categories)}
            {@html tagChipHtml(p.tags)}
          </div>
        </td>
        <td class="adm-hint">{p.locale === "en" ? "EN" : copy().languageZh}</td>
        <td>{p.authorName || "—"}</td>
        <td><span class={"adm-tag " + p.status}>{statusLabel(p.status)}</span>
          {#if scheduledLabel(p)}<span class="adm-tag scheduled">{scheduledLabel(p)}</span>{/if}
        </td>
        <td class="adm-hint">{fmtDate(p.updatedAt)}</td>
        <td class="adm-hint">{p.views}</td>
        <td>
          <div class="row-actions">
            <a class="adm-iconbtn" href={viewUrl(p)} target="_blank" rel="noopener noreferrer" title={copy().actView}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/eye.svg)"></span>{copy().actView}</a>
            <a class="adm-iconbtn" href={"/admin/posts/" + p.id}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/pencil.svg)"></span>{copy().actEdit}</a>
            <button class="adm-iconbtn danger" data-adm-act="delete" data-url={"/api/posts/" + p.id} data-confirm={confirmDeleteOne(p.title)}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span>{copy().actDelete}</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">{copy().empty}</div>
  {/each}
</div>

{#each pager() as _}
<div class="adm-pager">
  {pagerSummary()}
  <span style="flex:1"></span>
  {#if hasPrev()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={pagerHref(prevPage())}>{copy().pagerPrev}</a>{/if}
  {#if hasNext()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={pagerHref(nextPage())}>{copy().pagerNext}</a>{/if}
</div>
{/each}
