<script>
  // /api/categories — GET list (all readers), POST create (taxonomy:manage),
  // PUT reorder (taxonomy:manage)
  import { apiGate, readBody, createCategory, reorderCategories, bulkDeleteCategories } from "@server/admin";
  import { listCategories } from "@server/queries";

  export async function GET() {
    return apiGate(async () => listCategories());
  }

  export async function POST(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const row = await createCategory(getContext().user, body);
      return new Response(JSON.stringify(row), {
        status: 201,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }

  export async function PUT(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      await reorderCategories(getContext().user, body.items || []);
      return new Response(JSON.stringify({ ok: true }), {
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }

  // Bulk delete: { ids: number[] }. Affected posts are detached (uncategorized);
  // surviving children of a deleted category are promoted to top-level.
  export async function PATCH(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const ids = Array.isArray(body && body.ids) ? body.ids : [];
      if (ids.length > 500)
        return new Response(JSON.stringify({ error: "批量操作一次最多 500 项" }), {
          status: 422,
          headers: { "content-type": "application/json; charset=utf-8" },
        });
      const res = await bulkDeleteCategories(getContext().user, ids);
      return new Response(JSON.stringify(res), {
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }
</script>
