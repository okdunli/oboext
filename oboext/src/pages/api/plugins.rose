<script>
  // /api/plugins GET list installed plugins (row + manifest + resolved settings) POST multipart {file} — install a plugin zip.
  import { apiGate, jsonFail, requireCap } from "@server/admin";
  import { listPlugins, installPluginZip } from "@server/plugins";
  import { MAX_ZIP_BYTES } from "@server/package-install";

  export async function GET() {
    return apiGate(async () => {
      requireCap(getContext().user, "settings:manage");
      return { plugins: await listPlugins() };
    });
  }

  export async function POST(request) {
    return apiGate(async () => {
      requireCap(getContext().user, "settings:manage");
      const form = await request.formData();
      const file = form.get("file");
      if (!(file instanceof File)) return jsonFail("请选择要上传的 zip 插件包", 400);
      if (!/\.zip$/i.test(file.name)) return jsonFail("只支持 .zip 格式的插件包", 400);
      const buf = Buffer.from(await file.arrayBuffer());
      if (buf.length > MAX_ZIP_BYTES) {
        return jsonFail(
          `插件包不能超过 ${Math.round(MAX_ZIP_BYTES / 1024 / 1024)}MB`,
          400,
        );
      }
      const row = await installPluginZip(buf);
      return new Response(JSON.stringify(row), {
        status: 201,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }
</script>
