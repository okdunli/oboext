<script>
  // /api/media/reorder — POST {ids:[...]} persist the manual drag order.
  // The ids are the full visible grid in its new order; the server renumbers
  // the whole library around them. A literal route, so it wins over [id].rose.
  import { apiGate, readBody, jsonFail } from "@server/admin";
  import { reorderMedia } from "@server/media";

  export async function POST(request) {
    return apiGate(async () => {
      const body = await readBody(request);
      const ids = Array.isArray(body.ids)
        ? body.ids.map((n) => Number(n)).filter((n) => Number.isInteger(n) && n > 0)
        : [];
      if (!ids.length) return jsonFail("缺少 ids", 400);
      return reorderMedia(getContext().user, ids);
    });
  }
</script>
