<script>
  // POST /api/auth/logout — clears cms_session and its CSRF token.
  import { apiGate } from "@server/admin";
  import { clearCookiePair } from "@server/csrf";

  export async function POST() {
    return apiGate(async () => {
      // Both cookies must go as separate headers - a collapsed array leaves
      // one of them behind (BUG.md entry Y).
      const res = new Response("{}", {
        status: 200,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
      for (const v of clearCookiePair()) res.headers.append("set-cookie", v);
      return res;
    });
  }
</script>
