<script>
  // /api/settings — GET the singleton row (public read, mirrors the original:
  // the site theme/login screens read it unauthenticated), PATCH whitelisted
  // columns (settings:manage).
  import { apiGate, readBody, requireCap, updateSettings } from "@server/admin";
  import { getSettings } from "@server/queries";

  export async function GET() {
    return apiGate(async () => getSettings());
  }

  export async function PATCH(request) {
    return apiGate(async () =>
      updateSettings(getContext().user, await readBody(request)),
    );
  }
  export async function PUT(request) {
    return apiGate(async () =>
      updateSettings(getContext().user, await readBody(request)),
    );
  }
</script>
