<script>
  // Admin shell (dark zinc/indigo, ported from AdminShell.tsx). Unauthenticated
  // routes (/admin/login, /admin/setup — the middleware whitelist) render the
  // bare slot; everything else gets the sidebar + topbar chrome.
  let session = $data(() => __rvLoad("admin.session", {}));

  let entryGate = $data(async () => {
    const s = await __rvLoad("admin.session", {});
    if (s.user) return false;
    const sec = await __rvLoad("admin.security-public", {});
    if (sec.entryEnabled) notFound();
    return false;
  });
  function authed() {
    return session() && session().user;
  }
  function initial() {
    var n = session() && session().user ? session().user.name : "";
    return n ? n.slice(0, 1).toUpperCase() : "A";
  }
  function pageTitle() {
    var p =
      typeof window !== "undefined"
        ? window.location.pathname
        : String(getContext().pathname || "");
    if (p === "/admin" || p === "/admin/") return "仪表盘";
    if (p.indexOf("/admin/posts") === 0)
      return /\/admin\/posts\/(new|\d+)/.test(p) ? "编辑文章" : "文章";
    if (p.indexOf("/admin/pages") === 0)
      return /\/admin\/pages\/(new|\d+)/.test(p) ? "编辑页面" : "页面";
    if (p.indexOf("/admin/media") === 0) return "媒体库";
    if (p.indexOf("/admin/comments") === 0) return "评论";
    if (p.indexOf("/admin/categories") === 0) return "分类";
    if (p.indexOf("/admin/tags") === 0) return "标签";
    if (p.indexOf("/admin/users") === 0) return "用户";
    if (p.indexOf("/admin/widgets") === 0) return "小工具";
    if (p.indexOf("/admin/themes") === 0)
      return /\/admin\/themes\/[^/]+/.test(p) ? "主题设置" : "主题";
    if (p.indexOf("/admin/menus") === 0) return "菜单";
    if (p.indexOf("/admin/menu-settings") === 0) return "菜单与首页";
    if (p.indexOf("/admin/settings") === 0) return "站点设置";
    if (p.indexOf("/admin/permalinks") === 0) return "固定链接";
    if (p.indexOf("/admin/security") === 0) return "后台安全";
    if (p.indexOf("/admin/security-logs") === 0) return "安全日志";
    if (p.indexOf("/admin/maintenance") === 0) return "维护模式";
    if (p.indexOf("/admin/oauth") === 0) return "第三方登录";
    if (p.indexOf("/admin/notify") === 0) return "通知设置";
    if (p.indexOf("/admin/members") === 0) return "会员注册";
    if (p.indexOf("/admin/account") === 0) return "我的账号";
    if (p.indexOf("/admin/notfound") === 0) return "404 页面";
    if (p.indexOf("/admin/plugins") === 0) return "插件";
    return "管理后台";
  }
  function guest() {
    return !authed();
  }
  // Sidebar nav is data-driven: the session loader returns the preference-
  // filtered, role-filtered nav as pre-rendered HTML (emitted via
  // {@html}; the .rose compiler cannot nest directives enough to
  // expand the groups inline).
  function navRaw() {
    return (session() && session().navRaw) || "";
  }
</script>

<head>
  <title>管理后台</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="stylesheet" href="/public/admin.css">
  <script src="/public/admin.js"></script>
</head>

{#if authed()}
<div class="adm-shell">
  <aside class="adm-side">
    <div class="adm-logo"><span class="adm-auth-mark"><span class="adm-ic adm-ic-lg" style="--i:url(/public/icons/layout-dashboard.svg)"></span></span> oboext<button type="button" class="adm-logo-x" data-nav-close aria-label="关闭菜单"><span class="adm-ic" style="--i:url(/public/icons/x.svg)"></span></button></div>
    <nav class="adm-nav">
      {@html navRaw()}
    </nav>
    <div class="adm-side-foot">
      <a class="adm-avatar" href="/admin/account" title="我的账号" style="text-decoration:none;">{initial()}</a>
      <div class="who"><b>{authed() ? session().user.name : ""}</b><span>{authed() ? session().user.role : ""}</span></div>
      <button class="adm-iconbtn" data-adm-act="logout" title="退出登录" aria-label="退出登录"><span class="adm-ic" style="--i:url(/public/icons/log-out.svg)"></span></button>
    </div>
  </aside>
  <div class="adm-main">
    <div class="adm-mbar">
      <button type="button" class="adm-mbar-btn" data-nav-open aria-label="打开菜单"><span class="adm-ic" style="--i:url(/public/icons/menu.svg)"></span></button>
      <span class="adm-mbar-title">oboext 管理后台</span>
    </div>
    <div class="adm-scrim" data-nav-close aria-hidden="true"></div>
    <header class="adm-topbar">
      <h1>{pageTitle()}</h1>
      <span class="spacer"></span>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/" target="_blank"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span> 访问站点</a>
    </header>
    <main class="adm-content">
      <slot />
    </main>
  </div>
</div>
{/if}
{#if guest()}
<slot />
{/if}
