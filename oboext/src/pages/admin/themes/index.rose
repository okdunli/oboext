<script>
  // Theme manager (port of components/ThemeManager.tsx).
  let d = $data(() => __rvLoad("admin.themes", {}));
  function copy() {
    return (d() && d().s) || {};
  }

  function themes() {
    return d().themes || [];
  }
  function payload() {
    return JSON.stringify(d());
  }
  function accent(t) {
    return (t.config && t.config.accent) || "#818cf8";
  }
  function accentText(t) {
    return (t.config && t.config.accentText) || "#ffffff";
  }
  function radius(t) {
    return (t.config && t.config.radius) || "12px";
  }
  function cardClass(t) {
    return "adm-th-card" + (t.active ? " is-active" : "");
  }
  function strip(t) {
    var c = (t.config && t.config) || {};
    return [
      c.background || "#09090b",
      c.surface || "#18181b",
      c.accent || "#818cf8",
      c.text || "#f4f4f5",
      c.muted || "#a1a1aa",
      c.border || "#27272a",
    ];
  }
  function meta(t, k) {
    return t.meta && t.meta[k] ? t.meta[k] : "";
  }
  function version(t) {
    return t.meta && t.meta.version ? "v" + t.meta.version : "";
  }
  function authorUrl(t) {
    var h = t.meta && t.meta.homepage;
    return h && /^https?:\/\//i.test(h) ? h : "";
  }
  function builtIn(t) {
    return t.isDefault ? copy().builtin : "";
  }
  function canDelete(t) {
    return themes().length > 1 && !t.isDefault;
  }
  function ported(t) {
    return t.ported !== false;
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-th" data-th-manager data-th={payload()}>
  <div class="adm-th-head">
    <h1 class="adm-h1"><span class="adm-h1-ic"><span class="adm-ic" style="width:20px;height:20px;--i:url(/public/icons/palette.svg)"></span></span> {copy().title}</h1>
    <p class="adm-th-intro">
      {copy().intro1}
      <span class="adm-th-hl">{copy().intro2}</span>{copy().intro3}
    </p>
    <div class="adm-th-toolbar">
      <input class="adm-input adm-th-create-input" data-th-new-name placeholder={copy().phName}>
      <button type="button" class="adm-btn" data-th-create><span class="adm-ic" style="--i:url(/public/icons/plus.svg)"></span>{copy().newTheme}</button>
    </div>
    <div class="adm-th-upload" data-th-upload>
      <label class="adm-th-upload-btn">
        <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/upload.svg)"></span>{copy().uploadTitle}
        <input type="file" accept=".zip,application/zip" class="adm-hidden-file" data-th-zip>
      </label>
      <span class="adm-th-upload-hint">{copy().uploadHint}</span>
      <span class="adm-th-upload-msg"></span>
    </div>
  </div>

  <div class="adm-th-grid">
    {#each themes() as t}
    <div class={cardClass(t)} data-th-id={t.id} data-th-slug={t.slug}>
      <div class="adm-th-card-hd">
        <span class="adm-th-mark" style={(() => "background:" + accent(t) + ";color:" + accentText(t) + ";border-radius:" + radius(t))()}><span class="adm-ic adm-ic-lg" style="--i:url(/public/icons/palette.svg)"></span></span>
        <div class="adm-th-info">
          <div class="adm-th-name-line">
            <p class="adm-th-name">{t.name}</p>
            {#if (() => version(t) !== "")()}
            <span class="adm-th-version">{version(t)}</span>
            {/if}
          </div>
          {#if (() => meta(t, "description") !== "")()}
          <p class="adm-th-desc">{meta(t, "description")}</p>
          {/if}
          <div class="adm-th-meta">
            <span class="adm-th-mono">themes/{t.slug}{builtIn(t)}</span>
            {#if (() => authorUrl(t) !== "")()}
            <a class="adm-th-author" style="display:inline-flex;align-items:center;gap:4px" href={authorUrl(t)} target="_blank" rel="noreferrer noopener">{meta(t, "author")}<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span></a>
            {/if}
            {#if (() => authorUrl(t) === "" && meta(t, "author") !== "")()}
            <span>{meta(t, "author")}</span>
            {/if}
            {#if (() => meta(t, "updatedAt") !== "")()}
            <span>{copy().updatedPrefix} {meta(t, "updatedAt")}</span>
            {/if}
          </div>
          {#if (() => t.active)()}
          <span class="adm-th-live">{copy().active}</span>
          {/if}
          {#if (() => !ported(t))()}
          <span class="adm-th-soon" title={copy().titleAdapting}>{copy().adapting}</span>
          {/if}
        </div>
      </div>
      <div class="adm-th-strip">
        {#each strip(t) as c}
        <span class="adm-th-swatch" title={c} style={(() => "background:" + c)()}></span>
        {/each}
      </div>
      <div class="adm-th-actions">
        {#if (() => !t.active && ported(t))()}
        <button type="button" class="adm-btn adm-btn-sm" data-th-activate><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/check.svg)"></span>{copy().setActive}</button>
        {/if}
        {#if (() => !t.active && !ported(t))()}
        <button type="button" class="adm-btn adm-btn-sm" disabled style="opacity:.45;cursor:not-allowed" title={copy().titleAdaptingShort}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/clock.svg)"></span>{copy().adaptingShort}</button>
        {/if}
        <a class="adm-btn adm-btn-ghost adm-btn-sm" href={(() => "/admin/themes/" + t.slug)()}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/settings-2.svg)"></span>{copy().themeSettings}</a>
        {#if (() => canDelete(t))()}
        <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm adm-th-del" data-th-delete><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span>{copy().delete}</button>
        {/if}
      </div>
    </div>
    {/each}
  </div>
</div>
