<script>

  let s = $data(() => __rvLoad("admin.account", {}));
  function v(k) {
    const x = s()[k];
    return x == null ? "" : x;
  }
  // This page's state accessor is already called s(), so the translated copy
  // block rides inside it: copy() reads s().s (same shape the loader writes).
  function copy() {
    return (s() && s().s) || {};
  }

  // The section rail's click/scroll-spy lives in public/admin.js, not here.
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-thp" data-acc-panel>
  <div class="adm-thp-head">
    <div>
      <h1 class="adm-h1">{copy().title}</h1>
      <p class="adm-thp-desc">{copy().lead}</p>
    </div>
  </div>

  <div class="adm-thp-grid">
    <nav class="adm-thp-nav">
      <div class="adm-thp-navgroup">
        <div class="adm-thp-navtitle">{copy().navGroup}</div>
        <div class="adm-thp-navlist" data-acc-nav>
          <button type="button" class="adm-thp-navbtn is-active" data-sec="profile">{copy().navProfile}</button>
          <button type="button" class="adm-thp-navbtn" data-sec="password">{copy().navPassword}</button>
          <button type="button" class="adm-thp-navbtn" data-sec="oauth">{copy().navOauth}</button>
        </div>
      </div>
    </nav>

    <div class="adm-thp-body" data-acc-body>
      <section data-acc-sec="profile">
        <div class="adm-card">
          <div class="adm-card-hd"><strong style="font-size:14px;">{copy().navProfile}</strong></div>
          <div class="adm-card-bd">
            <form data-adm-form="account-profile">
              <div class="adm-field">
                <label>{copy().nickname}</label>
                <input class="adm-input" name="name" value={v('name')} maxlength="100" autocomplete="name" required>
              </div>
              <div class="adm-field">
                <label>{copy().emailCodeLabel}</label>
                <input class="adm-input" type="email" name="email" value={v('email')} maxlength="120" autocomplete="email" required>
                <div style="display:flex;gap:8px;margin-top:8px;">
                  <input class="adm-input" name="emailCode" inputmode="numeric" maxlength="8" placeholder={copy().phEmailCode} style="flex:1;">
                  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="account-send" data-channel="email" style="flex-shrink:0;white-space:nowrap;">{copy().sendCode}</button>
                </div>
              </div>
              <div class="adm-field">
                <label>{copy().phoneLabel}</label>
                <input class="adm-input" type="tel" name="phone" value={v('phone')} maxlength="20" autocomplete="tel">
                <div style="display:flex;gap:8px;margin-top:8px;">
                  <input class="adm-input" name="phoneCode" inputmode="numeric" maxlength="8" placeholder={copy().phPhoneCode} style="flex:1;">
                  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="account-send" data-channel="sms" style="flex-shrink:0;white-space:nowrap;">{copy().sendCode}</button>
                </div>
              </div>
              <p class="adm-hint" style="margin:0 0 12px;" data-adm-msg></p>
              <button class="adm-btn" type="submit">{copy().saveProfile}</button>
            </form>
            <p class="adm-hint" style="margin:12px 0 0;">{copy().role}<b style="color:var(--adm-text);">{v('role')}</b></p>
          </div>
        </div>
      </section>

      <section data-acc-sec="password">
        <div class="adm-card">
          <div class="adm-card-hd"><strong style="font-size:14px;">{copy().navPassword}</strong></div>
          <div class="adm-card-bd">
            <form data-adm-form="account-password">
              {#if (() => !s().passwordless)()}
              <div class="adm-field">
                <label>{copy().currentPassword}</label>
                <input class="adm-input" type="password" name="currentPassword" autocomplete="current-password" required>
              </div>
              {/if}
              <div class="adm-field">
                <label>{copy().newPassword}</label>
                <input class="adm-input" type="password" name="newPassword" minlength="8" maxlength="200" autocomplete="new-password" required>
              </div>
              <div class="adm-field">
                <label>{copy().confirmPassword}</label>
                <input class="adm-input" type="password" name="confirmPassword" minlength="8" maxlength="200" autocomplete="new-password" required>
              </div>
              <p class="adm-hint" style="margin:0 0 12px;" data-adm-msg></p>
              <button class="adm-btn" type="submit">{copy().updatePassword}</button>
              {#if (() => s().passwordless)()}
              <p class="adm-hint" style="margin:10px 0 0;">{copy().passwordlessHint}</p>
              {/if}
            </form>
          </div>
        </div>
      </section>

      <section data-acc-sec="oauth">
        <div class="adm-card">
          <div class="adm-card-hd"><strong style="font-size:14px;">{copy().navOauth}</strong></div>
          <div class="adm-card-bd" data-oauth-bindings>
            <p class="adm-hint" style="margin:0;">{copy().oauthLoading}</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>