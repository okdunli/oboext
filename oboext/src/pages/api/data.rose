<script>
  // Isomorphic data endpoint.
  import { dispatch, documents, searchRedirect, warmEntityUrls } from "@server/loaders";
  import { buildSitemapDocument } from "@server/sitemap";
  import { themeCssContent, serveThemeAsset } from "@server/theme-chrome";
  import { servePluginAsset } from "@server/plugin-assets";
  import { serveUpload, servePublic } from "@server/storage";
  import { ensureMigrations, withDbRetry } from "@server/db";
  import { getSessionFromRequest, hasAnyUser } from "@server/auth";
  import { getAdminSecurity } from "@server/security";
  import { getAdminMenuPrefs, homeRedirectFor } from "@server/admin-menu";
  import { syncPlugins, ensurePluginsLoaded } from "@server/plugins";
  import { dispatchPluginApi } from "@server/plugin-gateway";
  import { createLogger } from "@server/logger";
  const log = createLogger("data-api");

  // The fragment a loader answers depends on the page it was requested for -
  // the browser stamps it on the x-rv-url header and the middleware turns it
  // into ctx.pathname (admin nav highlight, chrome locale hrefs). That makes
  // it a negotiation dimension of a storable response, so it has to ride the
  // cache key (BUG.md AB). The response also carries no-store, which the
  // store refuses today; the declaration is what keeps it correct if that is
  // ever relaxed, and the client's &rv= tag stays as the fallback for a
  // request that arrives without the header.
  export const hotVary = ["x-rv-url"];

  // Lazy: the framework's build imports dist/server.js for route analysis; touching the DB at module top level would make builds require a DB.
  let readyPromise;
  // WithDbRetry, not a bare call: a serverless Postgres drops the connection of a suspended compute during the TLS handshake.
  const ready = () => (readyPromise = readyPromise || withDbRetry(async () => {
    await ensureMigrations();
    await syncPlugins();
    await ensurePluginsLoaded();
  }).catch((err) => {
    log.error("[Oboext] database init failed:", err);
    throw err;
  }));

  globalThis.__oboeLoaders = {
    ready,
    dispatch,
    documents,
    plugins: {
      ensureLoaded: () => ensurePluginsLoaded(),
    },
    pluginApi: {
      dispatch: (slug, path, request) => dispatchPluginApi(slug, path, request),
    },
    uploads: {
      serve: (pathname, method, acceptEncoding) => serveUpload(pathname, method, acceptEncoding),
    },
    // Safety net for the app's own compiled assets, linked as /public/** (admin.css, admin.js, comments.js, icons/**, theme-*.js, vendor/**).
    publicStatic: {
      serve: (pathname, method, acceptEncoding) => servePublic(pathname, method, acceptEncoding),
    },
    // Hook-based sitemap: buildSitemapDocument runs sitemap.urls + sitemap.document filters (sitemap-plus and friends extend it)
    sitemap: {
      document: (request) => buildSitemapDocument(request),
    },
    auth: {
      userFromRequest: (request) => getSessionFromRequest(request),
      hasAnyUser: () => hasAnyUser(),
    },

    security: {
      get: async () => {
        await ready();
        return getAdminSecurity();
      },
    },
    searchRedirect: async (q) => {
      await ready();
      return searchRedirect(q);
    },
    // Boot warmup's dynamic URLs (latest post, a category, a tag page): the prod server's warm loop renders these through the normal handler.
    // The prod server calls this inside ready.then(), which is the SERVER's
    // readiness - the DATABASE may still be mid-ensureDb(). Without awaiting
    // the db-level ready here the lookup threw db-used-before-ensureDb and a
    // silent catch shrank the warm list to the fixed routes: the dynamic
    // warmup (and everything built on it) never actually ran.
    warmUrls: async () => {
      await ready();
      // R274: warmEntityUrls now runs warmReadWave internally? No — it does
      // not; run the wave (which probes the pairing flag) before building
      // the URL list so a paired site boots with self-canonical /en.
      const { warmReadWave } = await import("@server/loaders");
      await warmReadWave();
      return warmEntityUrls();
    },
    // /admin <-> /admin/dashboard swap driven by the adminHomePath preference
    adminHome: {
      redirect: async (pathname) => {
        await ready();
        return homeRedirectFor(pathname, await getAdminMenuPrefs());
      },
    },
    themeStyle: {
      css: (slug) => themeCssContent(slug),
    },
    themeAssets: {
      serve: (rel, method) => serveThemeAsset(rel, method),
    },
    pluginAssets: {
      serve: (rel, method) => servePluginAsset(rel, method),
    },
  };

  // R161: the two guards below are about FAILURE SHAPES, not authorization.
  //   - a thrown loader used to escape this handler entirely and the framework
  //     answered with its HTML error page, so the browser's JSON.parse threw a
  //     second, unrelated error and the page silently bricked;
  //   - `d` is a client-supplied JSON blob parsed on every navigation - a
  //     multi-megabyte value is pure parse/GC work with no legitimate caller
  //     (the loaders' payloads are a handful of fields).
  const DATA_PAYLOAD_MAX = 8192;
  const jsonOut = (data, status = 200) =>
    new Response(JSON.stringify(data), {
      status,
      headers: {
        "content-type": "application/json; charset=utf-8",
        "cache-control": "no-store",
      },
    });

  export async function GET(request) {
    await ready();
    const u = new URL(request.url);
    const key = (u.searchParams.get("r") || "").slice(0, 200);
    const rawD = u.searchParams.get("d") || "{}";
    if (rawD.length > DATA_PAYLOAD_MAX) {
      return jsonOut({ error: "payload_too_large" }, 400);
    }
    let payload = {};
    try {
      payload = JSON.parse(rawD);
    } catch (e) {}
    const ctx = getContext();
    // The registry mixes public loaders (home, resolve, . ) with admin screens.
    if (key.indexOf("admin.") === 0 && !(ctx as Record<string, unknown>).user) {
      return jsonOut({ error: "unauthorized" }, 401);
    }
    let data;
    try {
      data = await dispatch(key, payload, ctx);
    } catch (err) {
      log.error("[Oboext] data dispatch failed for", key, err);
      return jsonOut({ error: "dispatch_failed" }, 500);
    }
    return jsonOut(data);
  }
</script>
