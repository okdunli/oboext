<script>
  // POST /api/auth/send-code { channel: "email"|"sms", target, purpose }
  //

  //

  import { jsonOk, jsonFail, readBody, apiGate } from "@server/admin";
  import { clientIp, hasAnyUser, findUserByContact, normalizeContactTarget } from "@server/auth";
  import { getNotifySettings, sendVerificationCode } from "@server/notify";
  import { getMemberSettings } from "@server/members";
  import { makeT, headerLocale } from "@server/i18n";

  export async function POST(request) {
    const t = makeT(headerLocale(request));
    return apiGate(async () => {
      const body = await readBody(request);
      const channel = body.channel === "sms" ? "sms" : "email";
      const purpose = String(body.purpose || "login");
      if (purpose !== "login" && purpose !== "register" && purpose !== "bind") {
        return jsonFail(t("api.no_entry"), 404);
      }
      if (!(await hasAnyUser())) return jsonFail(t("api.no_entry"), 404);

      const notify = await getNotifySettings();
      const ip = clientIp(request);

      if (purpose === "bind") {

        const me = getContext().user;
        if (!me) return jsonFail(t("api.unauthenticated"), 401);
        const channelReady = channel === "email" ? notify.email.enabled : notify.sms.enabled;
        if (!channelReady) return jsonFail(t("api.no_entry"), 404);
        const target = normalizeContactTarget(channel, String(body.target || ""));
        const owner = await findUserByContact(channel, target);
        if (owner && owner.id !== me.id) {
          return jsonFail(
            channel === "email"
              ? t("api.contact_taken_email")
              : t("api.contact_taken_phone"),
            409,
          );
        }
        const out = await sendVerificationCode({ channel, target, purpose: "bind", ip });
        return { sent: true, resendAfter: out.resendAfter };
      }

      if (purpose === "register") {
        const member = await getMemberSettings();
        if (!member.registerEnabled) return jsonFail(t("api.no_entry"), 404);
        const ready =
          channel === "email"
            ? notify.email.enabled && notify.register.emailVerify
            : notify.sms.enabled && notify.register.phoneVerify;
        if (!ready) return jsonFail(t("api.no_entry"), 404);
        const target = normalizeContactTarget(channel, String(body.target || ""));
        const out = await sendVerificationCode({
          channel,
          target,
          purpose: "register",
          ip,
        });
        return { sent: true, resendAfter: out.resendAfter };
      }

      const ready =
        channel === "email"
          ? notify.email.enabled && notify.login.emailVerify
          : notify.sms.enabled && notify.login.phoneVerify;
      if (!ready) return jsonFail(t("api.no_entry"), 404);

      const target = normalizeContactTarget(channel, String(body.target || ""));

      const user = await findUserByContact(channel, target);
      if (!user || user.status !== "active") return { sent: true };

      const out = await sendVerificationCode({
        channel,
        target,
        purpose: "login",
        ip,
      });
      return { sent: true, resendAfter: out.resendAfter };
    }, t);
  }
</script>
