<script>
  // Newsletter admin — the subscriber table + header stat cards + the failure
  // panel. All strings come catalog-baked through the loader
  // (newsletter.admin_*); the page binds no keys of its own.
  let d = $data(() =>
    __rvLoad("admin.newsletter", {
      page: __rvQs().get("page"),
    }),
  );
  // NB: {#each} compiles its expression as a zero-arg call, so iteration
  // targets must be function accessors, never bare arrays.
  function rows() {
    return d().items;
  }
  function stats() {
    return [1];
  }
  function statusLabel(s) {
    return s === "confirmed"
      ? d().s.badge_confirmed
      : s === "unsubscribed"
        ? d().s.badge_unsub
        : d().s.badge_pending;
  }
  function localeLabel(l) {
    return l === "en" ? "EN" : "中文";
  }
  function fmt(iso) {
    if (!iso) return "—";
    const dt = new Date(iso);
    const pad = (n) => String(n).padStart(2, "0");
    return dt.getFullYear() + "-" + pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) +
      " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes());
  }
  function hasPrev() {
    return d().page > 1;
  }
  function hasNext() {
    return d().page * d().limit < d().total;
  }
  function hasPager() {
    return d().total > d().limit || d().page > 1;
  }
  function emptyHint() {
    return rows().length ? [] : [1];
  }
  // each-predicate wrapper: same-kind blocks can't nest in .rose templates
  function pager() {
    return hasPager() ? [1] : [];
  }
  function href(p) {
    return "/admin/newsletter?page=" + p;
  }
  // Failure panel: the count drives both the stat card's colour and whether
  // the detail table + retry button render at all. Zero failures is the normal
  // state of a healthy site, so it must read as an ordinary number, not a
  // warning that trains the operator to ignore the colour.
  function failedCount() {
    return Number(d().failed) || 0;
  }
  function failedStyle() {
    return failedCount() > 0
      ? "border-color:rgba(220,38,38,.45);background:rgba(220,38,38,.08)"
      : "";
  }
  function failedValueStyle() {
    return failedCount() > 0 ? "color:#fca5a5" : "";
  }
  function failedBlock() {
    return failedCount() > 0 ? [1] : [];
  }
  function failures() {
    return d().failures || [];
  }
  // The catalog template carries {n} / {m}; these are this click's counts, so
  // the two placeholders are filled here exactly the way makeT fills them.
  function retryDone(n, m) {
    return String(d().s.retry_done).split("{n}").join(String(n)).split("{m}").join(String(m));
  }
  // Retry button: confirm -> POST /api/newsletter/retry -> toast the counts,
  // then re-read the page (the failure table is server-rendered from the
  // loader, so a reload is the only honest way to show the new set).
  //
  // onMount, not a bare IIFE: the compiler ships this route's client bundle
  // only when it sees a lifecycle call, and a zero-JS route never runs the
  // script in the browser at all (R246 / admin-export-bound). onMount is a
  // no-op on the server, so SSR stays clean.
  onMount(function () {
    const btn = document.querySelector("[data-adm-newsletter-retry]");
    if (!btn || btn.__nlRetryBound) return;
    btn.__nlRetryBound = true;
    btn.addEventListener("click", async function () {
      if (!confirm(d().s.retry_confirm)) return;
      btn.disabled = true;
      try {
        // CSRF rides the wrapper public/csrf.js installs over window.fetch.
        const r = await fetch("/api/newsletter/retry", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: "{}",
        });
        const data = r.ok ? await r.json() : null;
        if (!r.ok || !data || data.ok !== true) {
          throw new Error((data && data.error) || d().s.retry_error + "（" + r.status + "）");
        }
        const n = Number(data.retried) || 0;
        const m = Number(data.succeeded) || 0;
        if (typeof window.admToast === "function") {
          // Neutral tone for "nothing was waiting" (another tab or the sweeper
          // got there first) — it is not an error, it is the desired end state.
          window.admToast(n > 0 ? retryDone(n, m) : d().s.no_failed, n > 0 ? (m > 0 ? "ok" : "err") : "");
        }
        if (n > 0) {
          setTimeout(function () {
            window.location.reload();
          }, 900);
          return;
        }
      } catch (e) {
        if (typeof window.admToast === "function") {
          window.admToast(e instanceof Error ? e.message : d().s.retry_error, "err");
        }
      }
      btn.disabled = false;
    });
  });
</script>

<head>
  <title>Newsletter - 管理后台</title>
</head>

{#each stats() as _}
<div class="adm-grid adm-stats">
  <div class="adm-card adm-stat"><div class="k">{d().s.stat_total}</div><div class="v">{d().total}</div></div>
  <div class="adm-card adm-stat"><div class="k">{d().s.stat_confirmed}</div><div class="v">{d().confirmed}</div></div>
  <div class="adm-card adm-stat"><div class="k">{d().s.stat_unsub}</div><div class="v">{d().unsubscribed}</div></div>
  <div class="adm-card adm-stat" style={failedStyle()}><div class="k">{d().s.stat_failed}</div><div class="v" style={failedValueStyle()}>{failedCount()}</div></div>
</div>
{/each}

{#each failedBlock() as _}
<div class="adm-card" style="margin-bottom:16px" data-adm-newsletter-failed>
  <div class="adm-card-hd">
    <strong>{d().s.stat_failed}</strong>
    <span class="spacer"></span>
    <button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-adm-newsletter-retry>{d().s.retry}</button>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>{d().s.col_post}</th>
          <th style="width:220px">{d().s.col_email}</th>
          <th style="width:150px">{d().s.col_failed_at}</th>
        </tr>
      </thead>
      <tbody>
        {#each failures() as f}
        <tr>
          <td><div class="title">{f.title}</div></td>
          <td class="adm-hint">{f.email}</td>
          <td class="adm-hint">{fmt(f.failedAt)}</td>
        </tr>
        {/each}
      </tbody>
    </table>
  </div>
  <div class="adm-card-bd">
    <p class="adm-hint" style="margin:0">{d().s.failed_lead}</p>
  </div>
</div>
{/each}

<div class="adm-toolbar">
  <span class="adm-hint">{d().s.hint_mask}</span>
  <span style="flex:1"></span>
  <span class="adm-hint">共 {d().total} 条</span>
</div>

<div class="adm-card adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:220px">{d().s.col_email}</th>
        <th style="width:80px">{d().s.col_locale}</th>
        <th style="width:110px">{d().s.col_status}</th>
        <th style="width:150px">{d().s.col_created}</th>
      </tr>
    </thead>
    <tbody>
      {#each rows() as r}
      <tr>
        <td><div class="title">{r.email}</div></td>
        <td class="adm-hint">{localeLabel(r.locale)}</td>
        <td><span class={"adm-tag " + r.status}>{statusLabel(r.status)}</span></td>
        <td class="adm-hint">{fmt(r.createdAt)}</td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">{d().s.empty}</div>
  {/each}
</div>

{#each pager() as _}
<div class="adm-pager">
  第 {d().page} 页
  <span style="flex:1"></span>
  {#if hasPrev()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(d().page - 1)}>上一页</a>{/if}
  {#if hasNext()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(d().page + 1)}>下一页</a>{/if}
</div>
{/each}
