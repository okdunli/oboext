<script>

  import { apiGate, jsonFail, requireCap } from "@server/admin";
  import { buildDatabaseBackup, restoreDatabaseBackup } from "@server/backup";
  import { buildFullBackupZip, restoreFullBackupZip } from "@server/backup-zip";
  import { recordAdminAction } from "@server/security-events";
  import { gzipResponse } from "@server/http-compress";

  function compactStamp() {

    return new Date().toISOString().replace(/[-:T.Z]/g, "").slice(0, 14).replace(/^(\d{8})(\d{6})$/, "$1-$2");
  }

  export async function GET(request) {
    return apiGate(async () => {
      requireCap(getContext().user, "settings:manage");
      // R353: ?full=1 downloads the FULL backup - database.json PLUS every
      // file under content/uploads. The plain GET stays the DB-only JSON so
      // existing restores keep working byte for byte.
      if (new URL(request.url).searchParams.get("full") === "1") {
        const zip = await buildFullBackupZip();
        return new Response(zip, {
          status: 200,
          headers: {
            "content-type": "application/zip",
            "content-disposition": `attachment; filename="oboext-full-backup-${compactStamp()}.zip"`,
          },
        });
      }
      const backup = await buildDatabaseBackup();
      // The dump is text and grows with the site - same reason the exports are
      // gzipped. The full-backup zip above is already compressed, so it stays
      // as-is.
      return await gzipResponse(
        request,
        new Response(JSON.stringify(backup), {
          status: 200,
          headers: {
            "content-type": "application/json; charset=utf-8",
            "content-disposition": `attachment; filename="oboext-db-backup-${compactStamp()}.json"`,
          },
        }),
      );
    });
  }

  export async function POST(request) {
    return apiGate(async () => {
      requireCap(getContext().user, "settings:manage");
      let form;
      try {
        form = await request.formData();
      } catch {
        return jsonFail("恢复请求必须是 multipart 表单上传", 400);
      }
      if (form.get("confirm") !== "RESTORE") {
        return jsonFail("请输入确认词 RESTORE 后再执行恢复", 400);
      }
      const file = form.get("file");
      if (!(file instanceof File) || file.size === 0) {
        return jsonFail("请选择有效的备份文件", 400);
      }
      const bytes = Buffer.from(await file.arrayBuffer());
      // Zip backups (full) are told apart by magic bytes, not by filename.
      if (bytes.length >= 4 && bytes[0] === 0x50 && bytes[1] === 0x4b) {
        let full;
        try {
          full = await restoreFullBackupZip(bytes);
        } catch (e) {
          return jsonFail("全量备份恢复失败：" + (e instanceof Error ? e.message : String(e)), 400);
        }
        await recordAdminAction(getContext().user, "backup.restore", {
          tables: Object.keys(full.restored ?? {}),
          files: full.files,
          full: true,
        });
        return full;
      }
      let parsed;
      try {
        parsed = JSON.parse(bytes.toString("utf8"));
      } catch {
        return jsonFail("备份文件不是合法 JSON", 400);
      }
      const result = await restoreDatabaseBackup(parsed);
      await recordAdminAction(getContext().user, "backup.restore", {
        tables: Object.keys(result.restored ?? {}),
      });
      return result;
    });
  }
</script>
