<script>
  // Menu manager (port of components/MenuManager.tsx).
  let d = $data(() => __rvLoad("admin.menus", {}));
  function menus() {
    return d().menus || [];
  }
  function copy() {
    return d().s || {};
  }
  function activeMenu() {
    var ms = menus();
    return ms.length ? ms[0] : null;
  }
  // tree -> flat rows with depth + parentId, in display order
  function flatten(nodes, depth, parentId, out) {
    (nodes || []).forEach(function (n, i) {
      out.push({
        id: n.id,
        parentId: parentId,
        order: i,
        type: n.type || "custom",
        label: n.label || "",
        url: n.url || "",
        referenceSlug: n.referenceSlug || "",
        target: n.target || "_self",
        icon: n.icon || "",
        depth: depth,
      });
      if (n.children && n.children.length) flatten(n.children, depth + 1, n.id, out);
    });
    return out;
  }
  function rows() {
    var m = activeMenu();
    return m ? flatten(m.items, 0, null, []) : [];
  }
  function payload() {
    return JSON.stringify(d());
  }
  function refLabel(r) {
    return r.label || r.referenceSlug;
  }
  // {#if} predicates must be zero-arg function calls; keep all inline
  // comparisons behind named helpers.
  function menuIsRef(r) {
    return r.type !== "custom";
  }
  function menuIsCustom(r) {
    return r.type === "custom";
  }
  function menuIsIndented(r) {
    return r.depth > 0;
  }
  function refState(r) {
    return r.referenceSlug ? r.url || "" : "";
  }
  function indentStyle(r) {
    return "margin-left:" + r.depth * 20 + "px";
  }
  function depthLabel(r) {
    return "L" + (r.depth + 1);
  }
  function emptyClass() {
    // Hidden unconditionally on the server.
    return "adm-empty adm-menu-empty is-hidden";
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-menu" data-menu-manager data-menus={payload()}>
  <div class="adm-menu-head">
    <div class="adm-menu-tabs" data-menu-tabs>
      {#each menus() as m}
      <button type="button" class="adm-menu-tab" data-menu-tab data-id={m.id}>{m.name} <span class="adm-menu-loc">({m.location})</span></button>
      {/each}
    </div>
    <span class="adm-menu-auto">{copy().autosave}</span>
  </div>

  <p class="adm-menu-msg" data-menu-msg></p>

  <div class="adm-menu-rows" data-menu-rows>
    {#each rows() as r}
    <div class="adm-menu-row" data-menu-row style={indentStyle(r)}>
      <span class="adm-menu-depth">{depthLabel(r)}</span>
      <select class="adm-select adm-menu-type" data-f="type" aria-label={copy().typeLabel}>
        <option value="custom">{copy().customLink}</option>
        <option value="post">{copy().fromPosts}</option>
        <option value="page">{copy().fromPages}</option>
        <option value="category">{copy().fromCategories}</option>
        <option value="tag">{copy().fromTags}</option>
      </select>
      {#if (() => menuIsRef(r))()}
      <select class="adm-select adm-menu-ref" data-f="ref" aria-label={copy().refLabel}>
        <option value={r.referenceSlug}>{refLabel(r)}</option>
      </select>
      {/if}
      <input class="adm-input adm-menu-label" data-f="label" value={r.label} aria-label={copy().phLabel} placeholder={copy().phLabel}>
      {#if (() => menuIsCustom(r))()}
      <input class="adm-input adm-menu-url" data-f="url" value={r.url} aria-label={copy().phUrl} placeholder={copy().phUrl}>
      {/if}
      {#if (() => menuIsRef(r))()}
      <span class="adm-menu-mono" title={r.url}>{refState(r)}</span>
      {/if}
      <input class="adm-input adm-menu-icon" data-f="icon" data-icon-picker="compact" value={r.icon} aria-label={copy().phIcon} placeholder={copy().phIcon} title={copy().setIcon}>
      <div class="adm-menu-tools">
        <button type="button" class="adm-iconbtn" data-menu-act="up" title={copy().moveUp} aria-label={copy().moveUp}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/chevron-up.svg)"></span></button>
        <button type="button" class="adm-iconbtn" data-menu-act="down" title={copy().moveDown} aria-label={copy().moveDown}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/chevron-down.svg)"></span></button>
        <button type="button" class="adm-iconbtn" data-menu-act="indent" title={copy().indent} aria-label={copy().indent}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/corner-down-right.svg)"></span></button>
        {#if (() => menuIsIndented(r))()}
        <button type="button" class="adm-iconbtn" data-menu-act="outdent" title={copy().outdent} aria-label={copy().outdent}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/corner-up-left.svg)"></span></button>
        {/if}
        <button type="button" class="adm-iconbtn danger" data-menu-act="del" title={copy().delete} aria-label={copy().delete}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span></button>
      </div>
    </div>
    {/each}
  </div>

  <div class={emptyClass()} data-menu-empty>
    <div style="margin-bottom:8px;display:flex;justify-content:center"><span class="adm-ic" style="width:32px;height:32px;--i:url(/public/icons/compass.svg)"></span></div>
    <p>{copy().empty}</p>
  </div>

  <button type="button" class="adm-btn adm-btn-ghost adm-menu-add" data-menu-add><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/plus.svg)"></span>{copy().addItem}</button>
</div>
