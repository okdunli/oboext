<script>
  // Categories manager — port of <TaxonomyManager type="category" />.
  let d = $data(() => __rvLoad("admin.taxonomies", {}));
  function copy() {
    return d().s || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function cats() {
    return d().categories || [];
  }
  function topCats() {
    return cats().filter((c) => !c.parentId);
  }
  function parentName(c) {
    if (!c.parentId) return "—";
    const p = cats().find((x) => x.id === c.parentId);
    return p ? p.name : "—";
  }
  function descOf(c) {
    return c.description || "";
  }
  function iconOf(c) {
    return c.icon || "";
  }
  function parentOf(c) {
    return c.parentId || "";
  }
  function emptyHint() {
    return cats().length ? [] : [1];
  }
  function confirmDelete(c) {
    return hint("catConfirmDelete", { name: c.name });
  }
  function ic(n) {
    return '<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/' + n + '.svg)"></span>';
  }
  function catGlyph(c) {
    const v = (c.icon || "").trim();
    if (/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(v)) return ic(v);
    // Reject emoji / arbitrary glyphs: fall back to the folder icon so the
    // admin stays icon-consistent. The icon picker only offers SVG names.
    return ic("folder");
  }
  // Computed here because the rose compiler rejects a template {:else}.
  function taxNameClass(c) {
    return c.parentId ? "adm-tax-name is-child" : "adm-tax-name";
  }
</script>

<head>
  <title>{copy().catDocTitle}</title>
</head>

<form class="adm-card adm-tax-add adm-tax-add-cat" data-adm-form="create-category">
  <div class="adm-tax-fields">
    <div class="adm-field">
      <label>{copy().name}</label>
      <input class="adm-input" name="name" required placeholder={copy().catPhName}>
    </div>
    <div class="adm-field">
      <label>{copy().slugOptional}</label>
      <input class="adm-input" name="slug" placeholder={copy().catPhSlug}>
    </div>
    <div class="adm-field">
      <label>{copy().catParent}</label>
      <select class="adm-select" name="parentId">
        <option value="">{copy().catNoneTop}</option>
        {#each topCats() as c}
        <option value={c.id}>{c.name}</option>
        {/each}
      </select>
    </div>
    <div class="adm-field adm-tax-grow">
      <label>{copy().catDescOptional}</label>
      <input class="adm-input" name="description" placeholder={copy().catPhDesc}>
    </div>
    <div class="adm-field">
      <label>{copy().catIconOptional}</label>
      <input class="adm-input" name="icon" data-icon-picker placeholder={copy().catPhIcon}>
    </div>
  </div>
  <button class="adm-btn" type="submit">{@html ic("plus")} {copy().add}</button>
</form>

<div class="adm-toolbar" style="gap:8px;">
  <button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-op="delete" data-url="/api/categories" data-confirm={copy().catConfirmBulk}>{copy().catBulkDelete}</button>
</div>

<div class="adm-card adm-table-wrap adm-tax-table">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all" title={copy().selectAll}></th>
        <th style="width:32px"></th>
        <th>{copy().name}</th>
        <th style="width:24%">{copy().slug}</th>
        <th style="width:120px">{copy().catParent}</th>
        <th>{copy().description}</th>
        <th style="width:200px;text-align:right">{copy().actions}</th>
      </tr>
    </thead>
    <tbody>
      {#each cats() as c}
      <tr data-cat-id={c.id} data-parent-id={c.parentId || ""}>
        <td><input type="checkbox" class="adm-check" value={c.id}></td>
        <td class="adm-cat-td">
          <button type="button" class="adm-iconbtn adm-cat-ic" data-cat-icon-id={c.id} data-cat-icon-val={iconOf(c)} title={copy().catTitleIcon}>{@html catGlyph(c)}</button>
          <span class="adm-drag-handle" draggable="true" title={copy().catTitleDrag}>{@html ic("grip-vertical")}</span>
        </td>
        <td>
          <span class={taxNameClass(c)}>{c.name}</span>
        </td>
        <td><span class="adm-muted">{c.slug}</span></td>
        <td><span class="adm-muted">{parentName(c)}</span></td>
        <td><span class="adm-muted">{descOf(c)}</span></td>
        <td>
          <div class="row-actions">
            <a class="adm-iconbtn" href={"/blog/category/" + c.slug} target="_blank" title={copy().view}>
              {@html ic("external-link")}
            </a>
            <button
              type="button"
              class="adm-iconbtn"
              data-tax-edit
              data-id={c.id}
              data-name={c.name}
              data-slug={c.slug}
              data-description={descOf(c)}
              data-icon={iconOf(c)}
              data-parentid={parentOf(c)}
              title={copy().catTitleEdit}
            >{@html ic("pencil")} {copy().edit}</button>
            <button
              type="button"
              class="adm-iconbtn danger"
              data-adm-act="delete"
              data-url={"/api/categories/" + c.id}
              data-confirm={confirmDelete(c)}
              title={copy().delete}
            >{@html ic("trash-2")} {copy().delete}</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">{copy().catEmpty}</div>
  {/each}
</div>

<div class="adm-modal" data-tax-modal hidden>
  <div class="adm-modal-box">
    <form data-adm-form="edit-category">
      <div class="adm-modal-hd">
        <h2>{copy().catEditTitle}</h2>
        <button type="button" class="adm-modal-x" data-tax-cancel aria-label={copy().close}>{@html ic("x")}</button>
      </div>
      <div class="adm-modal-bd">
        <input type="hidden" name="id">
        <div class="adm-field">
          <label>{copy().name}</label>
          <input class="adm-input" name="name" required maxlength="100">
        </div>
        <div class="adm-field">
          <label>{copy().slugKeep}</label>
          <input class="adm-input" name="slug" maxlength="120">
        </div>
        <div class="adm-field">
          <label>{copy().catParent}</label>
          <select class="adm-select" name="parentId">
            <option value="">{copy().catNoneTop}</option>
            {#each topCats() as c}
            <option value={c.id}>{c.name}</option>
            {/each}
          </select>
        </div>
        <div class="adm-field">
          <label>{copy().description}</label>
          <textarea class="adm-textarea" name="description" rows="2" maxlength="500"></textarea>
        </div>
        <div class="adm-field">
          <label>{copy().icon}</label>
          <input class="adm-input" name="icon" data-icon-picker placeholder={copy().catPhIcon}>
        </div>
      </div>
      <div class="adm-modal-ft">
        <button type="button" class="adm-btn adm-btn-ghost" data-tax-cancel>{copy().cancel}</button>
        <button type="submit" class="adm-btn">{copy().save}</button>
      </div>
    </form>
  </div>
</div>
