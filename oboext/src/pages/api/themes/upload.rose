<script>
  // /api/themes/upload
  //   POST  multipart {file} — install a theme zip into themes/<slug> (settings:manage)
  import { apiGate, jsonFail, requireCap } from "@server/admin";
  import { installThemeZip } from "@server/themes";
  import { MAX_ZIP_BYTES } from "@server/package-install";

  export async function POST(request) {
    return apiGate(async () => {
      requireCap(getContext().user, "settings:manage");
      const form = await request.formData();
      const file = form.get("file");
      if (!(file instanceof File)) return jsonFail("请选择要上传的 zip 安装包", 400);
      if (!/\.zip$/i.test(file.name)) return jsonFail("只支持 .zip 格式的安装包", 400);
      const buf = Buffer.from(await file.arrayBuffer());
      if (buf.length > MAX_ZIP_BYTES) {
        return jsonFail(
          `安装包不能超过 ${Math.round(MAX_ZIP_BYTES / 1024 / 1024)}MB`,
          400,
        );
      }
      const row = await installThemeZip(buf);
      return new Response(JSON.stringify(row), {
        status: 201,
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }
</script>
