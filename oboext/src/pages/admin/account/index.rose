<script>

  let s = $data(() => __rvLoad("admin.account", {}));
  function v(k) {
    const x = s()[k];
    return x == null ? "" : x;
  }

  const SECTIONS = [
    { key: "profile", label: "个人信息" },
    { key: "password", label: "登录密码" },
    { key: "oauth", label: "第三方账号" },
  ];

  function initAccountNav() {
    const root = document.querySelector("[data-acc-panel]");
    if (!root) return;
    const list = root.querySelector("[data-acc-nav]");
    const body = root.querySelector("[data-acc-body]");
    if (!list || !body) return;

    function mark(key) {
      list.querySelectorAll("[data-sec]").forEach(function (b) {
        b.classList.toggle("is-active", b.getAttribute("data-sec") === key);
      });
    }

    list.innerHTML = SECTIONS.map(function (s) {
      return '<button type="button" class="adm-thp-navbtn" data-sec="' +
        s.key + '">' + s.label + "</button>";
    }).join("");

    list.addEventListener("click", function (e) {
      const btn = e.target.closest("[data-sec]");
      if (!btn) return;
      const sec = body.querySelector('[data-acc-sec="' + btn.getAttribute("data-sec") + '"]');
      if (!sec) return;
      mark(btn.getAttribute("data-sec"));
      sec.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    // Default to the first section: on a short page the last card never
    // reaches the top of the viewport, leaving the rail fully inactive.
    let ticking = false;
    function sync() {
      ticking = false;
      let current = SECTIONS[0].key;
      for (const s of SECTIONS) {
        const el = body.querySelector('[data-acc-sec="' + s.key + '"]');
        if (el && el.getBoundingClientRect().top <= 90) current = s.key;
      }
      mark(current);
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    sync();
  }

  // The script block also runs during SSR, where there is no document.
  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAccountNav);
    } else {
      initAccountNav();
    }
  }
</script>

<head>
  <title>我的账号 - 管理后台</title>
</head>

<div class="adm-thp" data-acc-panel>
  <div class="adm-thp-head">
    <div>
      <h1 class="adm-h1">我的账号</h1>
      <p class="adm-thp-desc">个人信息、登录密码与第三方账号绑定。</p>
    </div>
  </div>

  <div class="adm-thp-grid">
    <nav class="adm-thp-nav">
      <div class="adm-thp-navgroup">
        <div class="adm-thp-navtitle">账号设置</div>
        <div class="adm-thp-navlist" data-acc-nav></div>
      </div>
    </nav>

    <div class="adm-thp-body" data-acc-body>
      <section data-acc-sec="profile">
        <div class="adm-card">
          <div class="adm-card-hd"><strong style="font-size:14px;">个人信息</strong></div>
          <div class="adm-card-bd">
            <form data-adm-form="account-profile">
              <div class="adm-field">
                <label>昵称</label>
                <input class="adm-input" name="name" value={v('name')} maxlength="100" autocomplete="name" required>
              </div>
              <div class="adm-field">
                <label>邮箱（更换需验证码）</label>
                <input class="adm-input" type="email" name="email" value={v('email')} maxlength="120" autocomplete="email" required>
                <div style="display:flex;gap:8px;margin-top:8px;">
                  <input class="adm-input" name="emailCode" inputmode="numeric" maxlength="8" placeholder="邮箱验证码" style="flex:1;">
                  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="account-send" data-channel="email" style="flex-shrink:0;white-space:nowrap;">发送验证码</button>
                </div>
              </div>
              <div class="adm-field">
                <label>手机号（留空即解绑，换绑需验证码）</label>
                <input class="adm-input" type="tel" name="phone" value={v('phone')} maxlength="20" autocomplete="tel">
                <div style="display:flex;gap:8px;margin-top:8px;">
                  <input class="adm-input" name="phoneCode" inputmode="numeric" maxlength="8" placeholder="手机验证码" style="flex:1;">
                  <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="account-send" data-channel="sms" style="flex-shrink:0;white-space:nowrap;">发送验证码</button>
                </div>
              </div>
              <p class="adm-hint" style="margin:0 0 12px;" data-adm-msg></p>
              <button class="adm-btn" type="submit">保存修改</button>
            </form>
            <p class="adm-hint" style="margin:12px 0 0;">角色：<b style="color:var(--adm-text);">{v('role')}</b></p>
          </div>
        </div>
      </section>

      <section data-acc-sec="password">
        <div class="adm-card">
          <div class="adm-card-hd"><strong style="font-size:14px;">登录密码</strong></div>
          <div class="adm-card-bd">
            <form data-adm-form="account-password">
              {#if (() => !s().passwordless)()}
              <div class="adm-field">
                <label>当前密码</label>
                <input class="adm-input" type="password" name="currentPassword" autocomplete="current-password" required>
              </div>
              {/if}
              <div class="adm-field">
                <label>新密码</label>
                <input class="adm-input" type="password" name="newPassword" minlength="8" maxlength="200" autocomplete="new-password" required>
              </div>
              <div class="adm-field">
                <label>确认新密码</label>
                <input class="adm-input" type="password" name="confirmPassword" minlength="8" maxlength="200" autocomplete="new-password" required>
              </div>
              <p class="adm-hint" style="margin:0 0 12px;" data-adm-msg></p>
              <button class="adm-btn" type="submit">更新密码</button>
              {#if (() => s().passwordless)()}
              <p class="adm-hint" style="margin:10px 0 0;">当前账号尚未设置过密码（免密注册或第三方登录），直接设置新密码即可。</p>
              {/if}
            </form>
          </div>
        </div>
      </section>

      <section data-acc-sec="oauth">
        <div class="adm-card">
          <div class="adm-card-hd"><strong style="font-size:14px;">第三方账号</strong></div>
          <div class="adm-card-bd" data-oauth-bindings>
            <p class="adm-hint" style="margin:0;">加载中…</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>