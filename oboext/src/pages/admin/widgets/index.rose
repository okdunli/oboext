<script>
  // Widget manager (port of components/WidgetManager.tsx).
  let d = $data(() => __rvLoad("admin.widgets", {}));
  function copy() {
    return d().s || {};
  }

  function themes() {
    return d().themes || [];
  }
  function typeLabel(t) {
    const f = (d().types || []).find((x) => x.type === t);
    return f ? f.label : t;
  }
  function rowsOf(key) {
    return (d().widgets || [])
      .filter((w) => w.area === key)
      .sort((a, b) => a.order - b.order);
  }
  // Flat render stream: head -> row* -> (empty) -> picker(head -> type* ->
  // close) + add button -> tail, per area.
  function flat() {
    const out = [];
    (d().areas || []).forEach((a) => {
      const rows = rowsOf(a.key);
      out.push({ kind: "head", key: a.key, label: a.label, description: a.description || "", count: rows.length });
      rows.forEach((w, i) => {
        out.push({
          kind: "row",
          area: a.key,
          id: w.id,
          wtype: w.type,
          title: w.title || "",
          enabled: !!w.enabled,
          upDisabled: i === 0,
          downDisabled: i === rows.length - 1,
        });
      });
      if (!rows.length) out.push({ kind: "empty", area: a.key });
      out.push({ kind: "picker-head", area: a.key });
      (d().types || []).forEach((t) => {
        out.push({ kind: "type", area: a.key, wtype: t.type, tlabel: t.label, tdesc: t.description });
      });
      out.push({ kind: "tail", area: a.key });
    });
    return out;
  }
  function wgRowTitle(x) {
    return x.title || typeLabel(x.wtype) || x.wtype;
  }
  function wgRowClass(x) {
    return "adm-wg-row" + (x.enabled ? " is-on" : " is-off");
  }
  function wgUpClass(x) {
    return "adm-iconbtn" + (x.upDisabled ? " is-disabled" : "");
  }
  function wgDownClass(x) {
    return "adm-iconbtn" + (x.downDisabled ? " is-disabled" : "");
  }
  function wgEyeIcon(x) {
    return x.enabled ? "eye" : "eye-off";
  }
  function wgEyeTitle(x) {
    return x.enabled ? copy().hide : copy().show;
  }
  function ic(n, size) {
    size = size || 16;
    return '<span class="adm-ic" aria-hidden="true" style="width:' + size +
      "px;height:" + size + "px;--i:url(/public/icons/" + n + ".svg)\"></span>";
  }
  function payload() {
    return JSON.stringify(d());
  }
</script>

<head>
  <title>{copy().docTitle}</title>
</head>

<div class="adm-wg-head">
  <h1 class="adm-h1"><span class="adm-h1-ic"><span class="adm-ic" style="width:20px;height:20px;--i:url(/public/icons/puzzle.svg)"></span></span> {copy().title}</h1>
  <p class="adm-wg-intro">
    {copy().introArea}<span class="adm-wg-hl">{copy().introArea2}</span>{copy().introArea3}
    {copy().introPanel}
    <span class="adm-wg-hl-ok">{copy().introPanel2}</span>{copy().introPanel3}
  </p>
  <div class="adm-wg-toolbar">
    <div class="adm-wg-theme">
      <span class="adm-wg-theme-label">{copy().configTheme}</span>
      <div class="adm-wg-select-wrap">
        <select class="adm-select" data-wg-theme aria-label={copy().configTheme}>
          {#each themes() as t}
          <option value={t.slug}>{t.name}</option>
          {/each}
        </select>
      </div>
    </div>
    <p class="adm-wg-hint">{copy().perTheme}</p>
  </div>
</div>

<div class="adm-wg-grid" data-wg-manager data-wg={payload()}>
  {#each flat() as x}

  {#if (() => x.kind === "head")()}
  <section class="adm-wg-area">
    <div class="adm-wg-area-hd">
      <h3 class="adm-wg-area-title"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/layout-grid.svg)"></span> {x.label}
        <span class="adm-wg-key">{x.key}</span>
      </h3>
      <span class="adm-wg-count">{x.count}{x.count === 1 ? copy().countSuffixOne : copy().countSuffix}</span>
    </div>
    <p class="adm-wg-desc">{x.description}</p>
    <div class="adm-wg-rows">
  {/if}

  {#if (() => x.kind === "row")()}
      <div class={wgRowClass(x)} data-wg-id={x.id} data-wg-area={x.area}>
        <div class="adm-wg-arrows">
          <button type="button" class={wgUpClass(x)} data-wg-move="-1" title={copy().moveUp} aria-label={copy().moveUp}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/chevron-up.svg)"></span></button>
          <button type="button" class={wgDownClass(x)} data-wg-move="1" title={copy().moveDown} aria-label={copy().moveDown}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/chevron-down.svg)"></span></button>
        </div>
        <div class="adm-wg-info">
          <p class="adm-wg-name">{wgRowTitle(x)}</p>
          <p class="adm-wg-mono">{x.wtype}</p>
        </div>
        <button type="button" class="adm-iconbtn" data-wg-toggle title={wgEyeTitle(x)}>{@html ic(wgEyeIcon(x), 14)}</button>
        <button type="button" class="adm-iconbtn" data-wg-edit title={copy().settings}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/settings-2.svg)"></span></button>
        <button type="button" class="adm-iconbtn danger" data-wg-del title={copy().delete}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/trash-2.svg)"></span></button>
      </div>
  {/if}

  {#if (() => x.kind === "empty")()}
      <p class="adm-wg-empty">{copy().areaEmpty}</p>
  {/if}

  {#if (() => x.kind === "head")()}
    </div>
    <div class="adm-wg-picker" data-wg-picker data-wg-area={x.key} hidden>
      <div class="adm-wg-picker-hd">
        <span>{copy().pickType}</span>
        <button type="button" class="adm-iconbtn" data-wg-picker-x title={copy().cancel} aria-label={copy().cancel}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/x.svg)"></span></button>
      </div>
      <div class="adm-wg-picker-list">
  {/if}

  {#if (() => x.kind === "type")()}
        <button type="button" class="adm-wg-type" data-wg-add data-wg-area={x.area} data-type={x.wtype}>
          <span class="adm-wg-type-label">{x.tlabel}</span>
          <span class="adm-wg-type-desc">{x.tdesc}</span>
        </button>
  {/if}

  {#if (() => x.kind === "tail")()}
      </div>
    </div>
    <button type="button" class="adm-wg-addbtn" style="display:inline-flex;align-items:center;justify-content:center;gap:6px" data-wg-add-open data-wg-area={x.area}><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/plus.svg)"></span>{copy().add}</button>
  </section>
  {/if}

  {/each}
</div>
