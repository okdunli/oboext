<script>
  // Tags manager — port of <TaxonomyManager type="tag" />.
  let d = $data(() => __rvLoad("admin.taxonomies", {}));
  function copy() {
    return d().s || {};
  }
  function hint(key, vars) {
    let out = String(copy()[key] || "");
    for (const k of Object.keys(vars)) out = out.split("{" + k + "}").join(String(vars[k]));
    return out;
  }
  function tags() {
    return d().tags || [];
  }
  function emptyHint() {
    return tags().length ? [] : [1];
  }
  function ic(n) {
    return '<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/' + n + '.svg)"></span>';
  }
</script>

<head>
  <title>{copy().tagDocTitle}</title>
</head>

<form class="adm-card adm-tax-add" data-adm-form="create-tag">
  <div class="adm-tax-fields">
    <div class="adm-field">
      <label>{copy().name}</label>
      <input class="adm-input" name="name" required placeholder={copy().tagPhName}>
    </div>
    <div class="adm-field">
      <label>{copy().slugOptional}</label>
      <input class="adm-input" name="slug" placeholder={copy().tagPhSlug}>
    </div>
  </div>
  <button class="adm-btn" type="submit">{@html ic("plus")} {copy().add}</button>
</form>

<div class="adm-toolbar" style="gap:8px;">
  <button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-op="delete" data-url="/api/tags" data-confirm={copy().tagConfirmBulk}>{copy().tagBulkDelete}</button>
</div>

<div class="adm-card adm-table-wrap adm-tax-table">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all" title={copy().selectAll}></th>
        <th>{copy().name}</th>
        <th style="width:34%">{copy().slug}</th>
        <th style="width:200px;text-align:right">{copy().actions}</th>
      </tr>
    </thead>
    <tbody>
      {#each tags() as t}
      <tr>
        <td><input type="checkbox" class="adm-check" value={t.id}></td>
        <td>
          <span class="adm-tax-name">{@html ic("tags")}<span class="title">{t.name}</span></span>
        </td>
        <td><span class="adm-muted">{t.slug}</span></td>
        <td>
          <div class="row-actions">
            <a class="adm-iconbtn" href={"/blog/tag/" + t.slug} target="_blank" title={copy().view}>
              {@html ic("external-link")}
            </a>
            <button
              type="button"
              class="adm-iconbtn"
              data-tax-edit
              data-id={t.id}
              data-name={t.name}
              data-slug={t.slug}
              title={copy().tagTitleEdit}
            >{@html ic("pencil")} {copy().edit}</button>
            <button
              type="button"
              class="adm-iconbtn danger"
              data-adm-act="delete"
              data-url={"/api/tags/" + t.id}
              data-confirm={hint("tagConfirmDelete", { name: t.name })}
              title={copy().delete}
            >{@html ic("trash-2")} {copy().delete}</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">{copy().tagEmpty}</div>
  {/each}
</div>

<div class="adm-modal" data-tax-modal hidden>
  <div class="adm-modal-box">
    <form data-adm-form="edit-tag">
      <div class="adm-modal-hd">
        <h2>{copy().tagEditTitle}</h2>
        <button type="button" class="adm-modal-x" data-tax-cancel aria-label={copy().close}>{@html ic("x")}</button>
      </div>
      <div class="adm-modal-bd">
        <input type="hidden" name="id">
        <div class="adm-field">
          <label>{copy().name}</label>
          <input class="adm-input" name="name" required maxlength="100">
        </div>
        <div class="adm-field">
          <label>{copy().slugKeep}</label>
          <input class="adm-input" name="slug" maxlength="120">
        </div>
      </div>
      <div class="adm-modal-ft">
        <button type="button" class="adm-btn adm-btn-ghost" data-tax-cancel>{copy().cancel}</button>
        <button type="submit" class="adm-btn">{copy().save}</button>
      </div>
    </form>
  </div>
</div>
