{
  "name": "oboext",
  "version": "0.3.1",
  "license": "MIT",
  "description": "Fast & lightweight self-hosted dynamic content management system engine with tiny footprint, built-in admin panel and smooth content editing.",
  "type": "module",
  "files": [
    "oboext",
    "dist",
    "themes",
    "plugins",
    "db",
    "tools/build.mjs",
    "tools/serve.mjs",
    "tools/gen.mjs",
    "tools/make-sums.mjs",
    "tools/benchmark-routes.mjs",
    "tools/deploy-automation.mjs",
    "tools/build-svg-sprite.mjs",
    "tools/export-native.mts",
    "tools/export-style.mts",
    "index.js",
    "main.go",
    "go.mod",
    "vercel.json",
    "tsconfig.json",
    ".env.example"
  ],
  "scripts": {
    "gen": "node tools/gen.mjs",
    "export:native": "node --import tsx tools/export-native.mts",
    "dev": "node tools/serve.mjs dev",
    "build": "node tools/build.mjs build",
    "preview": "node tools/serve.mjs preview",
    "build:go": "go build -o oboext-server .",
    "optimize": "node tools/build-svg-sprite.mjs",
    "deploy": "node tools/deploy-automation.mjs",
    "analyze": "node tools/benchmark-routes.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.24.0",
    "graphql": "^17.0.2",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "rosezm": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
