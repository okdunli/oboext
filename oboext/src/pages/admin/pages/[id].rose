<script>
  // Page editor (new + existing), same blocks editor as posts.
  let id = $state("");
  let d = $data(() => __rvLoad("admin.page", { id: id() }));

  function pg() {
    return d().page;
  }
  function isNew() {
    return !d().page;
  }
  function val(f) {
    const x = d().page;
    return x && x[f] != null ? x[f] : "";
  }
  function parentVal() {
    const x = d().page;
    return x && x.parentId != null ? x.parentId : "";
  }
  function isLive() {
    const x = d().page;
    return !!x && x.status === "published";
  }
  function pageUrl() {
    const x = d().page;
    return x ? x.url : "#";
  }
  function deleteUrl() {
    const x = d().page;
    return x ? "/api/pages/" + x.id : "";
  }
  function pageDataAttr() {
    return JSON.stringify(d());
  }
  if (typeof document !== "undefined") {
    const revBox = document.querySelector('[data-adm-revisions="page"]');
    if (revBox) {
      const targetId = Number(revBox.getAttribute("data-adm-rev-id"));
      const list = revBox.querySelector("[data-adm-rev-list]");
      let before = null;
      const fmt = (iso) => {
        const dt = new Date(iso);
        if (Number.isNaN(dt.getTime())) return "";
        const pad = (n) => String(n).padStart(2, "0");
        return pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) + " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes());
      };
      const statusLabel = (s) => (s === "published" ? "已发布" : s === "draft" ? "草稿" : s === "archived" ? "归档" : s);
      async function load() {
        const qs = new URLSearchParams({ kind: "page", targetId: String(targetId) });
        if (before) qs.set("before", String(before));
        const r = await fetch("/api/revisions?" + qs.toString(), { credentials: "same-origin" });
        if (!r.ok) {
          list.innerHTML = '<div class="adm-hint">历史版本加载失败（' + r.status + "）</div>";
          return;
        }
        const data = await r.json();
        if (!data.items.length && !list.querySelector(".adm-rev-row")) {
          list.innerHTML = '<div class="adm-hint">暂无历史版本，保存后自动生成</div>';
          return;
        }
        for (const it of data.items) {
          const row = document.createElement("div");
          row.className = "adm-rev-row";
          const time = document.createElement("span");
          time.className = "adm-rev-time";
          time.textContent = fmt(it.createdAt);
          const title = document.createElement("span");
          title.className = "adm-rev-title";
          title.textContent = it.title || "（无标题）";
          const st = document.createElement("span");
          st.className = "adm-rev-status";
          st.textContent = statusLabel(it.status);
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "adm-btn adm-btn-ghost adm-btn-sm";
          btn.textContent = "回滚到此版本";
          btn.addEventListener("click", async () => {
            if (!confirm("回滚到「" + (it.title || "无标题") + "」（" + fmt(it.createdAt) + "）？当前版本会先自动留存，可再次回滚。")) return;
            btn.disabled = true;
            const pr = await fetch("/api/revisions", {
              method: "POST",
              credentials: "same-origin",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ kind: "page", targetId, revisionId: it.id }),
            });
            if (!pr.ok) {
              alert("回滚失败：" + (await pr.text()).slice(0, 160));
              btn.disabled = false;
              return;
            }
            location.reload();
          });
          row.appendChild(time);
          row.appendChild(title);
          row.appendChild(st);
          row.appendChild(btn);
          list.appendChild(row);
        }
        before = data.nextBefore;
        if (before) {
          const more = document.createElement("button");
          more.type = "button";
          more.className = "adm-btn adm-btn-sm";
          more.textContent = "加载更早版本";
          more.addEventListener("click", () => {
            more.remove();
            load();
          });
          list.appendChild(more);
        }
      }
      load();
    }
  }
</script>

<head>
  <title>编辑页面 - 管理后台</title>
</head>

<form data-adm-editor data-adm-form="page" data-page={pageDataAttr()}>
  <div class="adm-toolbar">
    <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/admin/pages"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/arrow-left.svg)"></span>页面列表</a>
    <span style="flex:1"></span>
    {#if isLive()}
    <a class="adm-btn adm-btn-ghost adm-btn-sm" href={pageUrl()} target="_blank">查看页面<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span></a>
    {/if}
    {#if !isNew()}
    <button
      type="button"
      class="adm-btn adm-btn-danger adm-btn-sm"
      data-adm-act="delete"
      data-url={deleteUrl()}
      data-confirm="确认删除这个页面？此操作不可撤销。"
    >删除</button>
    {/if}
    <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm" data-save-as="draft">存为草稿</button>
    <button type="submit" class="adm-btn adm-btn-sm" data-save-as="">保存</button>
    <button type="submit" class="adm-btn adm-btn-green adm-btn-sm" data-save-as="published">发布</button>
  </div>

  <div class="adm-grid adm-cols-editor">
    <div>
      <div class="adm-card">
        <div class="adm-card-bd">
          <input
            class="adm-input adm-title-input"
            name="title"
            placeholder="请输入页面标题"
            value={val('title')}
          >
          <div class="adm-permalink">
            <span>固定链接：</span>
            <input name="slug" placeholder="留空则按标题自动生成" value={val('slug')}>
          </div>
          <textarea
            class="adm-textarea"
            name="excerpt"
            rows="2"
            placeholder="摘要（留空则自动从正文提取）"
            data-dv={val('excerpt')}
          ></textarea>
        </div>
      </div>

      <div class="adm-card" style="margin-top:16px">
        <div class="adm-card-bd">
          <div class="adm-card-hd" style="padding:0 0 12px;border-bottom:none">
            <strong>正文区块</strong>
            <span class="spacer"></span>
            <span class="adm-hint">段落、标题、图片、引用等可自由拖拽排序</span>
          </div>
          <div class="adm-blocks"></div>
          <div class="adm-block-add">
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="paragraph"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/pilcrow.svg)"></span>段落</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="heading"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/heading.svg)"></span>标题</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="image"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/image.svg)"></span>图片</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="quote"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/quote.svg)"></span>引用</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="code"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/code.svg)"></span>代码</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="list"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/list.svg)"></span>列表</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="divider"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/minus.svg)"></span>分割线</button>
            <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-block" data-type="html"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/code-xml.svg)"></span>HTML</button>
          </div>
        </div>
      </div>
    </div>

    <div class="adm-side-sticky">
      <div class="adm-card">
        <div class="adm-card-hd"><strong>发布</strong></div>
        <div class="adm-card-bd">
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">状态</span>
            <select class="adm-select" name="status">
              <option value="draft">草稿</option>
              <option value="published">已发布</option>
              <option value="archived">已归档</option>
            </select>
          </div>
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">发布时间</span>
            <input class="adm-input" type="datetime-local" name="publishedAt" value="">
            <div class="adm-hint" style="margin-top:4px">草稿设为未来时间即定时发布，到点自动上线；留空按保存时间。</div>
          </div>
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">评论</span>
            <select class="adm-select" name="commentStatus">
              <option value="open">开放评论</option>
              <option value="closed">关闭评论</option>
            </select>
          </div>
          <div class="adm-field" style="margin-bottom:12px">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">父页面</span>
            <input class="adm-input" type="number" name="parentId" min="1" placeholder="父页面 ID（可选）" value={parentVal()}>
          </div>
          <div class="adm-field" style="margin-bottom:0">
            <span style="display:block;font-size:13px;color:var(--adm-muted);margin-bottom:6px">特色图 URL</span>
            <input class="adm-input" name="featuredImage" placeholder="https://…" value={val('featuredImage')}>
          </div>
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>SEO</strong></div>
        <div class="adm-card-bd">
          <input class="adm-input" name="seoTitle" placeholder="SEO 标题" value={val('seoTitle')} style="margin-bottom:10px">
          <textarea
            class="adm-textarea"
            name="seoDescription"
            rows="2"
            placeholder="SEO 描述"
            data-dv={val('seoDescription')}
          ></textarea>
          <input class="adm-input" name="seoKeywords" placeholder="SEO 关键词，逗号分隔" value={val('seoKeywords')} style="margin-top:10px">
        </div>
      </div>

      <div class="adm-card">
        <div class="adm-card-hd"><strong>自定义字段</strong></div>
        <div class="adm-card-bd">
          <div class="adm-metas" data-adm-metas></div>
          <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="add-meta" style="margin-top:8px"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/plus.svg)"></span>添加字段</button>
        </div>
      </div>
    </div>
  </div>
</form>

{#if !isNew()}
<div class="adm-card" style="margin-top:16px" data-adm-revisions="page" data-adm-rev-id={pg().id}>
  <div class="adm-card-hd"><strong>历史版本</strong><span class="adm-hint" style="margin-left:auto">每次保存自动留存，可回滚；回滚前会先保存当前版本</span></div>
  <div class="adm-card-bd">
    <div class="adm-rev-list" data-adm-rev-list></div>
  </div>
</div>
{/if}
