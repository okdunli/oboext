<script>
  // Comment moderation — reads the live DB per request. Actions go through
  // /api/comments/:id (PATCH status | DELETE) via admin.js delegation.
  let d = $data(() =>
    __rvLoad("admin.comments", {
      status: __rvQs().get("status") || "",
      page: __rvQs().get("page"),
      after: __rvQs().get("after") || "",
    }),
  );
  // NB: {#each} compiles its expression as a zero-arg call, so iteration
  // targets must be function accessors, never bare arrays.
  function rows() {
    return d().items;
  }
  function fmt(iso) {
    if (!iso) return "—";
    const dt = new Date(iso);
    const pad = (n) => String(n).padStart(2, "0");
    return dt.getFullYear() + "-" + pad(dt.getMonth() + 1) + "-" + pad(dt.getDate()) +
      " " + pad(dt.getHours()) + ":" + pad(dt.getMinutes());
  }
  function label(s) {
    return s === "published" ? "已通过" : s === "pending" ? "待审核" : "垃圾";
  }
  function tabClass(s) {
    return (__rvQs().get("status") || "") === s ? "is-active" : "";
  }
  function hasPrev() {
    return d().page > 1;
  }
  function hasNext() {
    return d().page * d().limit < d().total;
  }
  function hasPager() {
    return d().total > d().limit || d().page > 1;
  }
  function emptyHint() {
    return rows().length ? [] : [1];
  }
  // each-predicate wrapper: same-kind blocks can't nest in .rose templates
  function pager() {
    return hasPager() ? [1] : [];
  }
  function statusQ() {
    return __rvQs().get("status") || "";
  }
  function href(p) {
    return "/admin/comments?page=" + p + (statusQ() ? "&status=" + statusQ() : "");
  }
  // 实时：应用侧长轮询 /api/admin-stream —— 三种运行形态（dev / preview /
  // dist/prod.mjs）唯一都通的通道。框架的 store 广播在这里**故意不用**（prod
  // 未挂载该端点 → 落到 SPA fallback 的 HTML → 无限重连风暴；且它的开关是
  // 全应用级脚本原文匹配，连注释字样都算）。tests 里有全站守卫钉死。
  // 节流：5s 窗口 leading+trailing；时间戳挂 window（脚本随重渲重跑）。

  function adminEvtNudge() {
    const now = Date.now();
    const last = window.__rosezmAdminEvt || 0;
    if (now - last >= 5000) {
      window.__rosezmAdminEvt = now;
      if (window.__rosezmAdminEvtT) {
        clearTimeout(window.__rosezmAdminEvtT);
        window.__rosezmAdminEvtT = 0;
      }
      refresh();
    } else if (!window.__rosezmAdminEvtT) {
      // 尾沿：窗口内被抑制的事件在窗口结束时补一次——纯前沿会把本集群最后
      // 一条评论丢到下一个事件（B 自己的动作开窗 → A 随后的评论不可见）。
      window.__rosezmAdminEvtT = setTimeout(function () {
        window.__rosezmAdminEvtT = 0;
        window.__rosezmAdminEvt = Date.now();
        refresh();
      }, 5000 - (now - last));
    }
  }

  onMount(function () {
    // 长轮询循环（生产形态唯一可用通道，见 /api/admin-stream 顶部说明）。
    // 每次答复后立刻重发；401/网络错误退避 5s→10s→30s。
    const POLL_MS = 4000;
    let stopped = false;
    let since = 0;
    let backoff = 5000;
    let timer = 0;
    const ctl = typeof AbortController !== "undefined" ? new AbortController() : null;
    function step(delay) {
      if (stopped) return;
      if (delay) {
        timer = setTimeout(run, delay);
        return;
      }
      run();
    }
    function run() {
      if (stopped) return;
      const url = "/api/admin-stream?since=" + since;
      fetch(url, ctl ? { signal: ctl.signal, headers: { accept: "application/json" } } : undefined)
        .then(function (r) {
          if (!r.ok) throw new Error("stream " + r.status);
          backoff = 5000;
          return r.json();
        })
        .then(function (d) {
          if (stopped) return;
          if (d && typeof d.ver === "number") since = d.ver;
          if (d && d.events > 0) {
            adminEvtNudge();
            step(); // 还有新事件就立刻再问，连点即收敛
          } else {
            step(POLL_MS); // 空闲：按间隔轮询
          }
        })
        .catch(function () {
          if (stopped) return;
          step(backoff);
          backoff = Math.min(backoff * 2, 30000);
        });
    }
    step(0);
    onCleanup(function () {
      stopped = true;
      if (timer) clearTimeout(timer);
      if (ctl) ctl.abort();
    });
  });
</script>

<head>
  <title>评论 - 管理后台</title>
</head>

<div class="adm-toolbar">
  <div class="adm-tabs">
    <a class={tabClass("")} href="/admin/comments">全部</a>
    <a class={tabClass("pending")} href="/admin/comments?status=pending">待审核</a>
    <a class={tabClass("published")} href="/admin/comments?status=published">已通过</a>
    <a class={tabClass("spam")} href="/admin/comments?status=spam">垃圾</a>
  </div>
  <span style="flex:1"></span>
  <span class="adm-hint">共 {d().total} 条</span>
</div>

<div class="adm-toolbar" style="gap:8px;">
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/comments/bulk" data-op="published">批量通过</button>
  <button class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="bulk" data-url="/api/comments/bulk" data-op="spam">标为垃圾</button>
  <button class="adm-btn adm-btn-danger adm-btn-sm" data-adm-act="bulk" data-url="/api/comments/bulk" data-op="delete">批量删除</button>
</div>

<div class="adm-card adm-table-wrap">
  <table class="adm-table">
    <thead>
      <tr>
        <th style="width:34px"><input type="checkbox" data-adm-act="check-all"></th>
        <th style="width:150px">作者</th>
        <th>评论</th>
        <th style="width:170px">所属文章</th>
        <th style="width:80px">状态</th>
        <th style="width:130px">日期</th>
        <th style="width:210px"></th>
      </tr>
    </thead>
    <tbody>
      {#each rows() as c}
      <tr>
        <td><input type="checkbox" class="adm-check" value={c.id}></td>
        <td>
          <div class="title">{c.authorName || "匿名"}</div>
          <div class="sub">{c.authorEmail || ""}</div>
        </td>
        <td style="max-width:380px">
          <div style="white-space:pre-wrap;line-height:1.6">{esc(c.content)}</div>
        </td>
        <td class="adm-hint">{c.postTitle}</td>
        <td><span class={"adm-tag " + c.status}>{label(c.status)}</span></td>
        <td class="adm-hint">{fmt(c.createdAt)}</td>
        <td>
          <div class="row-actions" style="flex-wrap:wrap;gap:4px">
            <button class="adm-iconbtn" data-adm-act="comment" data-id={c.id} data-what="published">通过</button>
            <button class="adm-iconbtn" data-adm-act="comment" data-id={c.id} data-what="pending">待审</button>
            <button class="adm-iconbtn" data-adm-act="comment" data-id={c.id} data-what="spam">垃圾</button>
            <button class="adm-iconbtn danger" data-adm-act="comment" data-id={c.id} data-what="delete">删除</button>
          </div>
        </td>
      </tr>
      {/each}
    </tbody>
  </table>
  {#each emptyHint() as _}
  <div class="adm-empty">这里还没有评论。</div>
  {/each}
</div>

{#each pager() as _}
<div class="adm-pager">
  第 {d().page} 页
  <span style="flex:1"></span>
  {#if hasPrev()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(d().page - 1)}>上一页</a>{/if}
  {#if hasNext()}<a class="adm-btn adm-btn-ghost adm-btn-sm" href={href(d().page + 1)}>下一页</a>{/if}
</div>
{/each}
