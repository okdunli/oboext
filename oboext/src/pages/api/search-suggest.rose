<script>
  // /api/search-suggest?q=KEYWORD  Public, unauthenticated live search suggestions
  // for the nav search popover.
  //
  // ?format=opensearch answers the SAME rows in the OpenSearch Suggestions
  // shape — ["query", ["term", …], ["", …], ["/blog/slug", …]] — so a browser
  // that installed the site as a search engine (see /opensearch.xml) gets a
  // suggest list while typing. Two shapes, one scan: the memoized payload is
  // shared, the projection differs.
  import { listPosts, suggestDedupe, suggestHighlight } from "@server/queries";
  import { searchPublishedPages } from "@server/pages";
  import { memoQuery } from "@server/cache";
  import { headerLocale, localeHref } from "@server/i18n";

  // R156: the popover fires on every keystroke (debounced), and the search
  // itself is an ILIKE '%…%' scan - the most expensive public query in the app.
  // Two guards:
  //   1. MIN_Q: the client (pjax.js S=2) already waits for two characters, but
  //      that is browser-side only - a bot hitting ?q=a triggers the WORST
  //      pattern ('%a%' matches nearly everything). A one-character query
  //      answers empty here, so the scan never runs.
  //   2. MAX_Q: bounds the pattern length of a paste bomb (terms are already
  //      capped at 8 by searchTerms; a 10KB single term was still 10KB of ILIKE).
  const MIN_Q = 2;
  const MAX_Q = 120;

  // The answer is per-published-post and identical for every visitor (no user
  // state), so the browser may keep it briefly: 30s is shorter than the 20s
  // memo it sits on plus one keystroke round trip, which makes a re-typed
  // prefix free without serving anything a publish would have changed.
  const CACHE = "public, max-age=30";

  function json(data, status = 200, type = "application/json; charset=utf-8") {
    return new Response(JSON.stringify(data), {
      status,
      // A 500 is transient - caching it would blank the popover for 30s.
      headers: {
        "content-type": type,
        "cache-control": status >= 400 ? "no-store" : CACHE,
      },
    });
  }

  export async function GET(request) {
    // R477: the popover on the /en tree offered zh URLs for both kinds - the
    // request locale has to ride every link, exactly like the loaders do.
    const locale = headerLocale(request);
    const url = new URL(request.url);
    const format = url.searchParams.get("format") === "opensearch" ? "opensearch" : "ui";
    // A NUL (or any C0 control) is not valid in a Postgres text parameter; it
    // used to reach the scan and surface as a 500 on a public endpoint.
    const q = (url.searchParams.get("q") || "")
      .replace(/[\u0000-\u001f\u007f]/g, "")
      .trim()
      .slice(0, MAX_Q);
    // Too short to scan: each shape still answers in its own empty form.
    if (q.length < MIN_Q) {
      return format === "opensearch"
        ? json([q, [], [], []], 200, "application/x-suggestions+json; charset=utf-8")
        : json({ items: [], total: 0 });
    }
    try {
      // R156: memoized 20s per normalized query. Typing is a PREFIX walk -
      // "ja", "jav", "java" are separate requests but the same few prefixes are
      // re-typed by every visitor, so the minute's popular prefixes cost one
      // scan each. ILIKE is case-insensitive, so the key lowercases.
      // invalidateContentCaches drops the `sq:` prefix, so a publish shows up
      // on the next keystroke, not after the TTL.
      // Locale is part of the key: the items now carry locale-prefixed URLs
      // (R477), so a shared key would hand zh links to the en tree and back.
      const payload = await memoQuery(`sq:suggest:${locale}:${q.toLowerCase()}`, 20_000, async () => {
        const [{ items, total }, pageHits] = await Promise.all([
          listPosts({
            status: "published",
            search: q,
            // Two or three rows go out of five to one title: over-fetch so the
            // de-dup still fills the popover instead of shortening it.
            limit: 10,
            // The popover belongs to the reader's language tree: an /en
            // reader must not see a Chinese post among the suggestions.
            locale: locale === "en" ? "en" : "zh-CN",
          }),
          // R414: a reader searching "about"/"pricing" wants the PAGE, not a
          // post that mentions it. Pages follow the posts and share the five
          // slots; `total` stays the post count so the search page (posts only)
          // never claims results it cannot show.
          searchPublishedPages(q, 5, locale),
        ]);
        const rows = suggestDedupe(items || []).slice(0, 5);
        const seen = new Set(rows.map((r) => r.url));
        const pageRows = pageHits
          .filter((p) => !seen.has(p.url))
          .map((p) => ({
            id: p.id,
            title: p.title,
            url: localeHref(p.url, locale),
            // A page with a cover gets the same thumbnail slot a post does.
            thumbnail: p.featuredImage || null,
            hl: suggestHighlight(p.title ?? "", q),
            kind: "page",
          }));
        return {
          items: [
            ...rows.map((p) => ({
              id: p.id,
              title: p.title,
              url: localeHref(p.url, locale),
              thumbnail: p.featuredImage || null,
              hl: suggestHighlight(p.title ?? "", q),
              kind: "post",
            })),
            ...pageRows,
          ].slice(0, 5),
          total: total || 0,
        };
      });
      if (format === "opensearch") {
        // OpenSearch Suggestions: [query, [titles], [descriptions], [urls]].
        // The title still carries the / highlight marks the DOM
        // popover renders; a browser's suggest list shows them as-is, so strip
        // them here and keep the plain title.
        const plain = (t) => String(t).replace(/[]/g, "");
        const rows = payload.items || [];
        return json(
          [q, rows.map((r) => plain(r.title)), rows.map(() => ""), rows.map((r) => r.url)],
          200,
          "application/x-suggestions+json; charset=utf-8",
        );
      }
      return json(payload);
    } catch (e) {
      return json(format === "opensearch" ? [q, [], [], []] : { items: [], total: 0 }, 500);
    }
  }
</script>
