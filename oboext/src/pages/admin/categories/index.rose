<script>
  // Categories: create/edit/delete against /api/categories. The page reads

  // submit flips between POST (new) and PUT (existing).
  let d = $data(() => __rvLoad("admin.taxonomies", {}));
  function cats() {
    return d().categories || [];
  }
  function parentName(c) {
    if (!c.parentId) return "—";
    const p = cats().find((x) => x.id === c.parentId);
    return p ? p.name : "—";
  }
  // attribute-safe accessors (no quotes inside the template expression)
  function descOf(c) {
    return c.description || "";
  }
  function iconOf(c) {
    return c.icon || "";
  }
  function parentOf(c) {
    return c.parentId || "";
  }
  function emptyHint() {
    return cats().length ? [] : [1];
  }
  function confirmDelete(c) {
    return "确认删除分类「" + c.name + "」？子分类会提升为顶级分类。";
  }
</script>

<head>
  <title>分类 - 管理后台</title>
</head>

<div class="adm-grid adm-cols-2">
  <div class="adm-card">
    <div class="adm-card-hd"><strong id="cat-form-title">新增分类</strong></div>
    <div class="adm-card-bd">
      <form data-adm-form="create-category" data-add-label="新增分类">
        <input type="hidden" name="id">
        <div class="adm-field">
          <label>名称</label>
          <input class="adm-input" name="name" required placeholder="例如：技术随笔">
        </div>
        <div class="adm-field">
          <label>别名（slug）</label>
          <input class="adm-input" name="slug" placeholder="留空按名称自动生成">
        </div>
        <div class="adm-field">
          <label>描述</label>
          <textarea class="adm-textarea" name="description" rows="3" placeholder="分类说明（可选）"></textarea>
        </div>
        <div class="adm-form-grid">
          <div class="adm-field">
            <label>图标</label>
            <input class="adm-input" name="icon" placeholder="emoji 或图标名">
          </div>
          <div class="adm-field">
            <label>父分类</label>
            <select class="adm-select" name="parentId">
              <option value="">无（顶级分类）</option>
              {#each cats() as c}
              <option value={c.id}>{c.name}</option>
              {/each}
            </select>
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:6px">
          <button class="adm-btn" type="submit">新增分类</button>
          <button class="adm-btn adm-btn-ghost" type="button" data-adm-act="tax-new" data-form='[data-adm-form="create-category"]'>取消编辑</button>
        </div>
      </form>
    </div>
  </div>

  <div class="adm-card adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>名称</th>
          <th style="width:110px">父分类</th>
          <th style="width:120px"></th>
        </tr>
      </thead>
      <tbody>
        {#each cats() as c}
        <tr>
          <td>
            <div class="title">{c.icon ? c.icon + " " : ""}{c.name}</div>
            <div class="sub">/{c.slug}{c.description ? " · " + c.description : ""}</div>
          </td>
          <td class="adm-hint">{parentName(c)}</td>
          <td>
            <div class="row-actions">
              <a class="adm-iconbtn" href={"/blog/category/" + c.slug} target="_blank">查看</a>
              <button
                class="adm-iconbtn"
                data-adm-act="tax-edit"
                data-form='[data-adm-form="create-category"]'
                data-id={c.id}
                data-name={c.name}
                data-slug={c.slug}
                data-description={descOf(c)}
                data-icon={iconOf(c)}
                data-parentid={parentOf(c)}
              >编辑</button>
              <button
                class="adm-iconbtn danger"
                data-adm-act="delete"
                data-url={"/api/categories/" + c.id}
                data-confirm={confirmDelete(c)}
              >删除</button>
            </div>
          </td>
        </tr>
        {/each}
      </tbody>
    </table>
    {#each emptyHint() as _}
    <div class="adm-empty">还没有分类，在左侧创建第一个吧。</div>
    {/each}
  </div>
</div>
