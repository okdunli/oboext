<script>
  // First-run setup: GET reports whether the instance still needs its first admin; POST creates that admin, bootstraps site info.
  import { apiGate, jsonFail, readBody, bootstrapSiteSettings } from "@server/admin";
  import { hasAnyUser, createFirstAdmin } from "@server/auth";
  import { passwordError } from "@server/password-policy";
  import { sessionCookiePair, withCookies } from "@server/csrf";
  import { makeT, headerLocale } from "@server/i18n";

  export async function GET() {
    return apiGate(async () => {
      const needs = !(await hasAnyUser());
      return new Response(JSON.stringify({ needsSetup: needs, setupRequired: needs }), {
        headers: { "content-type": "application/json; charset=utf-8" },
      });
    });
  }

  export async function POST(request) {
    // The installer is the ONE anonymous surface with no locale cookie yet:
    // the request translator comes from the x-locale header the installer
    // stamps (its own language was detected from Accept-Language).
    const t = makeT(headerLocale(request));
    return apiGate(async () => {
      if (await hasAnyUser()) return jsonFail(t("api.setup_already"), 403);
      const body = await readBody(request);
      const email = String(body.email || "").trim();
      const name = String(body.name || "").trim();
      const password = String(body.password || "");
      const siteTitle = String(body.siteTitle || "").trim();
      const siteDescription = String(body.siteDescription || "").trim();
      const tagline = String(body.tagline || "").trim();
      const footerText = String(body.footerText || "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
        return jsonFail(t("api.email_invalid"), 422);
      // The full password policy, with its keyed violations, instead of a
      // bare length check - createFirstAdmin applies the same rules a moment
      // later, and the keys are what let an English install read them.
      const pwErr = passwordError(password, { email, name });
      if (pwErr) return jsonFail(t(pwErr.key, pwErr.params), 422);
      // The display name is optional in the installer: the email IS the login, and a first-run owner should not have to invent a handle to get going.
      const user = await createFirstAdmin({
        email,
        name: name || email.split("@")[0],
        password,
      });
      await bootstrapSiteSettings({ siteTitle, siteDescription, tagline, footerText });
      return withCookies(
        new Response(JSON.stringify({ user }), {
          status: 201,
          headers: { "content-type": "application/json; charset=utf-8" },
        }),
        await sessionCookiePair(user),
      );
    }, t);
  }
</script>
