<script>
  // Search results. Cold GETs with exactly one hit are 302'd to that post
  // by the middleware (original SearchPage parity); there is no client-side
  // router, so no client redirect is needed.
  let result = $data(() =>
    __rvLoad("search", {
      q: __rvQs().get("q") || "",
      page: Number(__rvQs().get("page") || 1),
      all: __rvQs().get("all") === "1",
    })
  );
</script>

<head>
  <title>{result().headTitle}</title>
  <meta name="robots" content="noindex,nofollow">
</head>

{@html result().main}
