<script>
  // First-run installer (pixel-port of app/admin/setup/page.tsx): database driver + image storage radio cards, site info, first admin.
  // Every string comes from the admin.setup loader, which renders in the
  // browser's language (Accept-Language - no site preference exists yet).
  let su = $data(() => __rvLoad("admin.setup", {}));
</script>

<head>
  <title>{su().s.docTitle}</title>
</head>

<div class="su-wrap">
  <form class="su-card" data-adm-form="setup" data-su-locale="{su().locale}" novalidate>
    <h1 class="su-title">{su().s.title}</h1><div id="dbg-al" style="display:none">{su().acceptLanguageDbg}</div>
    <p class="su-lead">{su().s.lead}</p>

    <fieldset class="su-group">
      <legend>{su().s.db}</legend>
      <div class="su-radios">
        <label class="su-radio is-on" data-su-card="driver-pglite">
          <input type="radio" name="driver" value="pglite" checked data-su="driver">
          {su().s.dbPglite}
        </label>
        <label class="su-radio" data-su-card="driver-postgres">
          <input type="radio" name="driver" value="postgres" data-su="driver">
          {su().s.dbPostgres}
        </label>
      </div>
      <div class="su-panel" data-su-panel="driver-pglite">
        <p class="su-hint">{su().s.dbPgliteHint}</p>
      </div>
      <div class="su-panel" data-su-panel="driver-postgres" hidden>
        <code class="su-code">postgresql://user:pass@host:5432/dbname?sslmode=require</code>
        <label class="su-label">{su().s.dbUrl}</label>
        <input class="adm-input su-input" name="dbUrl" placeholder="postgresql://…" spellcheck="false">
      </div>
    </fieldset>

    <fieldset class="su-group">
      <legend>{su().s.storage}</legend>
      <div class="su-radios">
        <label class="su-radio is-on" data-su-card="storage-local">
          <input type="radio" name="storage" value="local" checked data-su="storage">
          {su().s.storageLocal}
        </label>
        <label class="su-radio" data-su-card="storage-vercel-blob">
          <input type="radio" name="storage" value="vercel-blob" data-su="storage">
          {su().s.storageBlob}
        </label>
      </div>
      <div class="su-panel" data-su-panel="storage-local">
        <p class="su-hint">{su().s.storageLocalHint}</p>
      </div>
      <div class="su-panel" data-su-panel="storage-vercel-blob" hidden>
        <p class="su-hint">{su().s.storageBlobHint}</p>
        <label class="su-label">{su().s.blobToken}</label>
        <input class="adm-input su-input" name="blobToken" placeholder="vercel_blob_rw_…" spellcheck="false">
      </div>
    </fieldset>

    <fieldset class="su-group">
      <legend>{su().s.site}</legend>
      <label class="su-label">{su().s.siteTitle}</label>
      <input class="adm-input su-input" name="siteTitle" value="Oboext" required>
      <label class="su-label">{su().s.siteDesc}</label>
      <input class="adm-input su-input" name="siteDescription" value="{su().s.siteDescDefault}">
      <label class="su-label">{su().s.tagline}</label>
      <input class="adm-input su-input" name="tagline">
      <label class="su-label">{su().s.footer}</label>
      <input class="adm-input su-input" name="footerText">
    </fieldset>

    <fieldset class="su-group su-group-last">
      <legend>{su().s.admin}</legend>
      <label class="su-label">{su().s.email}</label>
      <input class="adm-input su-input" type="email" name="email" autocomplete="username" placeholder="you@example.com" required autofocus>
      <label class="su-label">{su().s.name}</label>
      <input class="adm-input su-input" name="name" autocomplete="nickname" placeholder="{su().s.namePh}">
      <label class="su-label">{su().s.password}</label>
      <input class="adm-input su-input" type="password" name="password" autocomplete="new-password" minlength="8" required>
    </fieldset>

    <p class="su-error" data-setup-error hidden></p>

    <button class="adm-btn adm-btn-block su-submit" type="submit">
      <span data-setup-label>{su().s.submit}</span>
    </button>

    <p class="su-back"><a href="/" style="display:inline-flex;align-items:center;gap:5px"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/arrow-left.svg)"></span>{su().s.back}</a></p>
  </form>
</div>
