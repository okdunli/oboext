<script>
  // Oboext request interceptor (runs once per request on the Node server).
  import { checkCsrf, needsCsrf, isSafeMethod, selfHealCsrfCookie } from "@server/csrf";
  import { createLogger } from "@server/logger";
  import { splitLocalePath, localeFromCookieHeader, localeHref, headerLocale, makeT } from "@server/i18n";
  import { resolveOrigin } from "@server/site-origin";
  import { roleAllows } from "@server/admin-menu";
  import { warmReadWave, xmlResponse } from "@server/loaders";
  import { handleReceiveRequest as handleWebmentionRequest, registerWebmentionHooks } from "@server/webmention";
  const log = createLogger("middleware");

  // /sitemap.xml plus its sharded children /sitemap-N.xml (emitted by
  // sitemap.ts above SITEMAP_SLICE_MAX_URLS). Every gate below that exempts
  // the sitemap must exempt the slices too: they are locale-independent
  // machine documents, never a page. The whole /sitemap-<digits>.xml
  // namespace is claimed so a bogus part answers a real 404, not a page.
  const isSitemapPath = (p) =>
    p === "/sitemap.xml" || /^\/sitemap-\d+\.xml$/.test(p);

  export async function handle(request) {
    const reg = globalThis.__oboeLoaders;
    if (reg && reg.ready) {
      // a dead database must surface as 500, not a broken page
      await reg.ready();
    }

    // Session: cms_session cookie (or Bearer) -> getContext().user. Every
    // pages/api/*.rose handler reads that; the /admin wall below uses it too.
    if (reg && reg.auth) {
      const u = await reg.auth.userFromRequest(request);
      if (u) getContext().user = u;
    }

    // Enabled plugins must be registered before any hook fires (chrome footer/head, comments, pinned posts, sitemap/robots).
    if (reg && reg.plugins) {
      await reg.plugins.ensureLoaded();
    }

    // Webmention (receive endpoint + discovery <link> + outbound sender) is
    // CORE, not a plugin, so its two hook registrations ride the same choke
    // point the plugin registry uses: every request has them before any head
    // renders or any post publishes. The guard inside makes it a no-op after
    // the first call.
    registerWebmentionHooks();

    const u = new URL(request.url);
    const p = u.pathname;

    // --------------------------------------------- Webmention receive endpoint
    // W3C puts the endpoint at an arbitrary path (the discovery <link> in the
    // page head tells senders where). This app advertises /webmention, which
    // the framework router cannot serve (only pages/api/* becomes an API
    // route), so the middleware is the dispatcher. The conventional
    // /api/webmention location is the same handler through
    // pages/api/webmention.rose — a sender that guesses it gets the same
    // answer. Both answer before any fetch happens (202 + empty body), and
    // neither carries user state, so the session/CSRF gates below do not
    // apply to them.
    if (p === "/webmention") {
      return handleWebmentionRequest(request);
    }

    // ------------------------------------------------- CSRF (single choke point) Runs before every branch below, so no route.
    if (!isSafeMethod(request.method) && needsCsrf(request)) {
      // Two steps, not one: needsCsrf() scopes the check to requests that actually carry a session cookie, and checkCsrf() then judges it.
      const verdict = checkCsrf(request);
      if (!verdict.ok) {
        log.warn(`[csrf] rejected ${request.method} ${p} (${verdict.reason})`);
        const heal = selfHealCsrfCookie(request);
        const t = makeT(headerLocale(request));
        const headers: Record<string, string> = {
          "content-type": "application/json; charset=utf-8",
        };
        if (heal) headers["set-cookie"] = heal;
        return new Response(JSON.stringify({ error: t("api.csrf_rejected") }), {
          status: 400,
          headers,
        });
      }
    }

    // Browser-side loader fetches hit /api/data from whatever admin page the
    // user is on; x-rv-url carries THAT page's URL so the loader context
    // (active nav, pathname gates) is correct. Server-side calls dispatch in
    // process and never send the header. On the data endpoint the same value
    // also rides the query as ?rv= (the client sends both): the prod hot cache
    // keys on pathname+query+cookie only (BUG.md AB), so the page URL must be
    // INSIDE the key or one page's loader fragment is replayed to another.
    // The query wins when both exist - it is the dimension the cache key
    // actually uses, so the key and the render signal can never diverge.
    const rv =
      (p === "/api/data" && u.searchParams.get("rv")) ||
      request.headers.get("x-rv-url") ||
      "";
    let real = u;
    if (rv) {
      try {
        real = new URL(rv, u.origin);
      } catch (e) {}
    }

    const ctx = getContext();
    ctx.pathname = real.pathname;
    // Canonical, og:url, sitemap/feed URLs and friends are negotiated bytes:
    // the prod hot cache keys on pathname+query+cookie only (BUG.md AB), so an
    // origin taken from x-forwarded-host/host let one spoofed-header request
    // poison the shared key - and the framework's own hot refetch (no Host
    // header at all) rendered http://localhost canonicals into every warmed
    // entry. resolveOrigin centralizes the policy: OBOEXT_SITE_ORIGIN wins,
    // otherwise the request headers decide and a hostless synthetic request
    // falls back to the remembered real origin. Redirects below keep using
    // real.origin - they must stay on the host the visitor arrived on.
    ctx.origin = resolveOrigin(request.headers);
    ctx.query = real.searchParams;
    ctx.ua = request.headers.get("user-agent") || "";
    ctx.ip =
      (request.headers.get("x-forwarded-for") || "").split(",")[0].trim() ||
      (request.headers.get("x-real-ip") || "").trim();
    // R255 traffic sources: the landing request's Referer rides on ctx so the
    // post loader can classify it into post_visitors.referrer_kind. Raw header,
    // unvalidated here - referrer.ts parses it without throwing, and only the
    // host ever reaches the database.
    ctx.referer = request.headers.get("referer") || "";
    // Post-likes backfill: the raw cookie header so the detail/list loaders can
    // read visitor_key off it (post-likes.ts). Read-only here - minting the
    // cookie is /api/posts/like's job. Safe for the render cache because the
    // hot key already includes this header (pathname + query + cookie), so one
    // visitor's `liked` flags can never be served to another.
    ctx.cookie = request.headers.get("cookie") || "";

    // First-run installer language: no URL prefix and no cookie exist yet, so
    // Accept-Language is the only signal (i18n.acceptLanguageLocale).
    ctx.acceptLanguage = request.headers.get("accept-language") || "";

    // ------------------------------------------------ locale prefix (/en)
    // The default locale (zh-CN) is prefix-free, so every existing URL keeps
    // working; English lives under /en. The URL prefix is the ONLY signal:
    // the client reproduces it from location.pathname, so SSR and hydration
    // derive the same locale and no fetch round-trip can flip the chrome
    // (Accept-Language is not sent by fetch(), so it cannot participate).
    // This runs BEFORE the /api/data early return below because a data
    // request carries the page URL in x-rv-url and must canonicalize exactly
    // like a document request would. ctx.pathname is what every loader keys
    // off (nav highlight, permalink matching, plugin head context), so
    // loaders see the stripped path; the framework router still matches the
    // raw URL, and the resolve loader strips the same segment from its
    // segments payload. An unknown first segment is left alone - it may be a
    // real page slug.
    const loc = splitLocalePath(real.pathname);
    ctx.locale = loc.locale;
    if (loc.prefixed) ctx.pathname = loc.path;

    // /api/data renders for whatever page the browser is on: its loader
    // context must carry THAT pathname/query, not the endpoint's. The header
    // was already applied above; nothing else to do here.
    if (p === "/api/data") return;

    // ----------------------------------------------- theme CSS assets
    // /theme-style/<slug> serves the combined CSS for non-skyscraper themes.
    // Skyscraper uses /public/theme.css directly; other themes ride this route.
    // The ?v= stamp is the file mtime, so the bytes behind a given URL never
    // change and immutable is safe: a theme switch picks a different slug, and
    // an edited stylesheet picks a different v. Without the stamp this route
    // served one immutable URL for every build, which is what left a switched
    // theme looking unchanged.
    if (p.indexOf("/theme-style/") === 0) {
      const slug = p.slice("/theme-style/".length).replace(/\/+$/, "");
      if (!slug || !reg.themeStyle) return new Response("Not found", { status: 404 });
      const css = reg.themeStyle.css(slug);
      if (!css) return new Response("Not found", { status: 404 });
      return new Response(css, {
        status: 200,
        headers: {
          "content-type": "text/css; charset=utf-8",
          "cache-control": "public, max-age=31536000, immutable",
        },
      });
    }

    if (!reg) return;

    // Canonical (locale-stripped) path: every branch below must judge the
    // route the loaders see, so /en/admin/login redirects to /admin/login
    // instead of falling through to page routing.
    const rp = ctx.pathname || real.pathname;

    // Lambda cold start: there is no boot warm on serverless, so the FIRST
    // visitor pays the whole read wave. Fire it once in the background
    // (fire-and-forget: a failure costs nothing) so the instance-mates that
    // follow hit warm memos. Non-Vercel boots warm at boot instead.
    if (process.env.VERCEL && !globalThis.__oboextWaveWarmed) {
      globalThis.__oboextWaveWarmed = true;
      console.log("[Oboext] cold-start read wave fired (vercel, background)");
      void warmReadWave().catch(() => {});
    }

    // ------------------------------------------- first-run wall (whole site)
    // A fresh install has no user, so every public page renders an empty blog
    // shell - the visitor lands on a homepage with no content and no hint that
    // the site needs initializing. Send the WHOLE site to /admin/setup until
    // the first admin exists, not just /admin (which is where the wall used to
    // live, so the root path behaved differently from the admin path).
    //
    // The installer stays an untagged path. It used to carry the browser's
    // language as ?l= (BUG.md AB) because the hot cache keyed on
    // pathname+cookie only, so the first visitor's language won the shared
    // entry; accept-language is now an unconditional key dimension (index 0 of
    // hotVaryValues), so the negotiation is partitioned by the framework and
    // the query tag - and the 302 bounce that kept the untagged key empty -
    // are both gone. The language itself is read from the request inside the
    // setup loader (adminSetup), which still honours an explicit ?l=.
    const setupHref = "/admin/setup";
    //
    // Assets and APIs are exempt: the setup page itself pulls the admin bundle
    // and calls /api/data, and redirecting those would either 404 the
    // document's own scripts or bounce the installer's POST. The probe is
    // memoized per process (auth.hasAnyUser), so this costs one query per
    // instance, not one per request.
    if (
      !rp.startsWith("/admin") &&
      !rp.startsWith("/api/") &&
      !rp.startsWith("/public/") &&
      !rp.startsWith("/uploads/") &&
      !rp.startsWith("/theme-assets/") &&
      !rp.startsWith("/plugin-assets/") &&
      !rp.startsWith("/theme-style/") &&
      rp !== "/favicon.ico" &&
      rp !== "/manifest.webmanifest" &&
      rp !== "/robots.txt" &&
      !isSitemapPath(rp) &&
      rp !== "/feed.xml" &&
      rp !== "/rss.xml" &&
      rp !== "/feed"
    ) {
      if (!(await reg.auth.hasAnyUser())) {
        return Response.redirect(new URL(setupHref, real.origin), 302);
      }
    }

    // --------------------------------------------- remembered locale bounce
    // A visitor who picked English via the switcher carries oboext_locale=en
    // (the switcher writes it client-side before its full-document jump).
    // A prefix-free URL would otherwise silently render the default locale,
    // losing the choice on the next session; bounce it to the prefixed URL
    // once instead. The URL prefix stays the ONLY render signal: this runs
    // before any page renders, so SSR and hydration still agree without a
    // round-trip, and <html lang> always matches the address bar.
    //
    // Only prefixed locales are worth bouncing - the default is already
    // prefix-free, so remembering it changes nothing. Documents that are
    // locale-independent (feeds, sitemap, robots, manifest) and every
    // machine consumer (APIs, assets, admin, the search jump that answers
    // with its own redirect) are exempt: a bounce would either duplicate
    // work or, for the search jump, chain two redirects into one request.
    if (!loc.prefixed && (request.method === "GET" || request.method === "HEAD")) {
      const rpBouncable =
        !rp.startsWith("/api/") &&
        !rp.startsWith("/public/") &&
        !rp.startsWith("/uploads/") &&
        !rp.startsWith("/theme-assets/") &&
        !rp.startsWith("/plugin-assets/") &&
        !rp.startsWith("/theme-style/") &&
        !rp.startsWith("/admin") &&
        rp !== "/search" &&
        rp !== "/favicon.ico" &&
        rp !== "/manifest.webmanifest" &&
        rp !== "/robots.txt" &&
        !isSitemapPath(rp) &&
        rp !== "/feed.xml" &&
        rp !== "/rss.xml" &&
        rp !== "/feed";
      if (rpBouncable) {
        const remembered = localeFromCookieHeader(request.headers.get("cookie"));
        if (remembered && remembered !== loc.locale) {
          const target = localeHref(real.pathname, remembered) + real.search;
          return Response.redirect(new URL(target, real.origin), 302);
        }
      }
    }

    // ----------------------------------------------- /admin login wall
    // Whitelist: /admin/login and /admin/setup. First run (no users) sends
    // everyone to setup; once initialized setup redirects away; every other

    if (rp.indexOf("/admin") === 0) {
      const user = getContext().user;
      if (rp === "/admin/setup") {
        if (await reg.auth.hasAnyUser()) {
          return Response.redirect(
            new URL(user ? "/admin" : "/admin/login", real.origin),
            302,
          );
        }
      } else if (rp === "/admin/login") {
        if (user) return Response.redirect(new URL("/admin", real.origin), 302);
        if (!(await reg.auth.hasAnyUser()))
          return Response.redirect(new URL(setupHref, real.origin), 302);
      } else if (!user) {
        return Response.redirect(new URL("/admin/login", real.origin), 302);
      } else if (!roleAllows(user.role, { adminOnly: true })) {
        // R262 fixed the HTML door (the wall only asked "is signed in"), but it
        // wrote the rule out by hand. R265: the middleware CAN import server
        // modules — it already imports csrf, i18n, loaders and webmention — so
        // this now calls the same `roleAllows` the sidebar and every loader use.
        // A hand-written copy cannot follow a new role; the shared predicate can.
        // /admin/login and /admin/setup are handled above, and /admin/account
        // stays reachable because a member must see their own profile.
        if (rp !== "/admin/account") {
          return Response.redirect(new URL("/", real.origin), 302);
        }
      } else if (rp === "/admin" || rp === "/admin/dashboard") {
        // Admin home preference: /admin and the /admin/dashboard alias swap
        // places (mirrors app/admin/page.tsx + app/admin/dashboard/page.tsx).
        const to = reg.adminHome ? await reg.adminHome.redirect(rp) : null;
        if (to) return Response.redirect(new URL(to, real.origin), 302);
      }
    }

    if (reg.security) {
      const sec = await reg.security.get();
      if (sec.entryEnabled && getContext().user && rp === sec.entryPath) {
        return Response.redirect(new URL("/admin", real.origin), 302);
      }
    }

    // ----------------------------------------------- app static assets
    // /public/<rel> serves the app's own compiled assets from PUBLIC_DIR
    // (admin.css, admin.js, comments.js, icons/**, theme-*.js, vendor/**).
    // These are linked as /public/** and normally answered by the platform's
    // static layer, which runs first. This handler is the safety net for when
    // that layer is missing or stale: without it the request falls through
    // every other branch into page routing, which 302s to /admin/login, so the
    // browser gets HTML for a .css/.js request and the admin's CSP rejects it
    // (unstyled admin). Same public/immutable caching as the static layer.
    // GET/HEAD only; servePublic is traversal-protected and 404s, never throws.
    if (rp.indexOf("/public/") === 0) {
      if (request.method !== "GET" && request.method !== "HEAD") {
        return new Response("Method not allowed", {
          status: 405,
          headers: { "content-type": "text/plain; charset=utf-8" },
        });
      }
      if (reg && reg.publicStatic) {
        // R267: the negotiable dimension travels with the request, or the
        // handler cannot pick br/gzip and every asset goes out raw.
        return reg.publicStatic.serve(rp, request.method, request.headers.get("accept-encoding"));
      }
    }

    // ----------------------------------------------- user uploads (content/)
    // Served by app code (not the framework's dist static root): files live in
    // content/uploads and must survive rebuilds. Public GETs/HEADs only.
    if (rp.indexOf("/uploads/") === 0) {
      if (request.method !== "GET" && request.method !== "HEAD") {
        return new Response("Method not allowed", {
          status: 405,
          headers: { "content-type": "text/plain; charset=utf-8" },
        });
      }
      return reg.uploads.serve(rp, request.method, request.headers.get("accept-encoding"));
    }

    // ------------------------------------------- theme static assets
    // /theme-assets/<slug>/<path> serves themes/<slug>/assets/<path> from disk
    // (rankings medals, fonts, vendor scripts). Mirrors the original app
    // /theme-assets route. GET/HEAD only, traversal-protected.
    if (rp.indexOf("/theme-assets/") === 0) {
      const rel = rp.slice("/theme-assets/".length);
      return reg.themeAssets.serve(rel, request.method);
    }

    // -------------------------------------------- plugin static assets
    // /plugin-assets/<slug>/<path> serves plugins/<slug>/<path> from disk —
    // a plugin's admin-panel script and friends (the admin document's strict
    // CSP allows 'self' scripts only, so panel JS ships as an external file).
    // GET/HEAD only, traversal-protected.
    if (rp.indexOf("/plugin-assets/") === 0) {
      const rel = rp.slice("/plugin-assets/".length);
      return reg.pluginAssets.serve(rel, request.method);
    }

    // ------------------------------------------- plugin HTTP gateway
    // /api/plugin/<slug>/<...path>: the first ENABLED plugin that sets
    // response on the api.request filter wins; otherwise real 404. Any
    // method (plugins expose POST endpoints), so this precedes the
    // GET/HEAD gate below.
    if (rp.indexOf("/api/plugin/") === 0) {
      const segs = rp
        .slice("/api/plugin/".length)
        .split("/")
        .map((s) => {
          try {
            return decodeURIComponent(s);
          } catch (e) {
            return s;
          }
        })
        .filter(Boolean);
      const json404 = () =>
        new Response(JSON.stringify({ error: "not found" }), {
          status: 404,
          headers: { "content-type": "application/json; charset=utf-8" },
        });
      if (!segs.length) return json404();
      const slug = segs[0];
      const out = await reg.pluginApi.dispatch(slug, segs.slice(1), request);
      if (!out) return json404();
      const headers = Object.assign(
        { "content-type": "application/json; charset=utf-8" },
        out.headers || {},
      );
      const body =
        out.body == null
          ? ""
          : typeof out.body === "string"
            ? out.body
            : JSON.stringify(out.body);
      return new Response(body, { status: out.status || 200, headers });
    }

    // ----------------------------------------------- XML / txt documents
    // The sitemap runs the plugin hooks (sitemap.urls + sitemap.document):
    // sitemap-plus can shard it into a sitemapindex or claim ?kind=news /
    // ?part=n. An unclaimed query answers a real 404, never the default map.
    // /sitemap-N.xml are the CORE shards (buildSitemapDocument owns them,
    // above SITEMAP_SLICE_MAX_URLS); a slice the map does not have is a 404.
    if (isSitemapPath(rp)) {
      const doc = await reg.sitemap.document(request);
      if (!doc) return new Response("Not found", { status: 404 });
      // R144: validators + 304 for the XML documents (see xmlResponse).
      return xmlResponse(doc.xml, request, {
        "content-type": doc.contentType,
        "cache-control": "public, max-age=300",
      });
    }
    if (rp === "/feed.xml" || rp === "/rss.xml" || rp === "/feed") {
      // RSS readers poll aggressively; 5 minutes of edge cache keeps repeat
      // polls from re-rendering the feed body through the function. New posts
      // surface within that window, which is fine for a feed.
      // rp is locale-stripped by now (ctx.pathname was canonicalised), so the
      // FEED language comes from the prefix that was stripped: /en/feed.xml
      // serves the English feed. The default stays the zh-CN feed.
      // R144: the response now carries a content ETag and answers a matching
      // If-None-Match with a bodiless 304 - a poll that arrives after the
      // max-age window costs headers only, not the whole feed body.
      return xmlResponse(await reg.documents.feed(ctx, loc.locale), request, {
        "content-type": "application/rss+xml; charset=utf-8",
        "cache-control": "public, max-age=300",
      });
    }
    if (rp === "/feed.json") {
      // R145: JSON Feed 1.1 - same locale contract as /feed.xml (the prefix
      // that was stripped decides the language), same validator + 304
      // treatment via xmlResponse: a JSON reader's poll after the max-age
      // window costs headers only.
      return xmlResponse(await reg.documents.jsonFeed(ctx, loc.locale), request, {
        "content-type": "application/feed+json; charset=utf-8",
        "cache-control": "public, max-age=300",
      });
    }
    if (rp === "/comments/feed.xml" || rp === "/comments/feed") {
      // R147: the site-wide comments feed - same locale/validator contract as
      // the posts feed; approved comments only (enforced in the query).
      return xmlResponse(await reg.documents.commentsFeed(ctx, loc.locale), request, {
        "content-type": "application/rss+xml; charset=utf-8",
        "cache-control": "public, max-age=300",
      });
    }
    if (rp === "/comments/feed.json") {
      // R155: the JSON twin of the comments feed - same rows, same moderation,
      // same validator/304 treatment.
      return xmlResponse(await reg.documents.commentsJsonFeed(ctx, loc.locale), request, {
        "content-type": "application/feed+json; charset=utf-8",
        "cache-control": "public, max-age=300",
      });
    }
    if (rp.endsWith("/feed.xml") && rp !== "/feed.xml") {
      // R160: category/tag feeds. The loader resolves the path against the
      // CONFIGURED bases and returns null for anything unknown - that null
      // falls through to normal routing, so this branch claims no URL it does
      // not own. Same validator contract as the site feeds.
      const base = rp.slice(0, -"/feed.xml".length);
      if (base) {
        const doc = await reg.documents.taxonomyFeed(ctx, loc.locale, base);
        if (doc) {
          return xmlResponse(doc, request, {
            "content-type": "application/rss+xml; charset=utf-8",
            "cache-control": "public, max-age=300",
          });
        }
      }
    }
    if (rp.endsWith("/feed.json") && rp !== "/feed.json") {
      // R162: the JSON twin of a category/tag feed. Same resolver as the RSS
      // branch above (configured bases, unknown -> null -> normal routing), so
      // the pair can never disagree about which paths they own.
      const base = rp.slice(0, -"/feed.json".length);
      if (base) {
        const doc = await reg.documents.taxonomyJsonFeed(ctx, loc.locale, base);
        if (doc) {
          return xmlResponse(doc, request, {
            "content-type": "application/feed+json; charset=utf-8",
            "cache-control": "public, max-age=300",
          });
        }
      }
    }
    if (rp === "/robots.txt") {
      // Same 5-minute window as sitemap/feed: crawlers re-fetch robots.txt
      // aggressively, and the body is rebuilt from DB-backed settings on
      // every miss. Changes surface within that window, same as the others.
      // R159: and the same VALIDATOR contract - robots.txt used to answer 200
      // with no ETag, so a crawler re-fetching it every few minutes (which is
      // exactly what crawlers do) paid the rebuild AND the full body each
      // time. xmlResponse() is the generic conditional-GET wrapper despite the
      // name: content-hash ETag + bodiless 304.
      return xmlResponse(await reg.documents.robots(ctx), request, {
        "content-type": "text/plain; charset=utf-8",
        "cache-control": "public, max-age=300",
      });
    }
    
    
    if (rp === "/manifest.webmanifest") {
      // R159: same treatment (it had NO cache-control either - every PWA
      // install/re-open refetched the full manifest).
      return xmlResponse(await reg.documents.manifest(ctx), request, {
        "content-type": "application/manifest+json",
        "cache-control": "public, max-age=300",
      });
    }

      if (request.method !== "GET" && request.method !== "HEAD") return;

    // ------------------------------------- renamed-URL 301/302 (content-first)
    // (Historical basis: Rosezm BUG.md AO — a catch-all page calling
    // redirect() from $data was crashed by the prod edge handler, src/cli/
    // edge.ts:269 ignored page.redirect and fed buildShell undefined state ->
    // 500, so the middleware intercepted here and emitted the Response itself.)
    // That basis is stale: upstream fixed AO in R209 (vendored edge.ts:269-273
    // now honours page.redirect), so edge no longer 500s. The block is kept
    // for the content-first semantics framework redirect() cannot express —
    // resolve() runs before the rule is honoured, so a renamed-URL old link
    // whose content (re)claims the slug answers 200 and renders the full page
    // instead of bouncing 301; only a miss is redirected. Ordering is the
    // design: content wins over a rule. redirectFor is memoized and short-
    // circuits on an empty rule map, so this costs nothing when no rules exist.
    if (!rp.startsWith("/admin") && !rp.startsWith("/api/") && !rp.startsWith("/public/") &&
        !rp.startsWith("/uploads/") && !rp.startsWith("/theme-assets/") && !rp.startsWith("/plugin-assets/") &&
        !rp.startsWith("/theme-style/") && rp !== "/" && rp !== "/search" && rp !== "/archives" &&
        rp !== "/favicon.ico" && rp !== "/manifest.webmanifest" && rp !== "/robots.txt" &&
        !isSitemapPath(rp) && rp !== "/feed.xml" && rp !== "/rss.xml" && rp !== "/feed" &&
        rp !== "/feed.json" && !rp.endsWith("/feed.xml") && !rp.endsWith("/feed.json") &&
        reg && reg.dispatch) {
      const segs = rp === "/" ? [] : rp.replace(/^\/+/, "").split("/");
      const r = await reg.dispatch("redirectFor", { segments: segs }, getContext());
      if (r && (r.href || r.status)) {
        const v = await reg.dispatch("resolve", { segments: segs }, getContext());
        // Same rule as the search jump below: the rule is stored locale-stripped,
        // so the answer is re-prefixed or the visitor is ejected to the Chinese
        // URL. Off-site targets (an absolute URL) are passed through untouched.
        if (!v) {
          const offsite = /^[a-z][a-z0-9+.-]*:\/\//i.test(r.href || "");
          const target = offsite ? r.href : localeHref(r.href, loc.locale);
          return new Response(null, { status: r.status, headers: { location: target } });
        }
      }
    }

    // ------------------------------------- unique-hit search jumps to the post
    if (rp === "/search") {
      const q = (real.searchParams.get("q") || "").trim();
      if (q && real.searchParams.get("all") !== "1") {
        const to = await reg.searchRedirect(q);
        // Keep the visitor on their locale: searchSingleHit returns a bare
        // /blog/<slug>, so without the prefix an /en visitor is ejected to the
        // Chinese URL by this 302.
        if (to) return Response.redirect(new URL(localeHref(to, loc.locale), real.origin), 302);
      }
      return;
    }
  }
</script>
