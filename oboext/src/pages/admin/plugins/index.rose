<script>
  let data = $data(() => __rvLoad("admin.plugins", {}));
  function list() { return data().plugins || []; }
  function iconUrl(p) {
    var name = (p.manifest && p.manifest.icon) || "plug";
    return "/public/icons/" + name.toLowerCase() + ".svg";
  }
  function statusStyle(p) {
    return p.enabled
      ? "background:rgba(22,163,74,.14);color:#4ade80;"
      : "background:rgba(120,120,130,.18);color:#d4d4d8;";
  }
  function statusText(p) { return p.enabled ? "已启用" : "已禁用"; }
  function toggleIcon(p) { return p.enabled ? "/public/icons/toggle-left.svg" : "/public/icons/toggle-right.svg"; }
  function toggleText(p) { return p.enabled ? "禁用" : "启用"; }
  function iconBg(p) { return p.enabled ? "rgba(79,70,229,.15)" : "var(--adm-panel-2)"; }
  function iconColor(p) { return p.enabled ? "#818cf8" : "var(--adm-faint)"; }
  function emptyHint() { return list().length ? [] : [1]; }

  function hasSettings(p) {
    const sections = (p.manifest && p.manifest.settings) || [];
    for (let i = 0; i < sections.length; i++) {
      const fields = sections[i].fields || [];
      for (let j = 0; j < fields.length; j++) {
        if (fields[j].type !== "hidden" && fields[j].type !== "group") return true;
      }
    }
    return false;
  }
  function ic(n) {
    return '<span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/' + n + '.svg)"></span>';
  }
</script>

<head>
  <title>插件 - 管理后台</title>
</head>

<div class="adm-toolbar">
  <div style="display:flex;align-items:center;gap:8px;">
    <span class="adm-ic" style="--i:url(/public/icons/plug.svg);width:20px;height:20px;color:#818cf8;"></span>
    <strong style="font-size:16px">全部插件</strong>
    <span class="adm-hint" style="margin:0">{list().length} 个已安装</span>
  </div>
  <span style="flex:1"></span>
  <label class="adm-btn adm-btn-ghost adm-btn-sm" style="cursor:pointer">
    <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/upload.svg)"></span>上传插件
    <input type="file" accept=".zip" class="adm-hidden-file" data-adm-act="plugin-upload">
  </label>
</div>

{#each list() as p}
<div class="adm-card" style="margin-bottom:12px;padding:16px 18px;">
  <div style="display:flex;align-items:flex-start;gap:14px;">
    <div style="width:40px;height:40px;flex-shrink:0;border-radius:10px;display:flex;align-items:center;justify-content:center;background:{iconBg(p)};">
      <span class="adm-ic" style="--i:url({iconUrl(p)});width:20px;height:20px;color:{iconColor(p)};"></span>
    </div>
    <div style="flex:1;min-width:0;">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <strong style="font-size:14px;">{p.name}</strong>
        {#if p.version}<span style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:10px;color:var(--adm-faint);background:var(--adm-hover);border-radius:4px;padding:2px 6px;">v{p.version}</span>{/if}
        <span class="adm-tag" style="{statusStyle(p)}">{statusText(p)}</span>
        {#if !p.installed}
          <span class="adm-tag" style="background:rgba(217,119,6,.15);color:#fbbf24;">文件缺失</span>
        {/if}
      </div>
      {#if p.description}<p style="margin:4px 0 0;font-size:13px;color:var(--adm-muted);line-height:1.5;">{p.description}</p>{/if}
      <div style="margin-top:6px;display:flex;align-items:center;gap:12px;font-size:11px;color:var(--adm-faint);">
        {#if p.author}<span>作者：{p.author}</span>{/if}
        <span>slug: <code style="font-family:ui-monospace,Menlo,Consolas,monospace;">{p.slug}</code></span>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
      {#if hasSettings(p)}
      <button class="adm-iconbtn" data-plg-settings data-slug={p.slug} title="插件设置">
        <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/settings-2.svg)"></span>
        设置
      </button>
      {/if}
      {#if p.hasAdmin && p.enabled}
      <a class="adm-iconbtn" href={"/admin/plugins/" + p.slug} title="管理面板">
        <span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/external-link.svg)"></span>
        面板
      </a>
      {/if}
      <button class="adm-iconbtn" data-adm-act="plugin-toggle" data-slug={p.slug} data-enabled={p.enabled ? "1" : "0"}>
        <span class="adm-ic adm-ic-sm" style="--i:url({toggleIcon(p)})"></span>
        {toggleText(p)}
      </button>
    </div>
  </div>
</div>
{/each}

{#each emptyHint() as _}
<div class="adm-empty" style="border:1px dashed var(--adm-border);border-radius:var(--adm-radius);">
  还没有安装任何插件。<br>
  <span class="adm-hint">将插件 zip 包上传到 plugins/ 目录即可。</span>
</div>
{/each}

<div class="adm-modal" data-plg-modal hidden>
  <div class="adm-modal-box" style="max-width:min(94vw,920px);">
    <div class="adm-modal-hd">
      <div>
        <h2 style="margin:0;font-size:15px;" data-plg-title>插件设置</h2>
        <p class="adm-hint" style="margin:3px 0 0;" data-plg-sub></p>
      </div>
      <button type="button" class="adm-modal-x" data-plg-close aria-label="关闭">{@html ic("x")}</button>
    </div>
    <div class="adm-modal-bd">
      <div class="adm-thp-grid">
        <nav class="adm-thp-nav">
          <div class="adm-thp-navgroup" data-plg-navgroup>
            <div class="adm-thp-navlist" data-plg-nav></div>
          </div>
        </nav>
        <div class="adm-thp-body" data-plg-body></div>
      </div>
    </div>
    <div class="adm-modal-ft">
      <span class="adm-thp-msg" data-plg-msg style="margin-right:auto;"></span>
      <button type="button" class="adm-btn adm-btn-ghost" data-plg-close>取消</button>
      <button type="button" class="adm-btn" data-plg-save>保存设置</button>
    </div>
  </div>
</div>
