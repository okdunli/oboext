.env
.env.*
!.env.example
node_modules
# Build/dev artifacts of the vendored framework CLI. They are regenerated by
# `npm run build` / `npm run dev`, are never read at runtime, and .rosezm-dev
# grows by one ~2.3 MB server copy per dev start without ever being reclaimed
# (314 MB / 140 files on a working tree) - publishing it would ship hundreds of
# MB of dead bytes in the tarball.
.rosezm-dev
.rosezm-build
src/.rosezm
