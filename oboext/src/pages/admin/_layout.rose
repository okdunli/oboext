<script>
  // Admin shell (dark zinc/indigo, ported from AdminShell.tsx). Unauthenticated
  // routes (/admin/login, /admin/setup — the middleware whitelist) render the
  // bare slot; everything else gets the sidebar + topbar chrome.
  let session = $data(() => __rvLoad("admin.session", {}));
  function authed() {
    return session() && session().user;
  }
  function initial() {
    var n = session() && session().user ? session().user.name : "";
    return n ? n.slice(0, 1).toUpperCase() : "A";
  }
  function adminUser() {
    return authed() && session().user.role === "admin";
  }
  function pageTitle() {
    var p =
      typeof window !== "undefined"
        ? window.location.pathname
        : String(getContext().pathname || "");
    if (p === "/admin" || p === "/admin/") return "仪表盘";
    if (p.indexOf("/admin/posts") === 0)
      return /\/admin\/posts\/(new|\d+)/.test(p) ? "编辑文章" : "文章";
    if (p.indexOf("/admin/comments") === 0) return "评论";
    if (p.indexOf("/admin/categories") === 0) return "分类";
    if (p.indexOf("/admin/tags") === 0) return "标签";
    if (p.indexOf("/admin/users") === 0) return "用户";
    if (p.indexOf("/admin/settings") === 0) return "站点设置";
    return "管理后台";
  }
  function guest() {
    return !authed();
  }
  // each-predicate: same-kind {#if} blocks cannot nest in .rose templates,
  // and this group lives inside the authed() shell wrapper
  function adminTools() {
    return adminUser() ? [1] : [];
  }
</script>

<head>
  <title>管理后台</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="stylesheet" href="/public/admin.css">
  <script src="/public/admin.js"></script>
</head>

{#if authed()}
<div class="adm-shell">
  <aside class="adm-side">
    <div class="adm-logo"><span class="adm-auth-mark">O</span> oboext</div>
    <nav class="adm-nav">
      <div class="adm-nav-group">
        <div class="adm-nav-title">概览</div>
        <a href="/admin"><span class="ic">▦</span> 仪表盘</a>
      </div>
      <div class="adm-nav-group">
        <div class="adm-nav-title">内容管理</div>
        <a href="/admin/posts"><span class="ic">✎</span> 文章</a>
        <a href="/admin/comments"><span class="ic">💬</span> 评论</a>
        <a href="/admin/categories"><span class="ic">▤</span> 分类</a>
        <a href="/admin/tags"><span class="ic">#</span> 标签</a>
      </div>
      <div class="adm-nav-group">
        <div class="adm-nav-title">外观设置</div>
        <a href="/admin/settings"><span class="ic">⚙</span> 站点设置</a>
      </div>
      {#each adminTools() as _}
      <div class="adm-nav-group">
        <div class="adm-nav-title">系统设置</div>
        <a href="/admin/users"><span class="ic">👤</span> 用户</a>
      </div>
      {/each}
    </nav>
    <div class="adm-side-foot">
      <div class="adm-avatar">{initial()}</div>
      <div class="who"><b>{session().user.name}</b><span>{session().user.role}</span></div>
      <button class="adm-iconbtn" data-adm-act="logout" title="退出登录">⏻</button>
    </div>
  </aside>
  <div class="adm-main">
    <header class="adm-topbar">
      <h1>{pageTitle()}</h1>
      <span class="spacer"></span>
      <a class="adm-btn adm-btn-ghost adm-btn-sm" href="/" target="_blank">访问站点 ↗</a>
    </header>
    <main class="adm-content">
      <slot />
    </main>
  </div>
</div>
{/if}
{#if guest()}
<slot />
{/if}
