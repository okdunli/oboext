<script>
  // Blog index (all posts). Reads the live DB on every request via the
  // "blog" loader; ?page=N rides the query (the middleware's loopback
  // workaround lets the 0.1.0 router see query strings).
  let list = $data(() => __rvLoad("blog", { page: Number(__rvQs().get("page") || 1) }));
</script>

<head>
  <title>{list().headTitle}</title>
  <meta name="description" content="全部文章">
</head>

{list().main}
