<script>
  // /api/not-found-config — GET/PUT 404 page settings (admin only)
  import { apiGate, readBody, jsonFail } from "@server/admin";
  import { getNotFoundSettings, saveNotFoundSettings } from "@server/not-found-config";

  export async function GET() {
    return apiGate(async () => {
      const user = getContext().user;
      if (user?.role !== "admin") {
        return jsonFail("需要管理员权限", 403);
      }
      return getNotFoundSettings();
    });
  }

  export async function PUT(request) {
    return apiGate(async () => {
      const user = getContext().user;
      if (user?.role !== "admin") {
        return jsonFail("需要管理员权限", 403);
      }
      const body = await readBody(request);
      const saved = await saveNotFoundSettings(body);
      return saved;
    });
  }
</script>
