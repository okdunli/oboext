<script>
  // Isomorphic data endpoint.
  //
  // Server-only module (the compiler excludes pages/api/* from the client
  // bundle), so it is safe to import the live-DB loader layer here. Its
  // module side effect installs the registry the middleware and the pages'
  // server-side __rvLoad shim both use:
  //
  //   globalThis.__oboeLoaders.dispatch(key, payload, ctx)
  //
  // Browser-side __rvLoad() GETs this very endpoint; server-side it calls
  // dispatch() directly. One loader map, per-request database reads.
  import { dispatch, documents, searchRedirect } from "@server/loaders";
  import { buildSitemapDocument } from "@server/sitemap";
  import { themeCssContent, serveThemeAsset } from "@server/theme-chrome";
  import { servePluginAsset } from "@server/plugin-assets";
  import { serveUpload, servePublic } from "@server/storage";
  import { ensureMigrations, withDbRetry } from "@server/db";
  import { getSessionFromRequest, hasAnyUser } from "@server/auth";
  import { getAdminSecurity } from "@server/security";
  import { getAdminMenuPrefs, homeRedirectFor } from "@server/admin-menu";
  import { syncPlugins, ensurePluginsLoaded } from "@server/plugins";
  import { dispatchPluginApi } from "@server/plugin-gateway";

  // Lazy: the framework's build imports dist/server.js for route analysis;
  // touching the DB at module top level would make builds require a DB.
  // The middleware awaits ready() before the first render. One pass also
  // syncs plugins/ on disk into the plugins table (new plugins disabled)
  // and loads the enabled set.
  let readyPromise;
  // withDbRetry, not a bare call: a serverless Postgres drops the connection
  // of a suspended compute during the TLS handshake, and every route then
  // fails identically. The retry rebuilds the client after a short wait.
  const ready = () => (readyPromise = readyPromise || withDbRetry(async () => {
    await ensureMigrations();
    await syncPlugins();
    await ensurePluginsLoaded();
  }).catch((err) => {
    console.error("[oboext] database init failed:", err);
    throw err;
  }));

  globalThis.__oboeLoaders = {
    ready,
    dispatch,
    documents,
    plugins: {
      ensureLoaded: () => ensurePluginsLoaded(),
    },
    pluginApi: {
      dispatch: (slug, path, request) => dispatchPluginApi(slug, path, request),
    },
    uploads: {
      serve: (pathname, method) => serveUpload(pathname, method),
    },
    // Safety net for the app's own compiled assets, linked as /public/**
    // (admin.css, admin.js, comments.js, icons/**, theme-*.js, vendor/**).
    // The Vercel static layer normally answers these first; this handler only
    // matters when that layer is missing/stale, where the request would
    // otherwise fall into page routing and 302 to /admin/login (breaking every
    // stylesheet/script under the admin's CSP). Mirrors uploads.serve.
    publicStatic: {
      serve: (pathname, method) => servePublic(pathname, method),
    },
    // Hook-based sitemap: buildSitemapDocument runs sitemap.urls +
    // sitemap.document filters (sitemap-plus and friends extend it), and
    // answers null for an unclaimed query (?part= / ?kind=) -> the
    // middleware returns a real 404.
    sitemap: {
      document: (request) => buildSitemapDocument(request),
    },
    auth: {
      userFromRequest: (request) => getSessionFromRequest(request),
      hasAnyUser: () => hasAnyUser(),
    },

    security: {
      get: async () => {
        await ready();
        return getAdminSecurity();
      },
    },
    searchRedirect: async (q) => {
      await ready();
      return searchRedirect(q);
    },
    // /admin <-> /admin/dashboard swap driven by the adminHomePath preference
    adminHome: {
      redirect: async (pathname) => {
        await ready();
        return homeRedirectFor(pathname, await getAdminMenuPrefs());
      },
    },
    themeStyle: {
      css: (slug) => themeCssContent(slug),
    },
    themeAssets: {
      serve: (rel, method) => serveThemeAsset(rel, method),
    },
    pluginAssets: {
      serve: (rel, method) => servePluginAsset(rel, method),
    },
  };

  export async function GET(request) {
    await ready();
    const u = new URL(request.url);
    const key = u.searchParams.get("r") || "";
    let payload = {};
    try {
      payload = JSON.parse(u.searchParams.get("d") || "{}");
    } catch (e) {}
    const ctx = getContext();
    // The registry mixes public loaders (home, resolve, …) with admin
    // screens. Admin loaders themselves throw without a session, but that
    // surfaced as an opaque 500; answer a plain 401 before dispatching so
    // anonymous probing gets nothing but the status code.
    if (key.indexOf("admin.") === 0 && !(ctx as Record<string, unknown>).user) {
      return new Response(JSON.stringify({ error: "unauthorized" }), {
        status: 401,
        headers: {
          "content-type": "application/json; charset=utf-8",
          "cache-control": "no-store",
        },
      });
    }
    const data = await dispatch(key, payload, ctx);
    return new Response(JSON.stringify(data), {
      status: 200,
      headers: {
        "content-type": "application/json; charset=utf-8",
        "cache-control": "no-store",
      },
    });
  }
</script>
