<script>
  // POST /api/admin/menu-settings  {hiddenHrefs: string[], homePath: string}
  // Port of app/api/admin/menu-settings/route.ts (settings:manage).
  import { apiGate, readBody, requireCap } from "@server/admin";
  import { saveAdminMenuPrefs, collectAdminMenuExtras } from "@server/admin-menu";

  export async function POST(request) {
    return apiGate(async () => {
      requireCap(getContext().user, "settings:manage");
      const body = await readBody(request);
      // Hook/plugin leaves participate in validation so they can be hidden
      // (but never chosen as home) exactly like core leaves.
      const extras = await collectAdminMenuExtras();
      return saveAdminMenuPrefs(
        {
          hiddenHrefs: body?.hiddenHrefs,
          homePath: body?.homePath,
        },
        extras,
      );
    });
  }
</script>
