<script>

  import { apiGate, jsonFail } from "@server/admin";
  import { getAdminSecurity, isEntryReferer } from "@server/security";
  import { makeT, headerLocale } from "@server/i18n";

  // The 404 body is localized on the client-stamped x-locale header, and this
  // response is storable, so the header has to be a cache-key dimension or the
  // first caller's language wins the shared entry (BUG.md AB).
  export const hotVary = ["x-locale"];

  export async function GET(request) {
    const t = makeT(headerLocale(request));
    return apiGate(async () => {
      const sec = await getAdminSecurity();
      if (!isEntryReferer(request, sec)) return jsonFail(t("api.no_entry"), 404, { "cache-control": "no-store, max-age=0" });
      return new Response(JSON.stringify({
        enabled: sec.captchaEnabled,
        mode: sec.captchaEnabled ? sec.captchaMode : null,
      }), {
        status: 200,
        headers: { "content-type": "application/json; charset=utf-8", "cache-control": "no-store, max-age=0" },
      });
    }, t);
  }
</script>
