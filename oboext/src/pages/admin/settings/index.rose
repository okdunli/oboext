<script>
  // Site settings — one form, sectioned into cards, patched via
  // PATCH /api/settings (admin only, enforced server-side too). Selects and
  // switches hydrate from data-val/data-on because SSR boolean/selected
  // attributes cannot be emitted safely; see admin.js hydrateControls().
  let s = $data(() => __rvLoad("admin.settings", {}));
  function v(k, dflt) {
    const x = s()[k];
    return x == null || x === "" ? (dflt == null ? "" : dflt) : x;
  }
  function on(k, dflt) {
    return (s()[k] ?? dflt) ? "1" : "0";
  }
</script>

<head>
  <title>站点设置 - 管理后台</title>
</head>

<form data-adm-form="settings">
  <div class="adm-toolbar">
    <strong style="font-size:16px">站点设置</strong>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">保存设置</button>
  </div>

  <div class="adm-section-title">常规</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>站点名称</label>
          <input class="adm-input" name="siteTitle" value={v('siteTitle', 'oboext')}>
        </div>
        <div class="adm-field">
          <label>副标题 / 标语</label>
          <input class="adm-input" name="tagline" value={v('tagline')}>
        </div>
        <div class="adm-field full">
          <label>站点描述</label>
          <textarea class="adm-textarea" name="siteDescription" rows="2" data-dv={v('siteDescription')}></textarea>
        </div>
        <div class="adm-field">
          <label>Logo URL</label>
          <input class="adm-input" name="logoUrl" placeholder="/logo.svg 或 https://…" value={v('logoUrl')}>
        </div>
        <div class="adm-field">
          <label>Favicon URL</label>
          <input class="adm-input" name="faviconUrl" value={v('faviconUrl')}>
        </div>
        <div class="adm-field">
          <label>备案号</label>
          <input class="adm-input" name="icpNumber" value={v('icpNumber')}>
        </div>
        <div class="adm-field full">
          <label>页脚版权文字（支持 HTML，留空用默认）</label>
          <textarea class="adm-textarea" name="footerText" rows="2" data-dv={v('footerText')}></textarea>
        </div>
      </div>
    </div>
  </div>

  <div class="adm-section-title">阅读</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>首页显示</label>
          <select class="adm-select" name="homeDisplay" data-val={v('homeDisplay', 'latest')}>
            <option value="latest">最新文章列表</option>
            <option value="page">指定的静态页面</option>
          </select>
        </div>
        <div class="adm-field">
          <label>每页文章数</label>
          <input class="adm-input" type="number" min="1" max="100" name="postsPerPage" data-num value={v('postsPerPage', 10)}>
        </div>
        <div class="adm-field">
          <label>摘要字数</label>
          <input class="adm-input" type="number" min="40" max="600" name="excerptLength" data-num value={v('excerptLength', 160)}>
        </div>
        <div class="adm-field">
          <label>RSS 条目数</label>
          <input class="adm-input" type="number" min="1" max="100" name="feedItems" data-num value={v('feedItems', 20)}>
        </div>
        <div class="adm-field">
          <label>RSS 输出内容</label>
          <select class="adm-select" name="feedContent" data-val={v('feedContent', 'excerpt')}>
            <option value="excerpt">仅摘要</option>
            <option value="full">全文</option>
          </select>
        </div>
        <div class="adm-field">
          <label>站点语言</label>
          <select class="adm-select" name="language" data-val={v('language', 'zh-CN')}>
            <option value="zh-CN">简体中文</option>
            <option value="zh-TW">繁体中文</option>
            <option value="en">English</option>
            <option value="ja">日本語</option>
          </select>
        </div>
        <div class="adm-field">
          <label>时区</label>
          <input class="adm-input" name="timezone" placeholder="Asia/Shanghai" value={v('timezone', 'Asia/Shanghai')}>
        </div>
        <div class="adm-field">
          <label>日期格式</label>
          <select class="adm-select" name="dateFormat" data-val={v('dateFormat', 'YYYY-MM-DD')}>
            <option value="YYYY-MM-DD">2026-08-24</option>
            <option value="YYYY年M月D日">2026年8月24日</option>
            <option value="MMM D, YYYY">Aug 24, 2026</option>
            <option value="D/M/YYYY">24/8/2026</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="adm-section-title">评论</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <label class="adm-switch">
        <div><div class="t">开放评论</div><div class="d">关闭后所有文章不再接受新评论</div></div>
        <input type="checkbox" name="commentsEnabled" data-bool data-on={on('commentsEnabled', true)}>
      </label>
      <label class="adm-switch">
        <div><div class="t">评论必须填写昵称和邮箱</div><div class="d">关闭后允许匿名评论</div></div>
        <input type="checkbox" name="requireNameEmail" data-bool data-on={on('requireNameEmail', true)}>
      </label>
      <label class="adm-switch">
        <div><div class="t">评论先审后放</div><div class="d">新评论进入待审核队列，通过后才显示</div></div>
        <input type="checkbox" name="commentModeration" data-bool data-on={on('commentModeration', false)}>
      </label>
    </div>
  </div>

  <div class="adm-section-title">SEO 与分享</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>标题模板</label>
          <input class="adm-input" name="seoTitleTemplate" placeholder="文章标题 - 站点名称" value={v('seoTitleTemplate')}>
        </div>
        <div class="adm-field">
          <label>默认关键词（逗号分隔）</label>
          <input class="adm-input" name="seoKeywords" value={v('seoKeywords')}>
        </div>
        <div class="adm-field full">
          <label>默认 SEO 描述</label>
          <textarea class="adm-textarea" name="seoDefaultDescription" rows="2" data-dv={v('seoDefaultDescription')}></textarea>
        </div>
        <div class="adm-field">
          <label>robots 指令</label>
          <input class="adm-input" name="seoRobots" placeholder="index,follow" value={v('seoRobots', 'index,follow')}>
        </div>
        <div class="adm-field">
          <label>默认分享图 URL</label>
          <input class="adm-input" name="ogImageUrl" value={v('ogImageUrl')}>
        </div>
        <div class="adm-field">
          <label>Twitter 卡片样式</label>
          <select class="adm-select" name="twitterCard" data-val={v('twitterCard', 'summary_large_image')}>
            <option value="summary">summary</option>
            <option value="summary_large_image">summary_large_image</option>
          </select>
        </div>
        <div class="adm-field">
          <label>Twitter 账号</label>
          <input class="adm-input" name="twitterSite" placeholder="@name" value={v('twitterSite')}>
        </div>
        <div class="adm-field">
          <label>统计分析 ID（如 G-XXXX）</label>
          <input class="adm-input" name="analyticsId" value={v('analyticsId')}>
        </div>
      </div>
    </div>
  </div>

  <div class="adm-section-title">高级（自定义注入）</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-field">
        <label>自定义 head 注入（meta/script/link）</label>
        <textarea class="adm-textarea" name="customHead" rows="4" data-dv={v('customHead')}></textarea>
      </div>
      <div class="adm-field">
        <label>自定义页脚 HTML</label>
        <textarea class="adm-textarea" name="customFooter" rows="3" data-dv={v('customFooter')}></textarea>
      </div>
      <div class="adm-field" style="margin-bottom:0">
        <label>自定义 CSS</label>
        <textarea class="adm-textarea" name="customCss" rows="4" data-dv={v('customCss')}></textarea>
      </div>
    </div>
  </div>

  <div class="adm-toolbar" style="margin-top:20px">
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">保存设置</button>
  </div>
</form>
