<script>

  let s = $data(() => __rvLoad("admin.notify", {}));
  function c() {
    return (s() && s().copy && s().copy.email) || {};
  }
  function g(path, dflt) {
    let x = s();
    const parts = path.split(".");
    for (const p of parts) x = x == null ? undefined : x[p];
    return x == null || x === "" ? (dflt == null ? "" : dflt) : x;
  }
  function sw(path) {
    let x = s();
    const parts = path.split(".");
    for (const p of parts) x = x == null ? undefined : x[p];
    return x ? "1" : "0";
  }
</script>

<head>
  <title>{c().docTitle}</title>
</head>

<form data-adm-form="notify">
  <div class="adm-toolbar">
    <strong style="font-size:16px">{c().title}</strong>
    <span style="flex:1"></span>
    <button class="adm-btn" type="submit">{c().save}</button>
  </div>
  <p class="adm-hint" style="margin:0 0 16px;">
    {c().lead}
  </p>

  <div class="adm-section-title">{c().smtp}</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>{c().host}</label>
          <input class="adm-input" name="smtp.host" value={g('smtp.host')} placeholder="smtp.example.com">
        </div>
        <div class="adm-field">
          <label>{c().port}</label>
          <input class="adm-input" type="number" name="smtp.port" data-num value={g('smtp.port', 465)} min="1" max="65535">
        </div>
        <div class="adm-field">
          <label>{c().encryption}</label>
          <select class="adm-select" name="smtp.security" data-val={g('smtp.security', 'TLS')}>
            <option value="TLS">{c().tls}</option>
            <option value="STARTTLS">{c().starttls}</option>
            <option value="NONE">{c().none}</option>
          </select>
        </div>
        <div class="adm-field">
          <label>{c().username}</label>
          <input class="adm-input" name="smtp.user" value={g('smtp.user')}>
        </div>
        <div class="adm-field">
          <label>{c().password}</label>
          <input class="adm-input" type="password" name="smtp.pass" value="" autocomplete="new-password">
        </div>
        <div class="adm-field">
          <label>{c().from}</label>
          <input class="adm-input" name="smtp.from" value={g('smtp.from')} placeholder={c().fromPh}>
        </div>
      </div>
    </div>
  </div>

  <div class="adm-section-title">{c().channel}</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <label class="adm-switch"><span><span class="t">{c().enabled}</span><span class="d">{c().enabledHint}</span></span><input type="checkbox" name="email.enabled" data-on={sw('email.enabled')} data-bool></label>
      <div class="adm-field">
        <label>{c().delivery}</label>
        <select class="adm-select" name="email.via" data-val={g('email.via', 'smtp')}>
          <option value="smtp">{c().smtpDirect}</option>
          <option value="webhook">{c().webhook}</option>
        </select>
      </div>
      <div data-show-if="email.via=webhook">
        <div class="adm-field">
          <label>{c().webhookUrl}</label>
          <input class="adm-input" name="email.webhook.url" value={g('email.webhook.url')} placeholder="https://…">
        </div>
        <div class="adm-form-grid">
          <div class="adm-field">
            <label>{c().method}</label>
            <select class="adm-select" name="email.webhook.method" data-val={g('email.webhook.method', 'POST')}>
              <option value="POST">POST</option>
              <option value="GET">GET</option>
              <option value="PUT">PUT</option>
            </select>
          </div>
          <div class="adm-field">
            <label>{c().bodyTemplate}</label>
            <input class="adm-input" name="email.webhook.body" value={g('email.webhook.body')}>
            <p class="adm-hint" style="margin:4px 0 0;">{c().bodyHint}</p>
          </div>
        </div>
        <div class="adm-field">
          <label>{c().headers}</label>
          <textarea class="adm-textarea" name="email.webhook.headers" rows="2" data-dv={g('email.webhook.headers')}></textarea>
        </div>
      </div>
      <div class="adm-toolbar" style="margin:12px 0 0;">
        <input class="adm-input" style="max-width:280px;" data-notify-test-input="email" placeholder={c().test}>
        <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-adm-act="notify-test" data-channel="email"><span class="adm-ic adm-ic-sm" style="--i:url(/public/icons/send.svg)"></span>{c().test}</button>
      </div>
    </div>
  </div>

  <div class="adm-section-title">{c().codeSwitch}</div>
  <div class="adm-card">
    <div class="adm-card-bd">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label class="adm-switch"><span><span class="t">{c().requireVerify}</span></span><input type="checkbox" name="register.emailVerify" data-on={sw('register.emailVerify')} data-bool></label>
        </div>
        <div class="adm-field">
          <label class="adm-switch"><span><span class="t">{c().allowLogin}</span></span><input type="checkbox" name="login.emailVerify" data-on={sw('login.emailVerify')} data-bool></label>
        </div>
      </div>
      <p class="adm-hint" style="margin:10px 0 0;">
        {c().loginNote}
      </p>
    </div>
  </div>
</form>
