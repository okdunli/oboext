<script>
  // Per-theme settings panel (port of components/ThemeSettingsForm.tsx).
  // Two schemas share one left nav: the universal appearance sections
  // (design tokens) and the theme's own manifest sections. The full panel
  // payload (resolved values included) is embedded; admin.js renders fields,
  // live token preview, save/reset — no extra fetch on load.
  let slug = $state("");
  let p = $data(() => __rvLoad("admin.theme-panel", { slug: slug() }));

  function payload() {
    return JSON.stringify(p());
  }
  function name() {
    return p().theme ? p().theme.name : "";
  }
  function meta(k) {
    return p().meta && p().meta[k] ? p().meta[k] : "";
  }
  function version() {
    return p().meta && p().meta.version ? "v" + p().meta.version : "";
  }
  function description() {
    return (p().meta && p().meta.description) || "在管理后台创建的自定义主题";
  }
  function themeSlug() {
    return p().theme ? p().theme.slug : "";
  }
</script>

<head>
  <title>主题设置 - 管理后台</title>
</head>

<div class="adm-thp" data-th-panel data-th-panel-data={payload()}>
  <div class="adm-thp-head">
    <div>
      <a class="adm-thp-back" href="/admin/themes">← 返回主题列表</a>
      <h1 class="adm-h1">{name()}
        {#if (() => p().isActive)()}
        <span class="adm-thp-live">已启用</span>
        {/if}
      </h1>
      <p class="adm-thp-desc">{description()}</p>
      <p class="adm-thp-mono">themes/{themeSlug()} · {version()}
        {#if (() => meta("author") !== "")()}
        · {meta("author")}
        {/if}
        {#if (() => !p().hasManifest)()}
        · 自定义主题（无 manifest）
        {/if}
      </p>
    </div>
    <div class="adm-thp-headbtns">
      <button type="button" class="adm-btn adm-btn-ghost" data-thp-reset>↺ 恢复默认</button>
      <button type="button" class="adm-btn" data-thp-save>
        <span data-thp-save-label>保存</span>
      </button>
    </div>
  </div>

  <div class="adm-thp-msg" data-thp-msg></div>

  <div class="adm-thp-grid">
    <nav class="adm-thp-nav">
      <div class="adm-thp-navgroup" data-thp-nav-group="appearance">
        <p class="adm-thp-navtitle">外观</p>
        <div class="adm-thp-navlist" data-thp-nav="appearance"></div>
      </div>
      <div class="adm-thp-navgroup" data-thp-nav-group="settings">
        <p class="adm-thp-navtitle">主题选项</p>
        <div class="adm-thp-navlist" data-thp-nav="settings"></div>
      </div>

      <div class="adm-thp-areas">
        <p class="adm-thp-areas-title">▦ 小工具区域</p>
        <ul class="adm-thp-area-list" data-thp-areas></ul>
        <a class="adm-thp-areas-link" href="/admin/widgets">去配置小工具 →</a>
      </div>

      <div class="adm-thp-preview" data-thp-preview>
        <div class="adm-thp-preview-inner">
          <p class="adm-thp-preview-kicker">✦ 预览</p>
          <div class="adm-thp-preview-card">
            <p class="adm-thp-preview-title">标题文字</p>
            <p class="adm-thp-preview-sub">次要说明文字</p>
            <span class="adm-thp-preview-btn">按钮</span>
          </div>
        </div>
      </div>
    </nav>

    <div class="adm-thp-body" data-thp-body></div>
  </div>
</div>
